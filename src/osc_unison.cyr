# osc_unison.cyr -- unison oscillator: N detuned voices mixed together.
#
# Ports rust-old/src/oscillator/unison.rs. f32 -> f64 throughout. The fixed
# `[f32; 8]` phase and detune-ratio arrays become stdlib vecs of 8 f64; the
# `bool ratios_dirty` becomes an i64 flag (1/0). The `(f32, f32)` stereo
# tuple return becomes a `UnisonStereo` pair struct. serde derives/tests are
# dropped; the constructor returns the struct pointer or a negative NAAD_ERR_*.
# Per-voice waveform generation reuses osc_stateless_waveform_sample from
# osc_core.cyr, matching the oracle.
#
# The pan gains cost a sine and a cosine per voice, so they are held in vecs and
# recomputed when stereo_spread or num_voices stops matching what they were built
# from. Both are public fields, so the check is on the values, not a dirty flag.
# Each gain is the oracle's expression with the same operands.
#
# Requires (from the build/test unit): stdlib alloc/vec + math/ganita
# (F64_ONE/TWO/HALF/PI_2/FRAC_1_SQRT2, f64_pow/sin/cos/clamp/max) and
# error.cyr (validate_*, naad_is_err, naad_vec_zeros, NAAD_ERR_*), dsp_util.cyr
# (xorshift32_unit_f32), osc_core.cyr (osc_stateless_waveform_sample,
# WAVEFORM_*). No `include` lines.

# ================================================================
# UnisonStereo -- (left, right) sample pair (was a Rust tuple return).
# ================================================================
#derive(accessors)
struct UnisonStereo { left; right; }

# ================================================================
# UnisonOscillator -- N detuned copies of a waveform mixed together.
#   waveform      : WAVEFORM_* constant (shared by all voices)
#   frequency     : base Hz
#   sample_rate   : Hz
#   num_voices    : 1..8
#   detune_cents  : total detune spread in cents (>= 0)
#   stereo_spread : 0 (mono) .. 1 (full width)
#   phases        : vec of 8 f64 per-voice phases
#   detune_ratios : vec of 8 f64 precomputed frequency ratios
#   ratios_dirty  : 1 if ratios need recomputing, else 0
#   gains_l/r     : vecs of 8 f64 equal-power pan gains
#   inv_voices    : 1 / num_voices, the stereo output scale
#   pan_spread, pan_voices: stereo_spread and num_voices the gains were built from
#   out_left/right: the last stereo pair unison_stereo_step produced
# ================================================================
#derive(accessors)
struct UnisonOscillator { waveform; frequency; sample_rate; num_voices; detune_cents;
    stereo_spread; phases; detune_ratios; ratios_dirty; gains_l; gains_r;
    inv_voices; pan_spread; pan_voices; out_left; out_right; }

# ================================================================
# unison_new -- construct. Clamps num_voices to 1..8, randomizes initial
# phases (xorshift32 seeded 12345), primes detune ratios. Returns the struct
# pointer on success, or a negative NAAD_ERR_* on an invalid waveform,
# sample_rate or frequency. The waveform is checked because the oracle's enum
# cannot hold a bad id, and here one would run silently as a noise waveform.
# ================================================================
#must_use
fn unison_new(waveform, frequency, num_voices, detune_cents, sample_rate) {
    if (waveform < WAVEFORM_SINE) { return NAAD_ERR_INVALID_PARAMETER; }
    if (waveform > WAVEFORM_BROWN_NOISE) { return NAAD_ERR_INVALID_PARAMETER; }
    var e = validate_sample_rate(sample_rate);
    if (naad_is_err(e) == 1) { return e; }
    e = validate_frequency(frequency, sample_rate);
    if (naad_is_err(e) == 1) { return e; }

    var nv = num_voices;
    if (nv < 1) { nv = 1; }
    if (nv > 8) { nv = 8; }

    var phases = naad_vec_zeros(8);
    var seed = alloc(8);
    store64(seed, 12345);
    var i = 0;
    while (i < nv) {
        vec_set(phases, i, xorshift32_unit_f32(seed));
        i = i + 1;
    }

    var detune_ratios = vec_new();
    i = 0;
    while (i < 8) {
        vec_push(detune_ratios, F64_ONE);
        i = i + 1;
    }

    var self = alloc(sizeof(UnisonOscillator));
    UnisonOscillator_set_waveform(self, waveform);
    UnisonOscillator_set_frequency(self, frequency);
    UnisonOscillator_set_sample_rate(self, sample_rate);
    UnisonOscillator_set_num_voices(self, nv);
    UnisonOscillator_set_detune_cents(self, f64_max(detune_cents, 0));
    UnisonOscillator_set_stereo_spread(self, F64_HALF);
    UnisonOscillator_set_phases(self, phases);
    UnisonOscillator_set_detune_ratios(self, detune_ratios);
    UnisonOscillator_set_ratios_dirty(self, 1);
    UnisonOscillator_set_gains_l(self, naad_vec_zeros(8));
    UnisonOscillator_set_gains_r(self, naad_vec_zeros(8));
    UnisonOscillator_set_pan_voices(self, 0);
    UnisonOscillator_set_out_left(self, 0);
    UnisonOscillator_set_out_right(self, 0);
    unison_recompute_ratios(self);
    return self;
}

# Refresh the equal-power pan gains: voice 0 left, voice N-1 right, narrowed by
# stereo_spread; a lone voice sits in the centre.
fn _unison_refresh_pan(self) {
    var nv = UnisonOscillator_num_voices(self);
    var gains_l = UnisonOscillator_gains_l(self);
    var gains_r = UnisonOscillator_gains_r(self);
    if (nv > 1) {
        var w = f64_mul(UnisonOscillator_stereo_spread(self), F64_HALF);
        var denom = f64_from(nv - 1);
        var i = 0;
        while (i < nv) {
            var pan = f64_div(f64_from(i), denom);
            var pan_scaled = f64_add(F64_HALF, f64_mul(f64_mul(f64_sub(pan, F64_HALF), w), F64_TWO));
            var angle = f64_mul(pan_scaled, F64_PI_2);
            vec_set(gains_l, i, f64_cos(angle));
            vec_set(gains_r, i, f64_sin(angle));
            i = i + 1;
        }
    } else {
        vec_set(gains_l, 0, F64_FRAC_1_SQRT2);
        vec_set(gains_r, 0, F64_FRAC_1_SQRT2);
    }
    UnisonOscillator_set_inv_voices(self, f64_div(F64_ONE, f64_from(nv)));
    UnisonOscillator_set_pan_spread(self, UnisonOscillator_stereo_spread(self));
    UnisonOscillator_set_pan_voices(self, nv);
    return 0;
}

# ================================================================
# unison_recompute_ratios -- rebuild detune ratios from the cents spread.
# Voices are spread symmetrically over [-cents/2, +cents/2]; each ratio is
# 2^(cents_offset/1200).
# ================================================================
fn unison_recompute_ratios(self) {
    var nv = UnisonOscillator_num_voices(self);
    var ratios = UnisonOscillator_detune_ratios(self);
    var dc = UnisonOscillator_detune_cents(self);
    if (nv <= 1) {
        vec_set(ratios, 0, F64_ONE);
    } else {
        var denom = f64_from(nv - 1);
        var i = 0;
        while (i < nv) {
            var t = f64_div(f64_from(i), denom);
            var cents_offset = f64_mul(f64_sub(t, F64_HALF), dc);
            var expo = f64_div(cents_offset, f64_from(1200));
            vec_set(ratios, i, f64_pow(F64_TWO, expo));
            i = i + 1;
        }
    }
    UnisonOscillator_set_ratios_dirty(self, 0);
    return 0;
}

# ================================================================
# unison_next_sample -- next mono sample (all voices averaged).
# ================================================================
#must_use
fn unison_next_sample(self) {
    if (UnisonOscillator_ratios_dirty(self) == 1) {
        unison_recompute_ratios(self);
    }
    var wf = UnisonOscillator_waveform(self);
    var freq_base = UnisonOscillator_frequency(self);
    var sr = UnisonOscillator_sample_rate(self);
    var ratios = UnisonOscillator_detune_ratios(self);
    var phases = UnisonOscillator_phases(self);
    var nv = UnisonOscillator_num_voices(self);

    var sum = 0;
    var i = 0;
    while (i < nv) {
        var dt = f64_div(f64_mul(freq_base, vec_get(ratios, i)), sr);
        var t = vec_get(phases, i);
        sum = f64_add(sum, osc_stateless_waveform_sample(wf, t, dt));
        var ph = f64_add(t, dt);
        if (f64_ge(ph, F64_ONE) == 1) { ph = f64_sub(ph, F64_ONE); }
        vec_set(phases, i, ph);
        i = i + 1;
    }
    return f64_div(sum, f64_from(nv));
}

# ================================================================
# unison_stereo_step -- advance one stereo sample and leave the (left, right) pair
# in out_left/out_right. Allocates nothing. Voices are equal-power panned across
# the field per stereo_spread.
# ================================================================
fn unison_stereo_step(self) {
    if (UnisonOscillator_ratios_dirty(self) == 1) {
        unison_recompute_ratios(self);
    }
    if (UnisonOscillator_stereo_spread(self) != UnisonOscillator_pan_spread(self)
      || UnisonOscillator_num_voices(self) != UnisonOscillator_pan_voices(self)) {
        _unison_refresh_pan(self);
    }
    var wf = UnisonOscillator_waveform(self);
    var freq_base = UnisonOscillator_frequency(self);
    var sr = UnisonOscillator_sample_rate(self);
    var ratios = UnisonOscillator_detune_ratios(self);
    var gains_l = UnisonOscillator_gains_l(self);
    var gains_r = UnisonOscillator_gains_r(self);
    var phases = UnisonOscillator_phases(self);
    var nv = UnisonOscillator_num_voices(self);

    var left = 0;
    var right = 0;
    var i = 0;
    while (i < nv) {
        var dt = f64_div(f64_mul(freq_base, vec_get(ratios, i)), sr);
        var t = vec_get(phases, i);
        var sample = osc_stateless_waveform_sample(wf, t, dt);
        left = f64_add(left, f64_mul(sample, vec_get(gains_l, i)));
        right = f64_add(right, f64_mul(sample, vec_get(gains_r, i)));
        var ph = f64_add(t, dt);
        if (f64_ge(ph, F64_ONE) == 1) { ph = f64_sub(ph, F64_ONE); }
        vec_set(phases, i, ph);
        i = i + 1;
    }
    var inv = UnisonOscillator_inv_voices(self);
    UnisonOscillator_set_out_left(self, f64_mul(left, inv));
    UnisonOscillator_set_out_right(self, f64_mul(right, inv));
    return 0;
}

# ================================================================
# unison_advance_stereo -- advance one stereo sample and write the pair into
# out_left/out_right at index idx. Allocates nothing, so a buffer loop can call it
# per sample.
# ================================================================
fn unison_advance_stereo(self, out_left, out_right, idx) {
    unison_stereo_step(self);
    vec_set(out_left, idx, UnisonOscillator_out_left(self));
    vec_set(out_right, idx, UnisonOscillator_out_right(self));
    return 0;
}

# ================================================================
# unison_next_sample_stereo -- next stereo pair, as a UnisonStereo pointer: 16
# bytes per call, so a buffer loop uses unison_fill_buffer_stereo instead.
# ================================================================
#must_use
fn unison_next_sample_stereo(self) {
    unison_stereo_step(self);
    var out = alloc(sizeof(UnisonStereo));
    UnisonStereo_set_left(out, UnisonOscillator_out_left(self));
    UnisonStereo_set_right(out, UnisonOscillator_out_right(self));
    return out;
}

# ================================================================
# unison_fill_buffer -- fill a mono vec buffer in place.
# ================================================================
fn unison_fill_buffer(self, buffer) {
    var n = vec_len(buffer);
    var i = 0;
    while (i < n) {
        vec_set(buffer, i, unison_next_sample(self));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# unison_fill_buffer_stereo -- fill left/right vecs (over the shorter length).
# ================================================================
fn unison_fill_buffer_stereo(self, left, right) {
    var n = vec_len(left);
    var nr = vec_len(right);
    if (nr < n) { n = nr; }
    var i = 0;
    while (i < n) {
        unison_advance_stereo(self, left, right, i);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Setters.
# ================================================================
fn unison_set_num_voices(self, n) {
    var nv = n;
    if (nv < 1) { nv = 1; }
    if (nv > 8) { nv = 8; }
    UnisonOscillator_set_num_voices(self, nv);
    UnisonOscillator_set_ratios_dirty(self, 1);
    return 0;
}

# Set the unison detune spread in cents. Negative values clamp to 0, matching
# the oracle's `cents.max(0.0)`. Marks the voice ratios dirty so they rebuild on
# the next sample. Returns 0. Ports set_detune_cents().
fn unison_set_detune_cents(self, cents) {
    UnisonOscillator_set_detune_cents(self, f64_max(cents, 0));
    UnisonOscillator_set_ratios_dirty(self, 1);
    return 0;
}

# Set the stereo spread, clamped to [0.0, 1.0] -- 0.0 is mono, 1.0 is full
# width. Returns 0. Ports set_stereo_spread().
fn unison_set_stereo_spread(self, spread) {
    UnisonOscillator_set_stereo_spread(self, f64_clamp(spread, 0, F64_ONE));
    return 0;
}

# Set the base frequency the unison voices detune around. Returns
# NAAD_ERR_NONE, or a negative NAAD_ERR_* if the frequency is invalid for this
# oscillator's sample rate. Ports set_frequency().
fn unison_set_frequency(self, freq) {
    var e = validate_frequency(freq, UnisonOscillator_sample_rate(self));
    if (naad_is_err(e) == 1) { return e; }
    UnisonOscillator_set_frequency(self, freq);
    return NAAD_ERR_NONE;
}

# ================================================================
# Accessors.
# ================================================================
#inline
#must_use
fn unison_num_voices(self) {
    return UnisonOscillator_num_voices(self);
}

# The centre frequency in Hz.
#inline
#must_use
fn unison_frequency(self) {
    return UnisonOscillator_frequency(self);
}

# The total detune spread in cents.
#inline
#must_use
fn unison_detune_cents(self) {
    return UnisonOscillator_detune_cents(self);
}
