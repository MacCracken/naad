# naad — Cyrius port smoke entry.
#
# Builds the whole library (the dist bundle + its consumer deps) into one
# binary and runs a tiny cross-layer smoke, proving `dist/naad.cyr` compiles
# and links as an executable. Consumers include `dist/naad.cyr` the same way.
# Library modules live in src/*.cyr (validated per-module via tests/*.tcyr);
# this entry is not what those suites include.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "dist/naad.cyr"

# Smoke entry point. Builds a 440 Hz sine oscillator, pulls 128 samples and
# checks every one is finite. Returns 0 on success, 1 on init failure or a
# non-finite sample. This proves dist/naad.cyr compiles and links as an
# executable -- it is not a test suite; those live in tests/*.tcyr.
fn main() {
    alloc_init();

    # 440 Hz sine oscillator → 128 samples, all must be finite.
    var osc = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
    if (naad_is_err(osc) == 1) {
        println("naad: oscillator init failed");
        return 1;
    }
    var i = 0;
    var ok = 0;
    while (i < 128) {
        if (naad_is_finite(osc_next_sample(osc)) == 1) { ok = ok + 1; }
        i = i + 1;
    }
    if (ok == 128) {
        println("naad (Cyrius port) — smoke OK");
        return 0;
    }
    println("naad: smoke FAILED");
    return 1;
}

var r = main();
syscall(60, r);
