# acoustics_convolution.cyr -- naad convolution reverb (thin goonj wrapper).
#
# Ports rust-old/src/acoustics/convolution.rs. Applies a pre-computed impulse
# response to an audio stream via direct time-domain convolution (per sample)
# or FFT convolution (per block, through hisab num_fft/num_ifft). An IR can be
# supplied raw or generated from a goonj shoebox-room simulation. f32 -> f64
# throughout. Rust's serde derives are dropped. process_block keeps the oracle's
# reusable scratch: struct-owned interleaved complex buffers that grow only when
# fft_len exceeds the largest seen so far. lib/alloc.cyr has no individual free,
# so allocating them per call would leak 3 * fft_len * 16 bytes per block.
#
# DIVERGENCE FROM THE ORACLE (docs/adr/0003): process_block STREAMS. The Rust
# original writes only the first block_len samples of the convolution and drops
# the rest -- the IR still ringing -- so it truncates the tail at every block
# boundary and keeps history separate from process_sample. This port uses
# overlap-save, which reuses the input_buffer ring process_sample already
# maintains, so the two entry points are coherent.
#
# Cross-crate mapping (discovered from lib/goonj.cyr + goonj src/tests, and
# reused from the already-green src/acoustics_room.cyr wrapper):
#   goonj::room::AcousticRoom::shoebox   -> acoustic_room_shoebox(l, w, h, mat)
#   goonj::impulse::IrConfig{..}         -> ir_config_new(rate, order, rays,
#                                                          bounces, secs, seed)
#   goonj::impulse::generate_ir          -> generate_ir(src, lis, room, cfg)
#   MultibandIr::to_broadband            -> multiband_ir_to_broadband(mi)
#   ImpulseResponse.samples              -> ImpulseResponse_samples(ir)
#   hisab::Vec3::new                     -> hvec3_new (config already stores it)
#   hisab::Complex + hisab::num::fft/ifft-> num_fft/num_ifft over an interleaved
#                                           complex buffer alloc(n*16): re at
#                                           +i*16, im at +i*16+8.
# The wall material name resolves through naad_acoustics_material_by_name
# (src/acoustics.cyr). Result<Self> -> struct pointer on success, or a negative
# NAAD_ERR_COMPUTATION on unknown material / non-positive dimensions. Reuses
# RoomReverbConfig + its accessors and _naad_room_ir from src/acoustics_room.cyr,
# and _naad_ring_new / _naad_ring_convolve from src/acoustics.cyr. No `include`.

# ================================================================
# ConvolutionReverb -- convolution reverb processor.
#   ir            : impulse-response samples (vec of f64, may be empty)
#   input_buffer  : ring-buffer of recent inputs (len == max(ir_len, 1))
#   position      : current write position in the ring buffer
#   mix           : wet/dry mix in [0, 1] (0 = fully dry, 1 = fully wet)
#   scratch_ir / scratch_in / scratch_product : interleaved complex FFT scratch
#                   (re at +i*16, im at +i*16+8), mirroring the oracle's
#                   #[serde(skip)] Vec<Complex> fields
#   scratch_cap   : the fft_len the three buffers are currently sized for; 0
#                   until the first process_block
#   ir_spectrum_len : the fft_len whose IR spectrum scratch_ir holds; 0 when it
#                   holds none. Editing the IR through its accessors leaves this
#                   stale, so a new IR goes through naad_convolution_rebuild_from_ir
# ================================================================
#derive(accessors)
struct ConvolutionReverb {
    ir;
    input_buffer;
    position;
    mix;
    scratch_ir;
    scratch_in;
    scratch_product;
    scratch_cap;
    ir_spectrum_len;
}

# ================================================================
# _naad_convolution_adopt -- build a reverb around `ir`, which it keeps: the
# caller must hold no other reference. A ring sized for one length and an IR
# that later grows would index past the ring.
# ================================================================
#must_use
fn _naad_convolution_adopt(ir, mix) {
    var self = alloc(sizeof(ConvolutionReverb));
    ConvolutionReverb_set_ir(self, ir);
    ConvolutionReverb_set_input_buffer(self, _naad_ring_new(vec_len(ir)));
    ConvolutionReverb_set_position(self, 0);
    ConvolutionReverb_set_mix(self, f64_clamp(mix, 0, F64_ONE));
    # Scratch grows lazily on the first process_block (see scratch_cap).
    ConvolutionReverb_set_scratch_ir(self, 0);
    ConvolutionReverb_set_scratch_in(self, 0);
    ConvolutionReverb_set_scratch_product(self, 0);
    ConvolutionReverb_set_scratch_cap(self, 0);
    ConvolutionReverb_set_ir_spectrum_len(self, 0);
    return self;
}

# ================================================================
# naad_convolution_from_ir -- create a convolution reverb from a raw impulse
# response `ir` (vec of f64) and a `mix` clamped to [0, 1]. The input ring
# buffer is sized to max(ir_len, 1) and zero-filled. The reverb keeps a copy:
# Rust takes `ir` by value, so the caller can change its vec afterwards without
# reaching the reverb (ADR-0005). Ports ConvolutionReverb::from_ir.
# ================================================================
#must_use
fn naad_convolution_from_ir(ir, mix) {
    return _naad_convolution_adopt(naad_vec_copy(ir), mix);
}

# ================================================================
# naad_convolution_from_room -- create a convolution reverb from a goonj room
# simulation. Builds a shoebox room, generates a broadband impulse response via
# image-source + diffuse rain (order 3, 2000 diffuse rays, 30 bounces, 1.0 s,
# seed 42 -- the Rust IrConfig literal), and loads it fully wet (mix 1.0).
# Returns the struct pointer on success, or a negative NAAD_ERR_COMPUTATION if the
# wall material name is unknown, the room dimensions are not positive, or the
# sample rate is negative or reaches MAX_IR_SAMPLES (see naad_room_ir_overflows).
# Ports ConvolutionReverb::from_room. Reuses RoomReverbConfig from
# src/acoustics_room.cyr.
# ================================================================
#must_use
fn naad_convolution_from_room(config) {
    var ir = _naad_room_ir(config);
    if (naad_is_err(ir) == 1) { return ir; }
    return _naad_convolution_adopt(ir, F64_ONE);
}

# ================================================================
# naad_convolution_process_sample -- process a single audio sample via direct
# time-domain convolution with the stored impulse response, returning a mix of
# dry input and wet convolved output. An empty IR passes the input through
# unchanged. Ports ConvolutionReverb::process_sample.
# ================================================================
#must_use
fn naad_convolution_process_sample(self, input) {
    var ir = ConvolutionReverb_ir(self);
    var ir_len = vec_len(ir);
    if (ir_len == 0) { return input; }

    var buf = ConvolutionReverb_input_buffer(self);
    var pos = ConvolutionReverb_position(self);
    vec_set(buf, pos, input);

    # wet = sum(input_buffer[(pos + ir_len - k) % ir_len] * ir[k]).
    var wet = _naad_ring_convolve(buf, pos, ir);

    var nextp = pos + 1;
    var np = nextp % ir_len;
    ConvolutionReverb_set_position(self, np);

    # input * (1 - mix) + wet * mix.
    var mix = ConvolutionReverb_mix(self);
    var dry = f64_sub(F64_ONE, mix);
    return f64_add(f64_mul(input, dry), f64_mul(wet, mix));
}

# ================================================================
# naad_convolution_passthrough -- copy min(len(input), len(output)) samples
# from input to output. Mirrors the zipped dry-copy fallback the Rust
# process_block takes when the IR is empty or the input block is empty.
# ================================================================
fn naad_convolution_passthrough(input, output) {
    var n_in = vec_len(input);
    var n_out = vec_len(output);
    var limit = n_in;
    if (n_out < limit) { limit = n_out; }
    var i = 0;
    while (i < limit) {
        vec_set(output, i, vec_get(input, i));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# naad_convolution_process_block_direct -- direct per-sample fallback used when
# an FFT reports failure: writes process_sample(input[i]) into output[i] for
# min(len(input), len(output)) samples. Mirrors Rust's zipped process_sample
# fallback.
# ================================================================
fn naad_convolution_process_block_direct(self, input, output) {
    var n_in = vec_len(input);
    var n_out = vec_len(output);
    var limit = n_in;
    if (n_out < limit) { limit = n_out; }
    var i = 0;
    while (i < limit) {
        vec_set(output, i, naad_convolution_process_sample(self, vec_get(input, i)));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# naad_convolution_next_pow2 -- smallest power of two >= v (>= 1 for v <= 1).
# Ports usize::next_power_of_two for the FFT sizing.
# ================================================================
#must_use
fn naad_convolution_next_pow2(v) {
    var p = 1;
    while (p < v) { p = p << 1; }
    return p;
}

# ================================================================
# naad_convolution_process_block -- process a block of samples through FFT-based
# linear convolution (hisab num_fft / num_ifft), writing the wet/dry mix into
# `output`. Both `input` and `output` are vec handles; up to min(len) samples
# are written. An empty IR or empty input block copies the dry signal through.
# On (never-reached, size is always a power of two) FFT failure it falls back to
# direct per-sample convolution. Ports ConvolutionReverb::process_block, except
# that it streams: the output is the stream process_sample gives, across block
# boundaries. Deliberate divergence from the oracle, see docs/adr/0003.
#
# STREAMING (OVERLAP-SAVE). The segment is the previous (ir_len - 1) inputs
# followed by this block, and that history is exactly what the input_buffer ring
# process_sample maintains. So the two paths share one history and may be
# interleaved on one object, and `input` and `output` may be the same vec.
#
# A segment holding a non-finite sample takes the direct path instead, which is
# what lets one NaN cost ir_len outputs rather than two blocks.
#
# Segment length L = ir_len + block_len - 1, zero-padded to fft_len =
# next_pow2(L). Circular convolution aliases only the first ir_len - 1 outputs
# (the true linear result has length L + ir_len - 1, and the overhang past
# fft_len is at most ir_len - 2), and those are precisely the ones discarded --
# the valid linear outputs are at [ir_len - 1, ir_len - 1 + block_len).
# ================================================================
fn naad_convolution_process_block(self, input, output) {
    var ir = ConvolutionReverb_ir(self);
    var ir_len = vec_len(ir);
    # Consume exactly as many samples as we emit, which is what
    # naad_convolution_process_block_direct does (it calls process_sample `limit`
    # times): a short output must not drop history.
    var block_len = vec_len(input);
    var n_out_avail = vec_len(output);
    if (n_out_avail < block_len) { block_len = n_out_avail; }
    if (ir_len == 0) { return naad_convolution_passthrough(input, output); }
    if (block_len == 0) { return naad_convolution_passthrough(input, output); }

    var span = ir_len + block_len - 1;
    var fft_len = naad_convolution_next_pow2(span);

    # Interleaved complex scratch: re at +i*16, im at +i*16+8. Struct-owned and
    # reused; reallocated only when fft_len exceeds the largest seen so far, the
    # same policy as the oracle's "resize keeps capacity" comment. A failed
    # allocation falls back to direct convolution rather than storing through a
    # null.
    if (fft_len > ConvolutionReverb_scratch_cap(self)) {
        var nir = alloc(fft_len * 16);
        var nin = alloc(fft_len * 16);
        var npr = alloc(fft_len * 16);
        if (nir == 0) { return naad_convolution_process_block_direct(self, input, output); }
        if (nin == 0) { return naad_convolution_process_block_direct(self, input, output); }
        if (npr == 0) { return naad_convolution_process_block_direct(self, input, output); }
        ConvolutionReverb_set_scratch_ir(self, nir);
        ConvolutionReverb_set_ir_spectrum_len(self, 0);
        ConvolutionReverb_set_scratch_in(self, nin);
        ConvolutionReverb_set_scratch_product(self, npr);
        ConvolutionReverb_set_scratch_cap(self, fft_len);
    }
    var ir_buf = ConvolutionReverb_scratch_ir(self);
    var in_buf = ConvolutionReverb_scratch_in(self);

    # Segment -> in_buf: the previous (ir_len - 1) inputs, oldest first, then this
    # block, then zeros. `position` is where the NEXT sample goes, so the history
    # sample at segment slot t is input_buffer[(position + 1 + t) % ir_len]:
    # at t = ir_len - 2 that is (position - 1), the most recent input. This is the
    # same ring, with the same convention, that process_sample reads.
    var hist = ConvolutionReverb_input_buffer(self);
    var hpos = ConvolutionReverb_position(self);
    var lead = ir_len - 1;
    var j = 0;
    while (j < fft_len) {
        var re2 = 0;
        if (j < lead) {
            re2 = vec_get(hist, (hpos + 1 + j) % ir_len);
        } elif (j < span) {
            re2 = vec_get(input, j - lead);
        }
        # A transform spreads one non-finite sample over the whole segment, so a
        # NaN would take every output in the block. The sample path holds it to
        # the ir_len outputs it reaches, and this block has changed no state yet.
        if (naad_is_finite(re2) == 0) { return naad_convolution_process_block_direct(self, input, output); }
        store64(in_buf + j * 16, re2);
        store64(in_buf + j * 16 + 8, 0);
        j = j + 1;
    }

    # The IR's spectrum depends only on the IR and fft_len, so ir_buf keeps it
    # between blocks. It holds none during the rewrite, so a failed transform
    # cannot leave a half-built spectrum marked as valid.
    if (ConvolutionReverb_ir_spectrum_len(self) != fft_len) {
        ConvolutionReverb_set_ir_spectrum_len(self, 0);
        # IR -> ir_buf (real = sample for i < ir_len, else 0; im = 0).
        var i = 0;
        while (i < fft_len) {
            var re = 0;
            if (i < ir_len) { re = vec_get(ir, i); }
            store64(ir_buf + i * 16, re);
            store64(ir_buf + i * 16 + 8, 0);
            i = i + 1;
        }
        var ir_tag, ir_err = num_fft(ir_buf, fft_len);
        if (is_err_result(ir_tag) == 1) { return naad_convolution_process_block_direct(self, input, output); }
        ConvolutionReverb_set_ir_spectrum_len(self, fft_len);
    }

    # Forward FFT of the segment. Fall back to direct convolution on failure.
    var in_tag, in_err = num_fft(in_buf, fft_len);
    if (is_err_result(in_tag) == 1) { return naad_convolution_process_block_direct(self, input, output); }

    # Pointwise multiply in the frequency domain into prod (struct-owned).
    var prod = ConvolutionReverb_scratch_product(self);
    var m = 0;
    while (m < fft_len) {
        var ar = load64(ir_buf + m * 16);
        var ai = load64(ir_buf + m * 16 + 8);
        var br = load64(in_buf + m * 16);
        var bi = load64(in_buf + m * 16 + 8);
        # (ar+ai i)(br+bi i) = (ar*br - ai*bi) + (ar*bi + ai*br) i.
        var pr = f64_sub(f64_mul(ar, br), f64_mul(ai, bi));
        var pi = f64_add(f64_mul(ar, bi), f64_mul(ai, br));
        store64(prod + m * 16, pr);
        store64(prod + m * 16 + 8, pi);
        m = m + 1;
    }

    # Inverse FFT. Fall back to direct convolution on failure.
    var ifft_tag, ifft_err = num_ifft(prod, fft_len);
    if (is_err_result(ifft_tag) == 1) { return naad_convolution_process_block_direct(self, input, output); }

    # Advance the SHARED history exactly as process_sample would have, so the two
    # entry points stay coherent and may be interleaved on one object. This comes
    # before the output loop because `input` and `output` may be the same vec: the
    # ring must hold the dry input, and that loop overwrites it.
    var w = 0;
    while (w < block_len) {
        vec_set(hist, hpos, vec_get(input, w));
        hpos = (hpos + 1) % ir_len;
        w = w + 1;
    }
    ConvolutionReverb_set_position(self, hpos);

    # Extract the VALID window and apply the mix. The first `lead` outputs are the
    # circular-convolution wraparound and are discarded; the linear result for
    # this block starts at index `lead`.
    var mix = ConvolutionReverb_mix(self);
    var dry = f64_sub(F64_ONE, mix);
    var o = 0;
    while (o < block_len) {
        var wet = load64(prod + (lead + o) * 16);
        var inp = vec_get(input, o);
        vec_set(output, o, f64_add(f64_mul(inp, dry), f64_mul(wet, mix)));
        o = o + 1;
    }
    return 0;
}

# ================================================================
# naad_convolution_rebuild_from_ir -- replace the IR (e.g. after a serde-free
# restore), resizing and zeroing the input ring buffer and resetting position.
# Keeps a copy of `ir`, as naad_convolution_from_ir does. The FFT scratch stays
# allocated: process_block rewrites what it uses, and a bump allocator would not
# get the old buffers back. Ports ConvolutionReverb::rebuild_from_ir.
# ================================================================
fn naad_convolution_rebuild_from_ir(self, ir) {
    ConvolutionReverb_set_input_buffer(self, _naad_ring_new(vec_len(ir)));
    ConvolutionReverb_set_position(self, 0);
    ConvolutionReverb_set_ir(self, naad_vec_copy(ir));
    ConvolutionReverb_set_ir_spectrum_len(self, 0);
    return 0;
}

# ================================================================
# naad_convolution_ir_len -- length of the impulse response in samples.
# Ports ConvolutionReverb::ir_len.
# ================================================================
#must_use
fn naad_convolution_ir_len(self) {
    return vec_len(ConvolutionReverb_ir(self));
}

# ================================================================
# naad_convolution_is_loaded -- 1 if an IR is loaded, 0 otherwise (false after
# a serde-free restore). Ports ConvolutionReverb::is_loaded.
# ================================================================
#must_use
fn naad_convolution_is_loaded(self) {
    if (vec_len(ConvolutionReverb_ir(self)) == 0) { return 0; }
    return 1;
}
