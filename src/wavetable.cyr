# wavetable.cyr -- Wavetable synthesis with morphing support.
#
# Ports rust-old/src/wavetable.rs. f32 -> f64 throughout. A `Wavetable`
# holds one cycle of a waveform in a stdlib `vec` of f64 samples. The
# `WavetableOscillator` phase-accumulates and reads with linear
# interpolation; `MorphWavetable` linearly blends between a `vec` of
# equal-length wavetables. serde derives/tests are dropped; constructors
# return the struct pointer on success or a negative NAAD_ERR_* on failure;
# methods become free `wavetable_*` functions taking the struct pointer.
#
# MorphWavetable::next_sample_smooth is the cubic B-spline morph. It calls
# _bspline_eval_1d_into (dsp_spectral.cyr, hisab-backed) and wavetable_morph_new
# builds HVec3 scratch for it, so any unit that uses a morph adds lib/hisab.cyr +
# src/dsp_spectral.cyr ahead of this module. Wavetable and WavetableOscillator are
# hisab-free.
#
# Requires (from the build/test unit): stdlib alloc/vec + math/ganita
# (F64_ONE/TWO/HALF/TAU, f64_clamp, f64_sin/floor) and error.cyr
# (validate_frequency/validate_sample_rate, naad_is_err, naad_vec_copy/zeros,
# NAAD_ERR_*). The module file itself has no `include` lines.

# ================================================================
# Wavetable -- one cycle of a waveform. Immutable once built: Rust moves a
# Wavetable into each oscillator, while here oscillators share the pointer, and
# that sharing is safe only because nothing can change the samples. So the vec
# below is private: wavetable_from_samples copies its input and wavetable_samples
# hands out a copy. Oscillators therefore keep the pointer without copying.
#   samples : vec<f64> waveform samples (one cycle)
# ================================================================
#derive(accessors)
struct Wavetable {
    samples;
}

# ================================================================
# wavetable_from_samples -- build a wavetable from a vec of raw samples, which are
# copied (Rust takes the Vec by value, ADR-0005). Returns the struct pointer, or
# NAAD_ERR_INVALID_PARAMETER if `samples` is empty. Ports Wavetable::from_samples.
# ================================================================
#must_use
fn wavetable_from_samples(samples) {
    if (vec_len(samples) == 0) {
        return NAAD_ERR_INVALID_PARAMETER;
    }
    var self = alloc(sizeof(Wavetable));
    Wavetable_set_samples(self, naad_vec_copy(samples));
    return self;
}

# ================================================================
# wavetable_from_harmonics -- build a `size`-sample wavetable by summing
# sine waves at integer multiples of the fundamental, weighted by
# `amplitudes` (a vec of f64). Only the first min(num_harmonics,
# amplitudes.len) harmonics are generated. The result is normalised so its
# peak magnitude is 1.0. Returns the pointer, or NAAD_ERR_INVALID_PARAMETER if
# num_harmonics == 0, amplitudes is empty, size == 0, or size exceeds VEC_CAP_MAX,
# the most a stdlib vec holds. Ports Wavetable::from_harmonics.
# ================================================================
#must_use
fn wavetable_from_harmonics(num_harmonics, amplitudes, size) {
    if (num_harmonics <= 0) {
        return NAAD_ERR_INVALID_PARAMETER;
    }
    if (vec_len(amplitudes) == 0) {
        return NAAD_ERR_INVALID_PARAMETER;
    }
    if (size <= 0) {
        return NAAD_ERR_INVALID_PARAMETER;
    }
    if (size > VEC_CAP_MAX) {
        return NAAD_ERR_INVALID_PARAMETER;
    }

    var samples = naad_vec_zeros(size);

    var harmonics_to_generate = num_harmonics;
    var alen = vec_len(amplitudes);
    if (alen < harmonics_to_generate) {
        harmonics_to_generate = alen;
    }

    var size_f = f64_from(size);
    var h = 0;
    while (h < harmonics_to_generate) {
        var amp = vec_get(amplitudes, h);
        var harmonic_num = f64_from(h + 1);
        var i = 0;
        while (i < size) {
            var phase = f64_mul(f64_mul(f64_div(f64_from(i), size_f), F64_TAU), harmonic_num);
            var cur = vec_get(samples, i);
            vec_set(samples, i, f64_add(cur, f64_mul(amp, f64_sin(phase))));
            i = i + 1;
        }
        h = h + 1;
    }

    # Normalize to -1..1 (peak magnitude -> 1.0).
    var max_abs = 0;
    var j = 0;
    while (j < size) {
        var a = f64_abs(vec_get(samples, j));
        if (f64_gt(a, max_abs) == 1) {
            max_abs = a;
        }
        j = j + 1;
    }
    if (f64_gt(max_abs, 0) == 1) {
        var k = 0;
        while (k < size) {
            vec_set(samples, k, f64_div(vec_get(samples, k), max_abs));
            k = k + 1;
        }
    }

    var self = alloc(sizeof(Wavetable));
    Wavetable_set_samples(self, samples);
    return self;
}

# ================================================================
# wavetable_samples -- the waveform samples, as a fresh vec. Rust returns a
# read-only `&[f32]`; a vec has no read-only form, and every oscillator on this
# table reads the original. Allocates n * 8 bytes per call and the allocator never
# frees, so keep the result rather than calling this in a loop.
# Ports Wavetable::samples.
# ================================================================
#must_use
fn wavetable_samples(self) {
    return naad_vec_copy(Wavetable_samples(self));
}

# ================================================================
# wavetable_len -- number of samples in the wavetable. Ports Wavetable::len.
# ================================================================
#inline
#must_use
fn wavetable_len(self) {
    return vec_len(Wavetable_samples(self));
}

# ================================================================
# wavetable_is_empty -- 1 if the wavetable has no samples, else 0.
# Ports Wavetable::is_empty.
# ================================================================
#must_use
fn wavetable_is_empty(self) {
    if (vec_len(Wavetable_samples(self)) == 0) {
        return 1;
    }
    return 0;
}

# ================================================================
# _wt_index -- the lower sample index for floored position `index_floor` in a
# table of n samples. Rust's `as usize` takes a negative value to 0; f64_to keeps
# it negative. Saturate at the cast. +overflow is INT64_MAX and `% n` keeps it in
# range.
# ================================================================
#must_use
fn _wt_index(index_floor, n) {
    var floor_i = f64_to(index_floor);
    if (floor_i < 0) { floor_i = 0; }
    return floor_i % n;
}

# Linear interpolation between samples i0 and i1, which are reduced mod the length
# by every caller, so the per-sample vec_get bounds checks are skipped. Relies on
# the vec header layout, as naad_vec_zeros does.
#must_use
fn _wt_lerp(samples, i0, i1, frac) {
    var data = load64(samples);
    var s0 = load64(data + i0 * 8);
    var s1 = load64(data + i1 * 8);
    return f64_add(f64_mul(s0, f64_sub(F64_ONE, frac)), f64_mul(s1, frac));
}

# Advance a phase accumulator one sample, with the oracle's single subtraction.
#must_use
fn _wt_advance_phase(phase, frequency, sample_rate) {
    var next = f64_add(phase, f64_div(frequency, sample_rate));
    if (f64_ge(next, F64_ONE) == 1) { next = f64_sub(next, F64_ONE); }
    return next;
}

# ================================================================
# wavetable_read_interpolated -- read a sample at fractional `phase`
# (0.0..1.0) with linear interpolation and wraparound.
# Ports Wavetable::read_interpolated.
# ================================================================
#must_use
fn wavetable_read_interpolated(self, phase) {
    var samples = Wavetable_samples(self);
    var n = vec_len(samples);
    var index = f64_mul(phase, f64_from(n));
    var index_floor = f64_floor(index);
    var frac = f64_sub(index, index_floor);
    var i0 = _wt_index(index_floor, n);
    return _wt_lerp(samples, i0, (i0 + 1) % n, frac);
}

# ================================================================
# WavetableOscillator -- reads from a single wavetable via phase accum.
#   table       : Wavetable pointer
#   phase       : f64 current phase (0.0..1.0)
#   sample_rate : f64 Hz
#   frequency   : f64 playback frequency (Hz)
# ================================================================
#derive(accessors)
struct WavetableOscillator {
    table;
    phase;
    sample_rate;
    frequency;
}

# ================================================================
# wavetable_osc_new -- new oscillator over `table`. Returns the pointer, or a
# negative NAAD_ERR_* on invalid sample_rate/frequency, or on a `table` that is a
# failed wavetable_from_*: Rust's `?` stops that at the call site, and stored here
# it would fault on the first sample. Ports WavetableOscillator::new.
# ================================================================
#must_use
fn wavetable_osc_new(table, frequency, sample_rate) {
    if (table <= 0) {
        return NAAD_ERR_INVALID_PARAMETER;
    }
    var e = validate_sample_rate(sample_rate);
    if (naad_is_err(e) == 1) {
        return e;
    }
    e = validate_frequency(frequency, sample_rate);
    if (naad_is_err(e) == 1) {
        return e;
    }
    var self = alloc(sizeof(WavetableOscillator));
    WavetableOscillator_set_table(self, table);
    WavetableOscillator_set_phase(self, 0);
    WavetableOscillator_set_sample_rate(self, sample_rate);
    WavetableOscillator_set_frequency(self, frequency);
    return self;
}

# Shared reference to the wavetable. Ports WavetableOscillator::table.
#inline
#must_use
fn wavetable_osc_table(self) {
    return WavetableOscillator_table(self);
}

# Current phase (0.0..1.0). Ports WavetableOscillator::phase.
#inline
#must_use
fn wavetable_osc_phase(self) {
    return WavetableOscillator_phase(self);
}

# Sample rate (Hz). Ports WavetableOscillator::sample_rate.
#inline
#must_use
fn wavetable_osc_sample_rate(self) {
    return WavetableOscillator_sample_rate(self);
}

# Playback frequency (Hz). Ports WavetableOscillator::frequency.
#inline
#must_use
fn wavetable_osc_frequency(self) {
    return WavetableOscillator_frequency(self);
}

# ================================================================
# wavetable_osc_set_frequency -- update playback frequency. Returns
# NAAD_ERR_NONE on success or a negative NAAD_ERR_* if invalid for the sample rate.
# Ports WavetableOscillator::set_frequency.
# ================================================================
fn wavetable_osc_set_frequency(self, freq) {
    var e = validate_frequency(freq, WavetableOscillator_sample_rate(self));
    if (naad_is_err(e) == 1) {
        return e;
    }
    WavetableOscillator_set_frequency(self, freq);
    return NAAD_ERR_NONE;
}

# ================================================================
# wavetable_osc_next_sample -- next sample with linear interpolation,
# advancing the phase accumulator. Ports WavetableOscillator::next_sample.
# ================================================================
#must_use
fn wavetable_osc_next_sample(self) {
    var phase = WavetableOscillator_phase(self);
    var sample = wavetable_read_interpolated(WavetableOscillator_table(self), phase);
    var frequency = WavetableOscillator_frequency(self);
    var sample_rate = WavetableOscillator_sample_rate(self);
    WavetableOscillator_set_phase(self, _wt_advance_phase(phase, frequency, sample_rate));
    return sample;
}

# ================================================================
# wavetable_osc_fill_buffer -- fill a vec<f64> with successive samples.
# Ports WavetableOscillator::fill_buffer.
# ================================================================
fn wavetable_osc_fill_buffer(self, buffer) {
    var n = vec_len(buffer);
    if (n == 0) { return 0; }
    var samples = Wavetable_samples(WavetableOscillator_table(self));
    var size = vec_len(samples);
    var i = 0;
    var table = load64(samples);
    var data = load64(buffer);
    var len = f64_from(size);
    var dt = f64_div(WavetableOscillator_frequency(self), WavetableOscillator_sample_rate(self));
    var phase = WavetableOscillator_phase(self);
    while (i < n) {
        var index = f64_mul(phase, len);
        var index_floor = f64_floor(index);
        var frac = f64_sub(index, index_floor);
        var i0 = _wt_index(index_floor, size);
        var i1 = (i0 + 1) % size;
        store64(data + i * 8, f64_add(f64_mul(load64(table + i0 * 8), f64_sub(F64_ONE, frac)),
            f64_mul(load64(table + i1 * 8), frac)));
        var next = f64_add(phase, dt);
        if (f64_ge(next, F64_ONE) == 1) { next = f64_sub(next, F64_ONE); }
        phase = next;
        i = i + 1;
    }
    WavetableOscillator_set_phase(self, phase);
    return 0;
}

# ================================================================
# MorphWavetable -- a vec of equal-length wavetables blended by position.
#   tables      : private vec of Wavetable pointers (a copy: Rust takes the Vec by
#                 value and exposes only a read-only slice, ADR-0005)
#   num_tables  : its length. Fixed at construction; every per-sample path reads
#                 this, and the scratch below is sized to it.
#   position    : f64 morph position (0.0..1.0)
#   phase       : f64 current phase (0.0..1.0)
#   sample_rate : f64 Hz
#   frequency   : f64 playback frequency (Hz)
# ================================================================
#   table_len   : samples per table (every table shares it, so they also share
#                 one lookup: read_i0 / read_i1 / read_frac / read_phase, see
#                 _morph_locate)
#   span_knots  : vec of the interior knots, for _morph_span
# scratch_cps / scratch_knots / scratch_cps_arr: scratch for the
# smooth (cubic B-spline) morph path. Allocated once here because the oracle's
# per-call Vec would be a permanent leak under a bump allocator with no free.
#derive(accessors)
struct MorphWavetable {
    tables;
    num_tables;
    table_len;
    position;
    phase;
    sample_rate;
    frequency;
    read_i0;
    read_i1;
    read_frac;
    read_phase;
    span_knots;
    scratch_cps;
    scratch_knots;
    scratch_cps_arr;
}

# ================================================================
# wavetable_morph_new -- new morph wavetable over `tables`. Returns the
# pointer, or a negative NAAD_ERR_* if tables is empty, holds a failed
# wavetable_from_*, the wavetables differ in length, or sample_rate/frequency is
# invalid. Ports MorphWavetable::new.
# ================================================================
#must_use
fn wavetable_morph_new(tables, frequency, sample_rate) {
    var nt = vec_len(tables);
    if (nt == 0) {
        return NAAD_ERR_INVALID_PARAMETER;
    }
    var i = 0;
    while (i < nt) {
        if (vec_get(tables, i) <= 0) {
            return NAAD_ERR_INVALID_PARAMETER;
        }
        i = i + 1;
    }
    # All tables must share a length for correct morphing.
    var first_len = wavetable_len(vec_get(tables, 0));
    i = 0;
    while (i < nt) {
        if (wavetable_len(vec_get(tables, i)) != first_len) {
            return NAAD_ERR_INVALID_PARAMETER;
        }
        i = i + 1;
    }
    var e = validate_sample_rate(sample_rate);
    if (naad_is_err(e) == 1) {
        return e;
    }
    e = validate_frequency(frequency, sample_rate);
    if (naad_is_err(e) == 1) {
        return e;
    }
    var self = alloc(sizeof(MorphWavetable));
    MorphWavetable_set_tables(self, naad_vec_copy(tables));
    MorphWavetable_set_num_tables(self, nt);
    MorphWavetable_set_table_len(self, first_len);
    MorphWavetable_set_position(self, 0);
    MorphWavetable_set_phase(self, 0);
    MorphWavetable_set_sample_rate(self, sample_rate);
    MorphWavetable_set_frequency(self, frequency);

    # The interior knots of the clamped open-uniform vector, by the same expression
    # as _bspline_eval_1d_into, so _morph_span agrees with it bit for bit.
    var interior = nt - 4;
    if (interior < 0) { interior = 0; }
    var span_knots = naad_vec_zeros(interior);
    var ki = 0;
    while (ki < interior) {
        vec_set(span_knots, ki, f64_div(f64_from(ki + 1), f64_from(interior + 1)));
        ki = ki + 1;
    }
    MorphWavetable_set_span_knots(self, span_knots);

    # Smooth-morph scratch, sized once for nt control points at cubic degree 3
    # (n_knots = nt + 3 + 1). Reused every sample by
    # wavetable_morph_next_sample_smooth via _bspline_eval_1d_into.
    MorphWavetable_set_scratch_cps(self, naad_vec_zeros(nt));
    MorphWavetable_set_scratch_knots(self, alloc((nt + 4) * 8));
    MorphWavetable_set_scratch_cps_arr(self, alloc(nt * 8));
    return self;
}

# The wavetables, as a fresh vec of the shared Wavetable pointers. Rust returns a
# read-only slice; the morph's own vec must keep the length its scratch is sized
# to. Allocates per call, so keep the result rather than calling this in a loop.
# Ports MorphWavetable::tables.
#must_use
fn wavetable_morph_tables(self) {
    return naad_vec_copy(MorphWavetable_tables(self));
}

# Current morph position (0.0..1.0). Ports MorphWavetable::position.
#inline
#must_use
fn wavetable_morph_position(self) {
    return MorphWavetable_position(self);
}

# Current phase (0.0..1.0). Ports MorphWavetable::phase.
#inline
#must_use
fn wavetable_morph_phase(self) {
    return MorphWavetable_phase(self);
}

# Sample rate (Hz). Ports MorphWavetable::sample_rate.
#inline
#must_use
fn wavetable_morph_sample_rate(self) {
    return MorphWavetable_sample_rate(self);
}

# Playback frequency (Hz). Ports MorphWavetable::frequency.
#inline
#must_use
fn wavetable_morph_frequency(self) {
    return MorphWavetable_frequency(self);
}

# ================================================================
# wavetable_morph_set_morph -- set the morph position (clamped to 0..1).
# Ports MorphWavetable::set_morph.
# ================================================================
fn wavetable_morph_set_morph(self, position) {
    MorphWavetable_set_position(self, f64_clamp(position, 0, F64_ONE));
    return 0;
}

# ================================================================
# _morph_locate -- find `phase` in the tables once for this sample. They all have
# table_len samples, so one index and fraction serves every read.
# ================================================================
fn _morph_locate(self, phase) {
    var n = MorphWavetable_table_len(self);
    var index = f64_mul(phase, f64_from(n));
    var index_floor = f64_floor(index);
    var i0 = _wt_index(index_floor, n);
    MorphWavetable_set_read_i0(self, i0);
    MorphWavetable_set_read_i1(self, (i0 + 1) % n);
    MorphWavetable_set_read_frac(self, f64_sub(index, index_floor));
    MorphWavetable_set_read_phase(self, phase);
    return 0;
}

# Table `t` at the phase _morph_locate found. The shared index is only good for a
# table of table_len samples, and Wavetable_samples is a public setter.
#must_use
fn _morph_read(self, t) {
    var table = vec_get(MorphWavetable_tables(self), t);
    var samples = Wavetable_samples(table);
    if (vec_len(samples) != MorphWavetable_table_len(self)) {
        return wavetable_read_interpolated(table, MorphWavetable_read_phase(self));
    }
    return _wt_lerp(samples, MorphWavetable_read_i0(self), MorphWavetable_read_i1(self),
      MorphWavetable_read_frac(self));
}

# Linear blend of the two tables either side of `position`.
#must_use
fn _morph_linear(self, num_tables) {
    var scaled = f64_mul(MorphWavetable_position(self), f64_from(num_tables - 1));
    # Rust's `as usize` takes a negative value to 0; f64_to keeps it negative.
    # Saturate at the cast, on both sides: f64_to gives INT64_MAX on +overflow.
    var idx_low = f64_to(f64_floor(scaled));
    if (idx_low < 0) { idx_low = 0; }
    if (idx_low > num_tables - 2) { idx_low = num_tables - 2; }
    var frac = f64_sub(scaled, f64_from(idx_low));
    var s_low = _morph_read(self, idx_low);
    var s_high = _morph_read(self, idx_low + 1);
    return f64_add(f64_mul(s_low, f64_sub(F64_ONE, frac)), f64_mul(s_high, frac));
}

# Advance the morph's phase one sample from `phase`.
fn _morph_advance(self, phase) {
    var frequency = MorphWavetable_frequency(self);
    var sample_rate = MorphWavetable_sample_rate(self);
    MorphWavetable_set_phase(self, _wt_advance_phase(phase, frequency, sample_rate));
    return 0;
}

# ================================================================
# _morph_span -- the knot span holding t in [0, 1]: the largest k in
# [3, num_tables - 1] with knots[k] <= t, which is hisab's span search. A cubic
# reads control points k - 3 .. k and no others.
# ================================================================
#must_use
fn _morph_span(self, t) {
    var knots = MorphWavetable_span_knots(self);
    var n = vec_len(knots);
    var j = 0;
    while (j < n) {
        if (f64_gt(vec_get(knots, j), t) == 1) { return 3 + j; }
        j = j + 1;
    }
    return 3 + n;
}

# ================================================================
# wavetable_morph_next_sample -- next sample, linearly blending the two
# adjacent tables at the current morph position, then advancing the phase.
# Ports MorphWavetable::next_sample.
# ================================================================
#must_use
fn wavetable_morph_next_sample(self) {
    var num_tables = MorphWavetable_num_tables(self);
    var phase = MorphWavetable_phase(self);
    _morph_locate(self, phase);

    var sample = 0;
    if (num_tables == 1) {
        sample = _morph_read(self, 0);
    } else {
        sample = _morph_linear(self, num_tables);
    }

    _morph_advance(self, phase);
    return sample;
}

# wavetable_morph_next_sample_smooth -- cubic B-spline morph across tables.
# Ports MorphWavetable::next_sample_smooth. With < 4 tables, falls back to the
# linear wavetable_morph_next_sample. Otherwise evaluates a degree-3 B-spline with
# the tables at the current phase as control points, at `position`, with a linear
# blend fallback where the oracle's bspline_eval_1d returns None. Only the four
# tables in the span are read: the oracle reads every table, but the rest cannot
# reach the result and a table read has no side effect. Their scratch_cps entries
# stay stale, so this needs _bspline_eval_1d_into (dsp_spectral.cyr) to read only
# control points k - 3 .. k, as de Boor's algorithm does.
#must_use
fn wavetable_morph_next_sample_smooth(self) {
    var num_tables = MorphWavetable_num_tables(self);
    if (num_tables < 4) { return wavetable_morph_next_sample(self); }

    var phase = MorphWavetable_phase(self);
    var position = MorphWavetable_position(self);
    _morph_locate(self, phase);

    # The oracle's bspline_eval_1d returns None only outside 0.0..=1.0, NaN included,
    # so both comparisons must hold. Inside that range its Some value is the sample
    # even when a table's NaN or infinity made it non-finite, so the value must not
    # decide the fallback.
    var in_range = 0;
    if (f64_ge(position, 0) == 1) {
        if (f64_le(position, F64_ONE) == 1) { in_range = 1; }
    }
    var sample = 0;
    if (in_range == 1) {
        var cps = MorphWavetable_scratch_cps(self);
        var k = _morph_span(self, position);
        var i = k - 3;
        while (i <= k) {
            vec_set(cps, i, _morph_read(self, i));
            i = i + 1;
        }
        sample = _bspline_eval_1d_into(3, cps, position,
          MorphWavetable_scratch_knots(self),
          MorphWavetable_scratch_cps_arr(self));
    } else {
        sample = _morph_linear(self, num_tables);
    }

    _morph_advance(self, phase);
    return sample;
}
