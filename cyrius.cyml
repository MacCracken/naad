[package]
name = "naad"
version = "${file:VERSION}"
description = "naad — audio synthesis primitives (oscillators, filters, envelopes, modulation, wavetables, effects, dynamics, synthesis, acoustics). Cyrius port of a 13,465-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/naad"
language = "cyrius"
cyrius = "6.5.35"

[build]
entry = "src/main.cyr"
output = "build/naad"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/naad.cyr` — all 39 modules concatenated in dependency order (deps
# before dependents; the oscillator cluster is mutually referential, fine in
# the flat namespace). Every module is self-contained (no `include` lines).
# The bundle resolves stdlib + hisab (HVec3/HComplex/num_fft/calc_bspline/
# ganita) + goonj (acoustics engine, which itself pulls sakshi) from the
# CONSUMER's manifest. Cross-module symbol collisions audited to zero: all 446
# top-level fns share one flat namespace once concatenated, and the bundle's fn
# set is disjoint from hisab, goonj, sakshi, abaco and the stdlib. Re-measure
# rather than trusting this number: `grep -c '^fn ' dist/naad.cyr`. NOTE the
# audit is fn-scoped and provably cannot see top-level `var` collisions --
# naad's ERR_INVALID_FREQUENCY (-1) still shadows goonj's (-3); see
# tests/bundle.tcyr.
[lib]
modules = [
    "src/error.cyr",
    "src/dsp_util.cyr",
    "src/dsp_spectral.cyr",
    "src/noise.cyr",
    "src/panning.cyr",
    "src/mod_matrix.cyr",
    "src/tuning.cyr",
    "src/voice.cyr",
    "src/smoothing.cyr",
    "src/delay.cyr",
    "src/filter.cyr",
    "src/granular.cyr",
    "src/wavetable.cyr",
    "src/envelope.cyr",
    "src/additive.cyr",
    "src/reverb.cyr",
    "src/eq.cyr",
    "src/formant.cyr",
    "src/vocoder.cyr",
    "src/drum.cyr",
    "src/dynamics.cyr",
    "src/fm.cyr",
    "src/physical.cyr",
    "src/osc_core.cyr",
    "src/osc_unison.cyr",
    "src/osc_sub.cyr",
    "src/osc_sync.cyr",
    "src/modulation.cyr",
    "src/effects.cyr",
    "src/subtractive.cyr",
    "src/acoustics.cyr",
    "src/acoustics_room.cyr",
    "src/acoustics_directivity.cyr",
    "src/acoustics_ambisonics.cyr",
    "src/acoustics_fdn.cyr",
    "src/acoustics_binaural.cyr",
    "src/acoustics_analysis.cyr",
    "src/acoustics_convolution.cyr",
    "src/acoustics_coupled.cyr",
]

# stdlib: the math-heavy port set hisab/goonj use. `math` gives
# clamp/min/max/lerp/sign + F64_* constants; `ganita` gives the
# transcendentals naad's DSP leans on (sin/cos/tan/exp/ln/pow/sqrt/…).
# `bench` for .bcyr harnesses, `fnptr`/`callback` for the closure→fn-ptr
# port pattern, `tagged` for the few Option-shaped returns.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "fnptr",
    "callback",
    "bench",
]

# hisab — math/geometry. naad consumes HVec3 (envelope, additive,
# physical, wavetable) and HComplex + num_fft/num_ifft/num_dct/num_idct/
# num_rk4/calc_bspline/calc_catmull_rom (dsp_spectral, additive, wavetable)
# from the single distlib bundle, same pattern goonj uses. Pinned to the
# released tag for reproducible builds.
#   NOTE the least-squares path (`ganita_mat_*`, used by `fit_polynomial`)
#   is NOT hisab's — it comes from the stdlib `ganita` leaf declared in
#   [deps].stdlib above. `lib/hisab.cyr` defines no `ganita_mat_*`. Earlier
#   revisions of this comment (and the 2.0.0 CHANGELOG entry) attributed it
#   to hisab; that is where the 2.1.2 null-deref actually originated.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "2.11.2"
modules = ["dist/hisab.cyr"]

# goonj — acoustics engine. Consumed by the `acoustics/*` wrapper modules
# (room, impulse, binaural, material, analysis, coupled, portal, fdn,
# directivity, ambisonics). Its bundle references sakshi (goonj's logging)
# + hisab; both resolve from naad's own deps (sakshi arrives transitively
# via hisab). Pinned to the released tag.
[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
tag = "2.0.4"
modules = ["dist/goonj.cyr"]
