[package]
name = "naad"
version = "${file:VERSION}"
description = "naad — audio synthesis primitives (oscillators, filters, envelopes, modulation, wavetables, effects, dynamics, synthesis, acoustics). Cyrius port of a 13,465-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/naad"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/naad"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/naad.cyr` — all 39 modules concatenated in dependency order (deps
# before dependents; the oscillator cluster is mutually referential, fine in
# the flat namespace). Every module is self-contained (no `include` lines).
# The bundle resolves stdlib + hisab (HVec3/HComplex/num_fft/calc_bspline/
# ganita) + goonj (acoustics engine, which itself pulls sakshi) from the
# CONSUMER's manifest. Cross-library symbol collisions audited to zero, and
# since 2.1.3 that audit covers top-level `var`s as well as `fn`s. naad's six
# error constants carry the `NAAD_ERR_` prefix precisely so the `var` class
# stays empty -- the bare names used to shadow goonj's, and duplicate top-level
# `var`s draw NO diagnostic from cycc or cyrlint. abaco 2.8.0 then added a
# `power_spectrum` of its own, which naad renamed to `naad_power_spectrum` in
# 2.3.4. Since then CI checks the bundle against hisab, goonj, sakshi, the
# stdlib and the newest tag of all 15 siblings dhvani links with naad,
# `public` declarations and enum members included. Re-measure rather than
# trusting this, in bash (zsh does not split $SIBLINGS), in two steps so that a
# failed fetch stops it:
#   SIBLINGS="$(./scripts/fetch-sibling-bundles.sh build/siblings)"
#   ./scripts/symbol-collision-check.sh $SIBLINGS
# `tests/bundle.tcyr` pins the de-collision.
[lib]
modules = [
    "src/error.cyr",
    "src/dsp_util.cyr",
    "src/dsp_spectral.cyr",
    "src/noise.cyr",
    "src/panning.cyr",
    "src/mod_matrix.cyr",
    "src/tuning.cyr",
    "src/voice.cyr",
    "src/smoothing.cyr",
    "src/delay.cyr",
    "src/filter.cyr",
    "src/granular.cyr",
    "src/wavetable.cyr",
    "src/envelope.cyr",
    "src/additive.cyr",
    "src/reverb.cyr",
    "src/eq.cyr",
    "src/formant.cyr",
    "src/vocoder.cyr",
    "src/drum.cyr",
    "src/dynamics.cyr",
    "src/fm.cyr",
    "src/physical.cyr",
    "src/osc_core.cyr",
    "src/osc_unison.cyr",
    "src/osc_sub.cyr",
    "src/osc_sync.cyr",
    "src/modulation.cyr",
    "src/effects.cyr",
    "src/subtractive.cyr",
    "src/acoustics.cyr",
    "src/acoustics_room.cyr",
    "src/acoustics_directivity.cyr",
    "src/acoustics_ambisonics.cyr",
    "src/acoustics_fdn.cyr",
    "src/acoustics_binaural.cyr",
    "src/acoustics_analysis.cyr",
    "src/acoustics_convolution.cyr",
    "src/acoustics_coupled.cyr",
]

# stdlib: the math-heavy port set hisab/goonj use. `math` gives
# clamp/min/max/lerp/sign + F64_* constants; `ganita` gives the
# transcendentals naad's DSP leans on (sin/cos/tan/exp/ln/pow/sqrt/…).
# `bench` for .bcyr harnesses, `fnptr`/`callback` for the closure→fn-ptr
# port pattern, `tagged` for the few Option-shaped returns, `result` for
# hisab's fallible returns (`num_fft` and friends, since hisab 3.0.0).
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "result",
    "fnptr",
    "callback",
    "bench",
]

# hisab — math/geometry. naad consumes HVec3 (envelope, additive,
# physical, wavetable) and HComplex + num_fft/num_ifft/num_dct/num_idct/
# num_rk4/calc_bspline/calc_catmull_rom (dsp_spectral, additive, wavetable)
# from the single distlib bundle, same pattern goonj uses. Pinned to the
# released tag for reproducible builds. 3.5.0 pins exactly cyrius 6.7.18.
# From 3.4.2 hisab no longer declares a `[deps.sakshi]` package: sakshi is a
# stdlib leaf, and goonj's `dist/goonj.deps` sidecar names it (see below).
#   NOTE the least-squares path (`ganita_mat_*`, used by `fit_polynomial`)
#   is NOT hisab's — it comes from the stdlib `ganita` leaf declared in
#   [deps].stdlib above. `lib/hisab.cyr` defines no `ganita_mat_*`. Earlier
#   revisions of this comment (and the 2.0.0 CHANGELOG entry) attributed it
#   to hisab; that is where the 2.1.2 null-deref actually originated.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.5.0"
modules = ["dist/hisab.cyr"]

# goonj — acoustics engine. Consumed by the `acoustics/*` wrapper modules
# (room, impulse, binaural, material, analysis, coupled, portal, fdn,
# directivity, ambisonics). Its bundle references sakshi (goonj's logging),
# simd + hisab. hisab resolves from naad's own `[deps.hisab]`; sakshi and simd
# are stdlib leaves that goonj's `dist/goonj.deps` sidecar names, so `cyrius
# deps` vendors them without naad declaring either. Pinned to the released
# tag. 2.3.2 pins cyrius 6.7.18 and hisab 3.5.0, so the two agree, and its BVH
# query needs hisab >= 3.4.2 (`hisab_alloc_scope`).
[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
tag = "2.3.2"
modules = ["dist/goonj.cyr"]
