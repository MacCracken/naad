# filter.tcyr -- parity tests for src/filter.cyr.
# Ported from the non-serde #[test] blocks in rust-old/src/filter.rs
# (test_serde_roundtrip dropped -- no serde). f32 tolerances widened to f64.

include "src/error.cyr"
include "src/filter.cyr"

alloc_init();

var C0_707 = 0x3fe69fbe76c8b439;   # 0.707
var C0_01  = 0x3f847ae147ae147b;   # 0.01
var C0_7   = 0x3fe6666666666666;   # 0.7

var SR      = 44100;
var FREQ_1K = 1000;

# ================================================================
test_group("lowpass basic (DC passes)");
var lp = filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(SR), f64_from(FREQ_1K), C0_707);
var lp_out = 0;
var i = 0;
while (i < 1000) {
    lp_out = filter_biquad_process_sample(lp, F64_ONE);
    i = i + 1;
}
assert(f64_lt(f64_abs(f64_sub(lp_out, F64_ONE)), C0_01), "DC should pass through LP");

# ================================================================
test_group("highpass blocks DC");
var hp = filter_biquad_new(NAAD_FILTER_HIGHPASS, f64_from(SR), f64_from(FREQ_1K), C0_707);
var hp_out = 0;
i = 0;
while (i < 1000) {
    hp_out = filter_biquad_process_sample(hp, F64_ONE);
    i = i + 1;
}
assert(f64_lt(f64_abs(hp_out), C0_01), "HP should block DC");

# ================================================================
test_group("invalid params");
assert(naad_is_err(filter_biquad_new(NAAD_FILTER_LOWPASS, 0, f64_from(FREQ_1K), C0_7)), "zero sample rate err");
assert(naad_is_err(filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(SR), 0, C0_7)), "zero frequency err");
assert(naad_is_err(filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(SR), f64_from(FREQ_1K), 0)), "zero q err");
assert(naad_is_err(filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(SR), f64_from(30000), C0_7)), "above nyquist err");

# ================================================================
test_group("set params");
var sp = filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(SR), f64_from(FREQ_1K), C0_707);
assert_eq(filter_biquad_set_params(sp, f64_from(2000), F64_ONE, 0), NAAD_ERR_NONE, "set_params(2000,1,0) ok");
assert(naad_is_err(filter_biquad_set_params(sp, 0, F64_ONE, 0)), "set_params(0,1,0) err");

# ================================================================
test_group("svf basic (finite outputs)");
var svf = filter_svf_new(f64_from(FREQ_1K), C0_707, f64_from(SR));
var out = filter_svf_process_sample(svf, F64_ONE);
assert(naad_is_finite(SvfOutput_low_pass(out)), "svf low_pass finite");
assert(naad_is_finite(SvfOutput_high_pass(out)), "svf high_pass finite");
assert(naad_is_finite(SvfOutput_band_pass(out)), "svf band_pass finite");
assert(naad_is_finite(SvfOutput_notch(out)), "svf notch finite");

# ================================================================
test_group("process buffer (all finite)");
var pf = filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(SR), f64_from(FREQ_1K), C0_707);
var buf = vec_new();
var bi = 0;
while (bi < 256) { vec_push(buf, F64_ONE); bi = bi + 1; }
filter_biquad_process_buffer(pf, buf);
var all_finite = 1;
bi = 0;
while (bi < 256) {
    if (naad_is_finite(vec_get(buf, bi)) == 0) { all_finite = 0; }
    bi = bi + 1;
}
assert(all_finite, "process_buffer outputs finite");

var rc = assert_summary();
syscall(60, rc);
