# effects.tcyr -- parity tests for src/effects.cyr.
# Ports every non-serde #[test] from rust-old/src/effects.rs one-for-one.
# The serde round-trip test (test_serde_roundtrip) is dropped (no serde in
# Cyrius). f32 tolerances widen to f64 (NAAD_EPSILON). Deps are included in
# dependency order; effects.cyr comes last.

include "src/error.cyr"
include "src/dsp_util.cyr"
include "src/delay.cyr"
include "src/noise.cyr"
include "src/osc_core.cyr"
include "src/osc_unison.cyr"
include "src/osc_sub.cyr"
include "src/osc_sync.cyr"
include "src/effects.cyr"

alloc_init();

var C0_5 = 0x3FE0000000000000;   # 0.5

var i = 0;

# ================================================================
# chorus -- process_sample of a 3-voice chorus is finite.
# ================================================================
test_group("chorus");
var chorus = effects_chorus_new(3, f64_from(10), f64_from(3), C0_5, C0_5, f64_from(44100));
var cout = effects_chorus_process_sample(chorus, F64_ONE);
assert(naad_is_finite(cout), "chorus output is finite");

# ================================================================
# flanger -- process_sample is finite.
# ================================================================
test_group("flanger");
var flanger = effects_flanger_new(f64_from(2), F64_ONE, C0_5, C0_5, C0_5, f64_from(44100));
var fout = effects_flanger_process_sample(flanger, F64_ONE);
assert(naad_is_finite(fout), "flanger output is finite");

# ================================================================
# phaser -- 100 samples all finite (feedback stability check).
# ================================================================
test_group("phaser");
var phaser = effects_phaser_new(4, C0_5, f64_from(200), f64_from(2000), C0_5, C0_5, f64_from(44100));
var ph_ok = 1;
i = 0;
while (i < 100) {
    var po = effects_phaser_process_sample(phaser, F64_ONE);
    if (naad_is_finite(po) == 0) { ph_ok = 0; }
    i = i + 1;
}
assert(ph_ok, "phaser produced non-finite output");

# ================================================================
# soft clip -- saturates to within [-1, 1].
# ================================================================
test_group("soft clip");
var dsoft = effects_distortion_new(DISTORTION_SOFT_CLIP, f64_from(10), F64_ONE);
var so = effects_distortion_process_sample(dsoft, C0_5);
assert(f64_le(f64_abs(so), F64_ONE), "soft clip should saturate");

# ================================================================
# hard clip -- 0.5 * 10 = 5.0 clamps to 1.0.
# ================================================================
test_group("hard clip");
var dhard = effects_distortion_new(DISTORTION_HARD_CLIP, f64_from(10), F64_ONE);
var ho = effects_distortion_process_sample(dhard, C0_5);
assert(f64_lt(f64_abs(f64_sub(ho, F64_ONE)), NAAD_EPSILON), "hard clip of 5.0 should be 1.0");

# ================================================================
# wave fold -- stays within [-1, 1].
# ================================================================
test_group("wave fold");
var dfold = effects_distortion_new(DISTORTION_WAVE_FOLD, f64_from(3), F64_ONE);
var wo = effects_distortion_process_sample(dfold, C0_5);
assert(f64_le(f64_abs(wo), F64_ONE), "wave fold should stay in range");

# ================================================================
# mix dry -- mix 0.0 passes the input through unchanged.
# ================================================================
test_group("mix dry");
var ddry = effects_distortion_new(DISTORTION_HARD_CLIP, f64_from(10), 0);
var dryo = effects_distortion_process_sample(ddry, C0_5);
assert(f64_lt(f64_abs(f64_sub(dryo, C0_5)), NAAD_EPSILON), "mix 0.0 should be fully dry");

# ================================================================
# soft clip past the f64_exp overflow threshold. Before cyrius 6.5.35 this
# returned NaN and survived the dry+wet blend in effects_distortion_process_
# sample. `drive` is floored at 0 but deliberately NOT capped (the oracle,
# rust-old/src/effects.rs:290, is `drive.max(0.0)` with no upper bound), so
# the saturation must come from tanh itself.
# ================================================================
test_group("soft clip saturates past exp overflow");
var dsat = effects_distortion_new(DISTORTION_SOFT_CLIP, f64_from(1000), F64_ONE);
var sato = effects_distortion_process_sample(dsat, F64_ONE);
assert_eq(naad_is_finite(sato), 1, "soft clip at drive 1000 stays finite");
assert(f64_le(f64_abs(sato), F64_ONE), "soft clip at drive 1000 stays in [-1, 1]");

# ================================================================
# counts -- a voice or stage count is bounded on both sides.
# ================================================================
test_group("voice and stage counts");
var cnt_sr = f64_from(44100);
var cnt_over = VEC_CAP_MAX + 1;
var cnt_ch_over = effects_chorus_new(cnt_over, f64_from(10), f64_from(3), C0_5, C0_5, cnt_sr);
assert_eq(cnt_ch_over, NAAD_ERR_BUFFER_OVERFLOW, "chorus refuses a voice count past the cap");
var cnt_ph_over = effects_phaser_new(cnt_over, C0_5, f64_from(200), f64_from(2000), C0_5, C0_5, cnt_sr);
assert_eq(cnt_ph_over, NAAD_ERR_BUFFER_OVERFLOW, "phaser refuses a stage count past the cap");
var cnt_ch = effects_chorus_new(0 - 3, f64_from(10), f64_from(3), C0_5, C0_5, cnt_sr);
assert_eq(Chorus_num_voices(cnt_ch), 1, "a negative voice count floors to 1");
var cnt_ph = effects_phaser_new(0 - 3, C0_5, f64_from(200), f64_from(2000), C0_5, C0_5, cnt_sr);
assert_eq(Phaser_num_stages(cnt_ph), 2, "a negative stage count floors to 2");
assert_eq(vec_len(Phaser_allpass_states(cnt_ph)), 2, "the state vec matches the stage count");
assert_eq(vec_get(Phaser_allpass_states(cnt_ph), 1), 0, "phaser state starts at +0.0");

# ================================================================
# chorus -- a refused LFO leaves no delay storage behind.
# ================================================================
test_group("failed chorus keeps no delay line");
# One second of delay is about 350 KB; the bump allocator could not reclaim it.
var fl_used = alloc_used();
var fl_ch = effects_chorus_new(1, f64_from(1000), 0, f64_from(30000), C0_5, cnt_sr);
assert_eq(fl_ch, NAAD_ERR_INVALID_FREQUENCY, "an LFO over Nyquist is refused");
assert(alloc_used() - fl_used < 4096, "the refusal costs no delay storage");

# ================================================================
# distortion -- an unknown type is refused, and is unity if set by hand.
# ================================================================
test_group("distortion type range");
assert_eq(effects_distortion_new(3, F64_ONE, F64_ONE), NAAD_ERR_INVALID_PARAMETER, "one past the last type is refused");
assert_eq(effects_distortion_new(0 - 1, F64_ONE, F64_ONE), NAAD_ERR_INVALID_PARAMETER, "a negative type is refused");
assert(effects_distortion_new(DISTORTION_SOFT_CLIP, F64_ONE, F64_ONE) > 0, "the first type is accepted");
assert(effects_distortion_new(DISTORTION_WAVE_FOLD, F64_ONE, F64_ONE) > 0, "the last type is accepted");
# 1.5 at drive 1 folds to 0.5, so unity (1.5) cannot be mistaken for WaveFold.
var C1_5 = 0x3FF8000000000000;
var dt_set = effects_distortion_new(DISTORTION_WAVE_FOLD, F64_ONE, F64_ONE);
assert_eq(effects_distortion_process_sample(dt_set, C1_5), C0_5, "wave fold reflects at 1.0");
Distortion_set_distortion_type(dt_set, 99);
assert_eq(effects_distortion_process_sample(dt_set, C1_5), C1_5, "an unknown type set by hand is unity");

# ================================================================
# delay sizing -- a negative delay is a one-slot line, not an error code.
# ================================================================
test_group("delay sizing");
var neg_ms = f64_from(0 - 100);
var neg_ch = effects_chorus_new(1, neg_ms, 0, C0_5, C0_5, cnt_sr);
assert(neg_ch > 0, "chorus builds from a negative delay");
assert_eq(DelayLine_max_delay_samples(vec_get(Chorus_delay_lines(neg_ch), 0)), 1, "chorus line floors to one slot");
var neg_fl = effects_flanger_new(neg_ms, 0, C0_5, C0_5, C0_5, cnt_sr);
assert(neg_fl > 0, "flanger builds from a negative delay");
assert_eq(DelayLine_max_delay_samples(Flanger_delay_line(neg_fl)), 1, "flanger line floors to one slot");
# 10 ms + 3 ms at 44.1 kHz is 573.3 samples; plus one, truncated, is 574.
var pos_fl = effects_flanger_new(f64_from(10), f64_from(3), C0_5, C0_5, C0_5, cnt_sr);
assert_eq(DelayLine_max_delay_samples(Flanger_delay_line(pos_fl)), 574, "line length is base + depth + 1, truncated");
var long_fl = effects_flanger_new(f64_from(1000000000), 0, C0_5, C0_5, C0_5, cnt_sr);
assert_eq(long_fl, NAAD_ERR_BUFFER_OVERFLOW, "an overlong delay is refused");

# ================================================================
# phaser sweep -- the base is the clamped range, not the requested one.
# ================================================================
test_group("phaser sweep range");
var sw_a = effects_phaser_new(4, C0_5, f64_from(200), f64_from(2000), 0, C0_5, cnt_sr);
assert_eq(Phaser_min_freq(sw_a), f64_from(200), "an in-range minimum is kept");
assert_eq(Phaser_max_freq(sw_a), f64_from(2000), "an in-range maximum is kept");
# 8 kHz: Nyquist clamps 3000..6000 down to 3000..4000.
var sw_b = effects_phaser_new(4, C0_5, f64_from(3000), f64_from(6000), 0, C0_5, f64_from(8000));
assert_eq(Phaser_min_freq(sw_b), f64_from(3000), "the minimum stays under Nyquist");
assert_eq(Phaser_max_freq(sw_b), f64_from(4000), "the maximum clamps to Nyquist");

# ================================================================
test_group("phaser: derived setters reach the next sample");
var dpa = effects_phaser_new(4, F64_ONE, f64_from(200), f64_from(2000), F64_HALF, F64_HALF, f64_from(44100));
var dpb = effects_phaser_new(4, F64_ONE, f64_from(200), f64_from(4000), F64_HALF, F64_HALF, f64_from(44100));
Phaser_set_max_freq(dpa, f64_from(4000));
var dpi = 0;
var dpbad = 0;
while (dpi < 200) {
    var dpin = f64_div(f64_from((dpi % 17) - 8), f64_from(16));
    if (effects_phaser_process_sample(dpa, dpin) != effects_phaser_process_sample(dpb, dpin)) { dpbad = dpbad + 1; }
    dpi = dpi + 1;
}
assert_eq(dpbad, 0, "Phaser_set_max_freq");

var rc = assert_summary();
syscall(60, rc);
