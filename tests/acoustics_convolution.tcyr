# acoustics_convolution.tcyr -- parity test for src/acoustics_convolution.cyr.
# Ports the #[test] blocks from rust-old/src/acoustics/convolution.rs
# one-for-one. The serde-roundtrip test is dropped (Cyrius has no serde).
# f32 tolerances are loosened to f64. An extra from_room case exercises the
# goonj cross-crate mapping (the room path the oracle only drives indirectly).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "src/error.cyr"
include "src/dsp_util.cyr"
include "src/acoustics.cyr"
include "src/acoustics_room.cyr"
include "src/acoustics_convolution.cyr"

# --- float literals used by the ported tests (IEEE-754 bit patterns) ---
var CV_0_1  = 0x3fb999999999999a;   # 0.1
var CV_0_2  = 0x3fc999999999999a;   # 0.2
var CV_0_3  = 0x3fd3333333333333;   # 0.3
var CV_0_7  = 0x3fe6666666666666;   # 0.7
var CV_0_01 = 0x3f847ae147ae147b;   # 0.01
var CV_0_25 = 0x3fd0000000000000;   # 0.25
var CV_NEG_0_25 = 0xbfd0000000000000;  # -0.25
var CV_NEG_HALF = 0xbfe0000000000000;  # -0.5
var CV_1E_9 = 0x3e112e0be826d695;   # 1e-9
var CV_SENTINEL = 0xc08f380000000000;  # -999.0 (unwritten-slot marker)
var CV_CANARY = 0x400e000000000000;    # 3.75  (overrun canary)
var CV_2_125 = 0x4001000000000000;  # 2.125

# 1 if |a - b| < tol, else 0.
fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

# 1.5 metres = 1.0 + 0.5 (ear height in the room fixture).
fn ear_height() { return f64_add(F64_ONE, F64_HALF); }

# Build a vec of f64 from four values.
fn vec4(a, b, c, d) {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    return v;
}

alloc_init();

# ================================================================
# from_ir produces output. Simple echo IR: identity + delayed tap.
test_group("from_ir_produces_output");
var fi_ir = vec4(F64_ONE, 0, 0, F64_HALF);
var fi_rev = naad_convolution_from_ir(fi_ir, F64_ONE);
var fi_out = naad_convolution_process_sample(fi_rev, F64_ONE);
assert_eq(naad_is_finite(fi_out), 1, "impulse output should be finite");
assert(f64_gt(f64_abs(fi_out), 0), "should produce output for impulse");
# Process silence, check finite.
var fi_i = 0;
var fi_ok = 1;
while (fi_i < 10) {
    var fi_s = naad_convolution_process_sample(fi_rev, 0);
    if (naad_is_finite(fi_s) == 0) { fi_ok = 0; }
    fi_i = fi_i + 1;
}
assert_eq(fi_ok, 1, "silence tail should be finite");

# ================================================================
# mix = 0 passes the dry signal through.
test_group("dry_passthrough");
var dp_ir = vec_new();
vec_push(dp_ir, F64_HALF);
vec_push(dp_ir, CV_0_3);
vec_push(dp_ir, CV_0_1);
var dp_rev = naad_convolution_from_ir(dp_ir, 0);
var dp_out = naad_convolution_process_sample(dp_rev, CV_0_7);
assert(approx(dp_out, CV_0_7, CV_0_01), "mix=0 should pass dry signal");

# ================================================================
# FFT block processing. Delay IR: identity at tap 0, echo at tap 3.
test_group("fft_block_processing");
var fb_ir = vec4(F64_ONE, 0, 0, F64_HALF);
var fb_rev = naad_convolution_from_ir(fb_ir, F64_ONE);
var fb_in = vec_new();
var fb_out = vec_new();
var fb_k = 0;
while (fb_k < 8) {
    var fb_v = 0;
    if (fb_k == 0) { fb_v = F64_ONE; }
    vec_push(fb_in, fb_v);
    vec_push(fb_out, 0);
    fb_k = fb_k + 1;
}
naad_convolution_process_block(fb_rev, fb_in, fb_out);
# output[0] ~ 1.0 (identity), output[3] ~ 0.5 (echo).
assert(f64_gt(f64_abs(vec_get(fb_out, 0)), F64_HALF), "identity tap > 0.5");
assert(f64_gt(f64_abs(vec_get(fb_out, 3)), CV_0_2), "echo tap > 0.2");
var fb_fin = 1;
var fb_j = 0;
while (fb_j < 8) {
    if (naad_is_finite(vec_get(fb_out, fb_j)) == 0) { fb_fin = 0; }
    fb_j = fb_j + 1;
}
assert_eq(fb_fin, 1, "all block outputs finite");

# ================================================================
# from_room maps the goonj cross-crate path (added coverage). 8x6x3 concrete
# shoebox, source [2, 1.5, 3], listener [6, 1.5, 3] at 48 kHz.
test_group("from_room_creates_loaded_reverb");
var fr_source = hvec3_new(F64_TWO, ear_height(), f64_from(3));
var fr_listener = hvec3_new(f64_from(6), ear_height(), f64_from(3));
var fr_cfg = naad_room_reverb_config_new(f64_from(8), f64_from(6), f64_from(3),
  "concrete", fr_source, fr_listener, 48000);
var fr_rev = naad_convolution_from_room(fr_cfg);
assert_eq(naad_is_err(fr_rev), 0, "from_room should succeed for a valid config");
assert_eq(naad_convolution_is_loaded(fr_rev), 1, "generated IR should be loaded");
assert(f64_gt(f64_from(naad_convolution_ir_len(fr_rev)), 0), "IR should be non-empty");
var fr_out = naad_convolution_process_sample(fr_rev, F64_ONE);
assert_eq(naad_is_finite(fr_out), 1, "room-convolved output should be finite");

# ================================================================
# from_room rejects bad material and non-positive dimensions.
test_group("from_room_rejects_invalid");
var bm_cfg = naad_room_reverb_config_new(f64_from(8), f64_from(6), f64_from(3),
  "unobtanium", hvec3_new(F64_TWO, ear_height(), f64_from(3)),
  hvec3_new(f64_from(6), ear_height(), f64_from(3)), 48000);
assert_eq(naad_is_err(naad_convolution_from_room(bm_cfg)), 1, "unknown material -> error");
var bd_cfg = naad_room_reverb_config_new(f64_neg(F64_ONE), f64_from(6), f64_from(3),
  "concrete", hvec3_new(F64_TWO, ear_height(), f64_from(3)),
  hvec3_new(f64_from(6), ear_height(), f64_from(3)), 48000);
assert_eq(naad_is_err(naad_convolution_from_room(bd_cfg)), 1, "negative dimension -> error");

# ================================================================
# rebuild_from_ir restores a fresh IR + buffer state.
test_group("rebuild_from_ir");
var rb_rev = naad_convolution_from_ir(vec_new(), F64_HALF);
assert_eq(naad_convolution_is_loaded(rb_rev), 0, "empty IR -> not loaded");
naad_convolution_rebuild_from_ir(rb_rev, vec4(F64_ONE, 0, 0, F64_HALF));
assert_eq(naad_convolution_is_loaded(rb_rev), 1, "rebuilt IR -> loaded");
assert_eq(naad_convolution_ir_len(rb_rev), 4, "rebuilt IR length is 4");
var rb_out = naad_convolution_process_sample(rb_rev, F64_ONE);
assert_eq(naad_is_finite(rb_out), 1, "rebuilt reverb output finite");

# ================================================================
# naad_convolution_next_pow2 is pure integer math -- assert exact values,
# including every boundary. Ports usize::next_power_of_two, for which
# next_power_of_two(0) == 1 and next_power_of_two(n) == n when n is already a
# power of two (the "already a power of two" case is the one an off-by-one
# `p <= v` loop would silently double).
# ================================================================
test_group("next_pow2_exact_values");
assert_eq(naad_convolution_next_pow2(0), 1, "next_pow2(0) == 1");
assert_eq(naad_convolution_next_pow2(1), 1, "next_pow2(1) == 1");
assert_eq(naad_convolution_next_pow2(2), 2, "next_pow2(2) == 2");
assert_eq(naad_convolution_next_pow2(3), 4, "next_pow2(3) == 4");
assert_eq(naad_convolution_next_pow2(4), 4, "next_pow2(4) == 4");
assert_eq(naad_convolution_next_pow2(5), 8, "next_pow2(5) == 8");
assert_eq(naad_convolution_next_pow2(7), 8, "next_pow2(7) == 8");
assert_eq(naad_convolution_next_pow2(8), 8, "next_pow2(8) == 8");
assert_eq(naad_convolution_next_pow2(9), 16, "next_pow2(9) == 16");
assert_eq(naad_convolution_next_pow2(1023), 1024, "next_pow2(1023) == 1024");
assert_eq(naad_convolution_next_pow2(1024), 1024, "next_pow2(1024) == 1024");
assert_eq(naad_convolution_next_pow2(1025), 2048, "next_pow2(1025) == 2048");
# Negative / non-positive spans also collapse to 1 (the loop never runs).
assert_eq(naad_convolution_next_pow2(0 - 3), 1, "next_pow2(-3) == 1");

# ================================================================
# naad_convolution_passthrough copies min(len(input), len(output)) samples and
# touches nothing else. Sentinel-filled outputs make an unwritten slot visible;
# a canary vec allocated after the output catches an overrun.
# ================================================================
test_group("passthrough_copies_min_len");
var pt_in = vec_new();
vec_push(pt_in, F64_ONE);
vec_push(pt_in, CV_NEG_HALF);
vec_push(pt_in, 0);
vec_push(pt_in, CV_0_25);
vec_push(pt_in, F64_TWO);

# Equal lengths: an exact, bit-for-bit copy.
var pt_out = vec_new();
var pt_i = 0;
while (pt_i < 5) { vec_push(pt_out, CV_SENTINEL); pt_i = pt_i + 1; }
assert_eq(naad_convolution_passthrough(pt_in, pt_out), 0, "passthrough returns 0");
assert_eq(vec_get(pt_out, 0), F64_ONE, "passthrough[0]");
assert_eq(vec_get(pt_out, 1), CV_NEG_HALF, "passthrough[1]");
assert_eq(vec_get(pt_out, 2), 0, "passthrough[2]");
assert_eq(vec_get(pt_out, 3), CV_0_25, "passthrough[3]");
assert_eq(vec_get(pt_out, 4), F64_TWO, "passthrough[4]");

# Output SHORTER than the input: only its own slots are filled, no resize.
var pt_short = vec_new();
vec_push(pt_short, CV_SENTINEL);
vec_push(pt_short, CV_SENTINEL);
var pt_canary = vec_new();
vec_push(pt_canary, CV_CANARY);
naad_convolution_passthrough(pt_in, pt_short);
assert_eq(vec_len(pt_short), 2, "short output is not resized");
assert_eq(vec_get(pt_short, 0), F64_ONE, "short passthrough[0]");
assert_eq(vec_get(pt_short, 1), CV_NEG_HALF, "short passthrough[1]");
assert_eq(vec_get(pt_canary, 0), CV_CANARY, "no overrun past a short output");

# Output LONGER than the input: the tail past the input keeps its sentinel.
var pt_long = vec_new();
pt_i = 0;
while (pt_i < 8) { vec_push(pt_long, CV_SENTINEL); pt_i = pt_i + 1; }
naad_convolution_passthrough(pt_in, pt_long);
assert_eq(vec_len(pt_long), 8, "long output is not resized");
assert_eq(vec_get(pt_long, 4), F64_TWO, "long passthrough[4] written");
assert_eq(vec_get(pt_long, 5), CV_SENTINEL, "long passthrough[5] untouched");
assert_eq(vec_get(pt_long, 7), CV_SENTINEL, "long passthrough[7] untouched");

# Empty input writes nothing.
var pt_empty = vec_new();
vec_push(pt_empty, CV_SENTINEL);
naad_convolution_passthrough(vec_new(), pt_empty);
assert_eq(vec_get(pt_empty, 0), CV_SENTINEL, "empty input copies nothing");

# ================================================================
# naad_convolution_process_block_direct is the fallback the FFT route drops to
# when num_fft/num_ifft (or the scratch allocation) fails. The only thing that
# proves the fallback correct is that it agrees with the FFT route, so drive
# two freshly built reverbs -- identical IR, identical mix, both at position 0 --
# down the two paths over the same block and compare.
#
# For a 4-tap IR and an 8-sample block from a fresh ring buffer, the direct
# path's circular buffer and the FFT path's zero-padded linear convolution give
# the same answer, so they must agree to FFT round-off. 1e-9 is far tighter
# than the 0.5 / 0.2 magnitude bounds the oracle's block test settles for.
# ================================================================
test_group("process_block_direct_matches_fft_path");
var pd_ir_a = vec4(F64_ONE, 0, 0, F64_HALF);
var pd_ir_b = vec4(F64_ONE, 0, 0, F64_HALF);
var pd_fft_rev = naad_convolution_from_ir(pd_ir_a, F64_ONE);
var pd_dir_rev = naad_convolution_from_ir(pd_ir_b, F64_ONE);
var pd_in = vec_new();
var pd_fft_out = vec_new();
var pd_dir_out = vec_new();
var pd_k = 0;
while (pd_k < 8) {
    var pd_v = 0;
    if (pd_k == 0) { pd_v = F64_ONE; }
    if (pd_k == 1) { pd_v = CV_0_25; }
    if (pd_k == 2) { pd_v = CV_NEG_HALF; }
    if (pd_k == 4) { pd_v = F64_TWO; }
    vec_push(pd_in, pd_v);
    vec_push(pd_fft_out, CV_SENTINEL);
    vec_push(pd_dir_out, CV_SENTINEL);
    pd_k = pd_k + 1;
}
naad_convolution_process_block(pd_fft_rev, pd_in, pd_fft_out);
assert_eq(naad_convolution_process_block_direct(pd_dir_rev, pd_in, pd_dir_out), 0,
  "process_block_direct returns 0");

var pd_agree = 1;
var pd_written = 1;
pd_k = 0;
while (pd_k < 8) {
    if (approx(vec_get(pd_dir_out, pd_k), vec_get(pd_fft_out, pd_k), CV_1E_9) == 0) { pd_agree = 0; }
    if (vec_get(pd_dir_out, pd_k) == CV_SENTINEL) { pd_written = 0; }
    pd_k = pd_k + 1;
}
assert_eq(pd_written, 1, "process_block_direct wrote every output slot");
assert_eq(pd_agree, 1, "direct fallback == FFT path within 1e-9");

# Independent check of the direct path's own arithmetic, not just agreement.
# The IR [1, 0, 0, 0.5] means y[n] = x[n] + 0.5 * x[n-3]; mix = 1.0 (fully wet).
# x = [1, 0.25, -0.5, 0, 2, 0, 0, 0]  ->  y = [1, 0.25, -0.5, 0.5, 2.125, -0.25, 0, 1].
assert(approx(vec_get(pd_dir_out, 0), F64_ONE, CV_1E_9), "direct[0] == 1.0");
assert(approx(vec_get(pd_dir_out, 1), CV_0_25, CV_1E_9), "direct[1] == 0.25");
assert(approx(vec_get(pd_dir_out, 2), CV_NEG_HALF, CV_1E_9), "direct[2] == -0.5");
assert(approx(vec_get(pd_dir_out, 3), F64_HALF, CV_1E_9), "direct[3] == 0.5 (echo of x[0])");
assert(approx(vec_get(pd_dir_out, 4), CV_2_125, CV_1E_9), "direct[4] == 2.125 (x[4] + echo of x[1])");
assert(approx(vec_get(pd_dir_out, 5), CV_NEG_0_25, CV_1E_9), "direct[5] == -0.25 (echo of x[2])");
assert(approx(vec_get(pd_dir_out, 6), 0, CV_1E_9), "direct[6] == 0.0");
assert(approx(vec_get(pd_dir_out, 7), F64_ONE, CV_1E_9), "direct[7] == 1.0 (echo of x[4])");

# ================================================================
# process_block_direct with mismatched output lengths: min(len) samples, no
# resize, no overrun. It also advances the ring buffer exactly once per sample
# WRITTEN, so a short output consumes only that many inputs -- checked by
# feeding the remaining input to a second, equally short call.
# ================================================================
test_group("process_block_direct_mismatched_lengths");
var pm_rev = naad_convolution_from_ir(vec4(F64_ONE, 0, 0, F64_HALF), F64_ONE);
var pm_short = vec_new();
vec_push(pm_short, CV_SENTINEL);
vec_push(pm_short, CV_SENTINEL);
var pm_canary = vec_new();
vec_push(pm_canary, CV_CANARY);
naad_convolution_process_block_direct(pm_rev, pd_in, pm_short);
assert_eq(vec_len(pm_short), 2, "short output is not resized");
assert(approx(vec_get(pm_short, 0), F64_ONE, CV_1E_9), "short direct[0] == 1.0");
assert(approx(vec_get(pm_short, 1), CV_0_25, CV_1E_9), "short direct[1] == 0.25");
assert_eq(vec_get(pm_canary, 0), CV_CANARY, "no overrun past a short output");

var pm_long = vec_new();
var pm_i = 0;
while (pm_i < 8) { vec_push(pm_long, CV_SENTINEL); pm_i = pm_i + 1; }
var pm_two = vec_new();
vec_push(pm_two, CV_NEG_HALF);
vec_push(pm_two, 0);
naad_convolution_process_block_direct(pm_rev, pm_two, pm_long);
assert_eq(vec_len(pm_long), 8, "long output is not resized");
# Only 2 samples of input -> only slots 0 and 1 are written.
assert_eq(vec_get(pm_long, 2), CV_SENTINEL, "long direct[2] untouched past input end");
assert_eq(vec_get(pm_long, 7), CV_SENTINEL, "long direct[7] untouched past input end");
# Continuing the SAME reverb: this is x[2] and x[3] of the stream above, so the
# outputs must match what the single 8-sample direct run produced there.
assert(approx(vec_get(pm_long, 0), vec_get(pd_dir_out, 2), CV_1E_9),
  "short call consumed exactly 2 inputs (continuity at x[2])");
assert(approx(vec_get(pm_long, 1), vec_get(pd_dir_out, 3), CV_1E_9),
  "short call consumed exactly 2 inputs (continuity at x[3])");

# An empty IR makes process_block_direct a pure passthrough (process_sample
# returns its input unchanged), matching what process_block's dry copy does.
var pe_rev = naad_convolution_from_ir(vec_new(), F64_ONE);
var pe_out = vec_new();
pm_i = 0;
while (pm_i < 8) { vec_push(pe_out, CV_SENTINEL); pm_i = pm_i + 1; }
naad_convolution_process_block_direct(pe_rev, pd_in, pe_out);
var pe_ok = 1;
pm_i = 0;
while (pm_i < 8) {
    if (vec_get(pe_out, pm_i) != vec_get(pd_in, pm_i)) { pe_ok = 0; }
    pm_i = pm_i + 1;
}
assert_eq(pe_ok, 1, "empty IR -> direct fallback passes the block through");

# ================================================================
# STREAMING CONTINUITY. The suite already had process_block_direct_matches_fft_path,
# but it runs ONE block on a fresh object -- and one block is exactly the case
# where the old truncating implementation was correct, because there is no
# earlier tail to carry. The defect only becomes observable from the SECOND
# block. Every assertion here therefore spans at least two calls.
# ================================================================
test_group("process_block is continuous across block boundaries");

# 4-tap all-ones IR, one impulse, fully wet: the correct answer is 1,1,1,1.
# Before the overlap-save fix the block path returned 1,1,0,0 -- the ring was
# truncated at the boundary.
var tl_s = naad_convolution_from_ir(vec4(F64_ONE, F64_ONE, F64_ONE, F64_ONE), F64_ONE);
var tl_s0 = naad_convolution_process_sample(tl_s, F64_ONE);
var tl_s1 = naad_convolution_process_sample(tl_s, 0);
var tl_s2 = naad_convolution_process_sample(tl_s, 0);
var tl_s3 = naad_convolution_process_sample(tl_s, 0);
assert(approx(tl_s0, F64_ONE, CV_1E_9), "reference sample path y[0] == 1");
assert(approx(tl_s1, F64_ONE, CV_1E_9), "reference sample path y[1] == 1");
assert(approx(tl_s2, F64_ONE, CV_1E_9), "reference sample path y[2] == 1");
assert(approx(tl_s3, F64_ONE, CV_1E_9), "reference sample path y[3] == 1");

var tl_b = naad_convolution_from_ir(vec4(F64_ONE, F64_ONE, F64_ONE, F64_ONE), F64_ONE);
var tl_in1 = vec_new(); vec_push(tl_in1, F64_ONE); vec_push(tl_in1, 0);
var tl_o1 = vec_new(); vec_push(tl_o1, CV_SENTINEL); vec_push(tl_o1, CV_SENTINEL);
naad_convolution_process_block(tl_b, tl_in1, tl_o1);
var tl_in2 = vec_new(); vec_push(tl_in2, 0); vec_push(tl_in2, 0);
var tl_o2 = vec_new(); vec_push(tl_o2, CV_SENTINEL); vec_push(tl_o2, CV_SENTINEL);
naad_convolution_process_block(tl_b, tl_in2, tl_o2);
assert(approx(vec_get(tl_o1, 0), F64_ONE, CV_1E_9), "block path y[0] == 1");
assert(approx(vec_get(tl_o1, 1), F64_ONE, CV_1E_9), "block path y[1] == 1");
assert(approx(vec_get(tl_o2, 0), F64_ONE, CV_1E_9), "block path y[2] == 1 -- tail carried across the boundary");
assert(approx(vec_get(tl_o2, 1), F64_ONE, CV_1E_9), "block path y[3] == 1 -- tail carried across the boundary");

# The general property, over a longer signal and an asymmetric IR: chunked
# process_block must agree with the per-sample path sample for sample.
var tl_ir_a = vec4(F64_ONE, F64_HALF, CV_NEG_HALF, CV_0_25);
var tl_ir_b2 = vec4(F64_ONE, F64_HALF, CV_NEG_HALF, CV_0_25);
var tl_ref = naad_convolution_from_ir(tl_ir_a, F64_ONE);
var tl_chunk = naad_convolution_from_ir(tl_ir_b2, F64_ONE);
var tl_sig = vec_new();
var tl_k = 0;
while (tl_k < 24) {
    var tl_v = 0;
    if (tl_k == 0) { tl_v = F64_ONE; }
    if (tl_k == 3) { tl_v = CV_0_25; }
    if (tl_k == 7) { tl_v = CV_NEG_HALF; }
    if (tl_k == 11) { tl_v = F64_TWO; }
    if (tl_k == 18) { tl_v = F64_ONE; }
    vec_push(tl_sig, tl_v);
    tl_k = tl_k + 1;
}
# reference: one sample at a time
var tl_expect = vec_new();
tl_k = 0;
while (tl_k < 24) {
    vec_push(tl_expect, naad_convolution_process_sample(tl_ref, vec_get(tl_sig, tl_k)));
    tl_k = tl_k + 1;
}
# subject: six blocks of four
var tl_got = vec_new();
tl_k = 0;
while (tl_k < 24) { vec_push(tl_got, CV_SENTINEL); tl_k = tl_k + 1; }
var tl_off = 0;
while (tl_off < 24) {
    var tl_cin = vec_new();
    var tl_cout = vec_new();
    var tl_c = 0;
    while (tl_c < 4) {
        vec_push(tl_cin, vec_get(tl_sig, tl_off + tl_c));
        vec_push(tl_cout, CV_SENTINEL);
        tl_c = tl_c + 1;
    }
    naad_convolution_process_block(tl_chunk, tl_cin, tl_cout);
    tl_c = 0;
    while (tl_c < 4) { vec_set(tl_got, tl_off + tl_c, vec_get(tl_cout, tl_c)); tl_c = tl_c + 1; }
    tl_off = tl_off + 4;
}
var tl_agree = 1;
var tl_written = 1;
var tl_energy = 0;
tl_k = 0;
while (tl_k < 24) {
    if (approx(vec_get(tl_got, tl_k), vec_get(tl_expect, tl_k), CV_1E_9) == 0) { tl_agree = 0; }
    if (vec_get(tl_got, tl_k) == CV_SENTINEL) { tl_written = 0; }
    tl_energy = f64_add(tl_energy, f64_abs(vec_get(tl_expect, tl_k)));
    tl_k = tl_k + 1;
}
assert_eq(tl_written, 1, "chunked run wrote every output slot");
assert(f64_gt(tl_energy, F64_ONE), "the reference signal is non-trivial (not a vacuous compare)");
assert_eq(tl_agree, 1, "6 blocks of 4 == 24 single samples, sample for sample");

# Interleaving the two entry points is now coherent: they share one history ring.
var tl_mix1 = naad_convolution_from_ir(vec4(F64_ONE, F64_HALF, CV_NEG_HALF, CV_0_25), F64_ONE);
var tl_mix2 = naad_convolution_from_ir(vec4(F64_ONE, F64_HALF, CV_NEG_HALF, CV_0_25), F64_ONE);
# path 1: two samples, then a block of two
var tl_m1a = naad_convolution_process_sample(tl_mix1, F64_ONE);
var tl_m1b = naad_convolution_process_sample(tl_mix1, CV_0_25);
var tl_mi = vec_new(); vec_push(tl_mi, CV_NEG_HALF); vec_push(tl_mi, F64_TWO);
var tl_mo = vec_new(); vec_push(tl_mo, CV_SENTINEL); vec_push(tl_mo, CV_SENTINEL);
naad_convolution_process_block(tl_mix1, tl_mi, tl_mo);
# path 2: the same four samples, one at a time
var tl_m2a = naad_convolution_process_sample(tl_mix2, F64_ONE);
var tl_m2b = naad_convolution_process_sample(tl_mix2, CV_0_25);
var tl_m2c = naad_convolution_process_sample(tl_mix2, CV_NEG_HALF);
var tl_m2d = naad_convolution_process_sample(tl_mix2, F64_TWO);
assert(approx(tl_m1a, tl_m2a, CV_1E_9), "interleaved: sample 0 agrees");
assert(approx(tl_m1b, tl_m2b, CV_1E_9), "interleaved: sample 1 agrees");
assert(approx(vec_get(tl_mo, 0), tl_m2c, CV_1E_9), "interleaved: block sample 2 agrees with the sample path");
assert(approx(vec_get(tl_mo, 1), tl_m2d, CV_1E_9), "interleaved: block sample 3 agrees with the sample path");

var rc = assert_summary();
syscall(60, rc);
