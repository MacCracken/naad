# hotpath.bcyr -- per-sample hot-path benchmarks for naad.
# Run: cyrius bench tests/hotpath.bcyr
# Covers the inner-loop functions dhvani/svara call per audio sample, the costliest
# paths the 2.3.2 sweep measured against the Rust oracle, and the block forms 2.3.3
# made real loops. A block row is per call: divide by 256 for ns/sample.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "dist/naad.cyr"

# bench — helper used by hotpath.bcyr.
fn bench(name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    bench_report(b);
    return 0;
}

# Fixtures (built in main).
var _osc = 0;
var _svf = 0;
var _env = 0;
var _noise = 0;
var _half = 0;
var _moog = 0;
var _reverb = 0;
var _reverb_out = 0;
var _sub = 0;
var _additive = 0;
var _biquad = 0;
var _unison = 0;
var _vocoder = 0;
var _source = 0;
var _block = 0;
var _left = 0;
var _right = 0;

# Refill the block from the source, for the forms that write their own input.
fn block_refill() {
    var i = 0;
    while (i < 256) {
        vec_set(_block, i, vec_get(_source, i));
        i = i + 1;
    }
    return 0;
}

# b osc next sample — helper used by hotpath.bcyr.
fn b_osc_next_sample() {
    return osc_next_sample(_osc);
}

# b svf lowpass — helper used by hotpath.bcyr.
fn b_svf_lowpass() {
    return filter_svf_process_sample_lowpass(_svf, _half);
}

# b env next value — helper used by hotpath.bcyr.
fn b_env_next_value() {
    return envelope_adsr_next_value(_env);
}

# b noise pink — helper used by hotpath.bcyr.
fn b_noise_pink() {
    return noise_next_sample(_noise);
}

# b moog — helper used by hotpath.bcyr.
fn b_moog() {
    return physical_moog_process_sample(_moog, _half);
}

# b reverb — helper used by hotpath.bcyr.
fn b_reverb() {
    return reverb_process_core(_reverb, _half, _reverb_out);
}

# b subtractive — helper used by hotpath.bcyr.
fn b_subtractive() {
    return subtractive_next_sample(_sub);
}

# b additive — helper used by hotpath.bcyr.
fn b_additive() {
    return additive_next_sample(_additive);
}

# b biquad — helper used by hotpath.bcyr.
fn b_biquad() {
    return filter_biquad_process_sample(_biquad, _half);
}

# b unison — helper used by hotpath.bcyr.
fn b_unison() {
    return unison_next_sample(_unison);
}

# b block biquad — helper used by hotpath.bcyr.
fn b_block_biquad() {
    block_refill();
    return filter_biquad_process_buffer(_biquad, _block);
}

# b block reverb — helper used by hotpath.bcyr.
fn b_block_reverb() {
    return reverb_process_buffer(_reverb, _source, _left, _right);
}

# b block vocoder — helper used by hotpath.bcyr.
fn b_block_vocoder() {
    return vocoder_process_buffer(_vocoder, _source, _source, _left);
}

# b block additive — helper used by hotpath.bcyr.
fn b_block_additive() {
    return additive_fill_buffer(_additive, _block);
}

# b block unison — helper used by hotpath.bcyr.
fn b_block_unison() {
    return unison_fill_buffer(_unison, _block);
}

# b block osc — helper used by hotpath.bcyr.
fn b_block_osc() {
    return osc_fill_buffer(_osc, _block);
}

# Bench entry point — runs every benchmark in this file.
fn main() {
    alloc_init();
    _half = F64_HALF;

    _osc = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
    _svf = filter_svf_new(f64_from(2000), F64_HALF, f64_from(44100));
    _env = envelope_adsr_with_sample_rate(F64_HALF, F64_HALF, F64_HALF, F64_HALF, f64_from(44100));
    envelope_adsr_gate_on(_env);
    _noise = noise_new(NOISE_PINK, 42);

    _moog = physical_moog_new(f64_from(900), F64_HALF, f64_from(44100));
    _reverb = reverb_new(F64_HALF, F64_HALF, f64_from(10), F64_HALF, f64_from(44100));
    _reverb_out = alloc(sizeof(ReverbStereo));
    _sub = subtractive_new(WAVEFORM_SAW, f64_from(220), f64_from(1200), F64_HALF, f64_from(44100));
    subtractive_note_on(_sub);
    _additive = additive_new(f64_from(220), 8, f64_from(44100));
    _biquad = filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(44100), f64_from(1000), F64_ONE);
    _unison = unison_new(WAVEFORM_SAW, f64_from(220), 5, f64_from(12), f64_from(44100));
    _vocoder = vocoder_new(16, f64_from(200), f64_from(8000), f64_from(44100));
    _block = naad_vec_zeros(256);
    _left = naad_vec_zeros(256);
    _right = naad_vec_zeros(256);
    _source = naad_vec_zeros(256);
    noise_fill_buffer(noise_new(NOISE_WHITE, 42), _source);

    bench("osc_next_sample (sine)", &b_osc_next_sample, 200000);
    bench("filter_svf lowpass", &b_svf_lowpass, 200000);
    bench("envelope_adsr next_value", &b_env_next_value, 200000);
    bench("noise pink (Voss-McCartney)", &b_noise_pink, 200000);
    bench("filter_biquad lowpass", &b_biquad, 200000);
    bench("unison (5 voices)", &b_unison, 100000);
    bench("subtractive voice", &b_subtractive, 100000);
    bench("additive (8 partials)", &b_additive, 100000);
    bench("reverb", &b_reverb, 100000);
    bench("moog ladder", &b_moog, 50000);
    bench("biquad block (256)", &b_block_biquad, 20000);
    bench("osc block (256, sine)", &b_block_osc, 10000);
    bench("unison block (256, 5 voices)", &b_block_unison, 2000);
    bench("additive block (256, 8 partials)", &b_block_additive, 2000);
    bench("reverb block (256)", &b_block_reverb, 2000);
    bench("vocoder block (256, 16 bands)", &b_block_vocoder, 2000);

    return 0;
}

var r = main();
syscall(60, r);
