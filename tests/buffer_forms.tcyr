pc_a = bf_make(K_FORMANT);
pc_b = bf_make(K_FORMANT);
vec_set(FormantSynth_filters(pc_a), 2, vec_get(FormantSynth_filters(pc_a), 0));
vec_set(FormantSynth_filters(pc_b), 2, vec_get(FormantSynth_filters(pc_b), 0));
