assert_eq(bf_fill_a_b(K_FORMANT, pc_a, pc_b, 300), 0, "side by side");

# Put one filter in two places, in one of the ways the accessors allow.
fn bf_vocoder_wire(v, how) {
    var bands = Vocoder_bands(v);
    var one = vec_get(bands, 1);
    if (how == 0) { VocoderBand_set_synthesis_filter(one, VocoderBand_analysis_filter(one)); }
    if (how == 1) { vec_set(bands, 6, one); }
    if (how == 2) { VocoderBand_set_analysis_filter(vec_get(bands, 6), VocoderBand_analysis_filter(one)); }
    if (how == 3) { VocoderBand_set_synthesis_filter(vec_get(bands, 6), VocoderBand_analysis_filter(one)); }
    if (how == 4) { VocoderBand_set_synthesis_filter(vec_get(bands, 6), VocoderBand_synthesis_filter(one)); }
    if (how == 5) { VocoderBand_set_analysis_filter(vec_get(bands, 6), VocoderBand_synthesis_filter(one)); }
    if (how == 6) { VocoderBand_set_analysis_filter(vec_get(bands, 2), VocoderBand_analysis_filter(one)); }
    return 0;
}

# Per-sample against block on a vocoder wired by bf_vocoder_wire.
fn bf_vocoder_shared(how) {
    var a = bf_vocoder_new();
    var b = bf_vocoder_new();
    bf_vocoder_wire(a, how);
    bf_vocoder_wire(b, how);
    var mo = bf_filled(300, 0);
    var car = bf_filled(300, 9000);
    var want = naad_vec_zeros(300);
    var got = naad_vec_zeros(300);
    bf_vocoder_by_hand(a, mo, car, want, 300);
    vocoder_process_buffer(b, mo, car, got);
    return bf_diff(want, got) + bf_vocoder_same_after(a, b);
}

test_group("vocoder: one object in two slots");
assert_eq(bf_vocoder_shared(0), 0, "a band's analysis and synthesis are one filter");
assert_eq(bf_vocoder_shared(1), 0, "one band in two slots");
assert_eq(bf_vocoder_shared(2), 0, "two bands, one analysis filter");
assert_eq(bf_vocoder_shared(3), 0, "one band's analysis is another's synthesis");
assert_eq(bf_vocoder_shared(4), 0, "two bands, one synthesis filter");
assert_eq(bf_vocoder_shared(5), 0, "one band's synthesis is another's analysis");
assert_eq(bf_vocoder_shared(6), 0, "two bands side by side, one analysis filter");

# Comb `i` of `side`, 0 for left.
fn bf_comb(r, side, i) {
    if (side == 0) { return vec_get(Reverb_combs_l(r), i); }
    return vec_get(Reverb_combs_r(r), i);
}

# Allpass `i` of `side`, 0 for left.
fn bf_allpass(r, side, i) {
    if (side == 0) { return vec_get(Reverb_allpasses_l(r), i); }
    return vec_get(Reverb_allpasses_r(r), i);
}

# Point `dl` at memory from `over`, `skip` samples in, as a ring of its own.
fn bf_ring_over(dl, over, skip) {
    var view = vec_new();
    var data = load64(DelayLine_buffer(over));
    store64(view, data + skip * 8);
    store64(view + 8, vec_len(DelayLine_buffer(over)) - skip);
    store64(view + 16, vec_len(DelayLine_buffer(over)) - skip);
    DelayLine_set_buffer(dl, view);
    DelayLine_set_max_delay_samples(dl, vec_len(view));
    DelayLine_set_write_pos(dl, 0);
    return 0;
}

# Make two stages reach one memory, in one of the ways the accessors allow.
fn bf_reverb_wire(r, how) {
    var c0 = bf_comb(r, 0, 0);
    var c1 = bf_comb(r, 0, 1);
    var cr = bf_comb(r, 1, 3);
    var a0 = bf_allpass(r, 0, 0);
    var ar = bf_allpass(r, 1, 1);
    var tap = f64_from(900);
    if (how == 0) { Reverb_set_combs_r(r, Reverb_combs_l(r)); }
    if (how == 1) { vec_set(Reverb_combs_l(r), 1, c0); }
    if (how == 2) { DampedComb_set_delay(c1, DampedComb_delay(c0)); }
    if (how == 3) { Reverb_set_allpasses_r(r, Reverb_allpasses_l(r)); }
    if (how == 4) { vec_set(Reverb_allpasses_l(r), 1, a0); }
    if (how == 5) { ReverbAllpass_set_delay(a0, DampedComb_delay(c0)); }
    if (how == 6) { DampedComb_set_delay(c0, Reverb_pre_delay(r)); }
    if (how == 7) { ReverbAllpass_set_delay(ar, Reverb_pre_delay(r)); }
    if (how == 8) { DampedComb_set_delay(cr, DampedComb_delay(c0)); }
    if (how == 9) { ReverbAllpass_set_delay(ar, ReverbAllpass_delay(a0)); }
    if (how == 10 || how == 11) {
        # Two rings over one vec, or over a part of it: no pointer here is equal.
        bf_ring_over(DampedComb_delay(c1), DampedComb_delay(c0), (how - 10) * 37);
        DampedComb_set_delay_samples(c0, tap);
        DampedComb_set_delay_samples(c1, tap);
    }
    return 0;
}

# Per-sample against block on a reverb wired by bf_reverb_wire.
fn bf_reverb_shared(how) {
    var a = bf_reverb_new();
    var b = bf_reverb_new();
    bf_reverb_wire(a, how);
    bf_reverb_wire(b, how);
    var n = 2000;
    var input = bf_filled(n, 0);
    var want_l = naad_vec_zeros(n);
    var want_r = naad_vec_zeros(n);
    var got_l = naad_vec_zeros(n);
    var got_r = naad_vec_zeros(n);
    bf_reverb_by_hand(a, input, want_l, want_r, n);
    reverb_process_buffer(b, input, got_l, got_r);
    var diff = bf_diff(want_l, got_l) + bf_diff(want_r, got_r);
    var ra = alloc(sizeof(ReverbStereo));
    var rb = alloc(sizeof(ReverbStereo));
    var t = 0;
    while (t < 64) {
        var y = bf_unit(t);
        reverb_process_core(a, y, ra);
        reverb_process_core(b, y, rb);
        if (ReverbStereo_left(ra) != ReverbStereo_left(rb)) { diff = diff + 1; }
        if (ReverbStereo_right(ra) != ReverbStereo_right(rb)) { diff = diff + 1; }
        t = t + 1;
    }
    return diff;
}

test_group("reverb: one object in two slots");
assert_eq(bf_reverb_shared(0), 0, "the right combs are the left combs");
assert_eq(bf_reverb_shared(1), 0, "one comb in two slots");
assert_eq(bf_reverb_shared(2), 0, "two combs on one ring");
assert_eq(bf_reverb_shared(3), 0, "the right allpasses are the left allpasses");
assert_eq(bf_reverb_shared(4), 0, "one allpass in two slots");
assert_eq(bf_reverb_shared(5), 0, "an allpass on a comb's ring");
assert_eq(bf_reverb_shared(6), 0, "a comb on the pre-delay ring");
assert_eq(bf_reverb_shared(7), 0, "an allpass on the pre-delay ring");
assert_eq(bf_reverb_shared(8), 0, "a left and a right comb on one ring");
assert_eq(bf_reverb_shared(9), 0, "a left and a right allpass on one ring");
assert_eq(bf_reverb_shared(10), 0, "two rings over one vec");
assert_eq(bf_reverb_shared(11), 0, "a ring over part of another");

# ================================================================
# The per-sample loop never looks at the object on an empty block, so neither does a
# form: not the state, and not the fields, here a null object.
# ================================================================
# The other direction: a guard that fired on a healthy object would cost every saving
# and no sample would change, so nothing above would see it.
test_group("a built object takes the block path");
assert_eq(_eq_bands_share(ParametricEq_bands(bf_make(K_EQ))), 0, "eq");
assert_eq(_formant_filters_share(FormantSynth_filters(bf_make(K_FORMANT))), 0, "formant");
assert_eq(_vocoder_bands_share(Vocoder_bands(bf_vocoder_new())), 0, "vocoder");
assert_eq(_reverb_rings_overlap(bf_reverb_new()), 0, "reverb");
assert_eq(_delay_block_ok(CombFilter_delay_line(bf_make(K_COMB))), 1, "comb");
assert_eq(_delay_block_ok(AllpassDelay_delay_line(bf_make(K_ALLPASS))), 1, "allpass");
assert_eq(_delay_block_ok(KarplusStrong_delay_line(bf_make(K_KS))), 1, "karplus-strong");
assert_eq(_delay_block_ok(Waveguide_forward_delay(bf_make(K_WG))), 1, "waveguide");

test_group("an empty block touches nothing");
# The form of `kind` on an empty vec and a null object.
fn bf_empty(kind) {
    var none = vec_new();
    return bf_block(kind, 0, none);
}

var ez_st = 0;
ez_st = bf_empty(K_LOWPASS);
ez_st = bf_empty(K_SVF);
ez_st = bf_empty(K_EQ);
ez_st = bf_empty(K_FORMANT);
ez_st = bf_empty(K_COMB);
ez_st = bf_empty(K_ALLPASS);
ez_st = bf_empty(K_ADDITIVE);
ez_st = bf_empty(K_WAVETABLE);
ez_st = bf_empty(K_KS);
ez_st = bf_empty(K_WG);
ez_st = bf_empty(K_GATE);
ez_st = bf_empty(K_OSC);
ez_st = bf_empty(K_NOISE);
ez_st = bf_empty(K_UNISON);
reverb_process_buffer(0, vec_new(), vec_new(), vec_new());
vocoder_process_buffer(0, vec_new(), vec_new(), vec_new());
assert_eq(ez_st, 0, "every form returned without reading its object");

var ez_un = bf_make(K_UNISON + WAVEFORM_SAW);
ez_st = unison_set_detune_cents(ez_un, f64_from(30));
var ez_dirty = UnisonOscillator_ratios_dirty(ez_un);
unison_fill_buffer(ez_un, vec_new());
assert_eq(UnisonOscillator_ratios_dirty(ez_un), ez_dirty, "unison leaves a pending recompute pending");

test_group("unison with no voices");
pc_a = bf_make(K_UNISON + WAVEFORM_SAW);
pc_b = bf_make(K_UNISON + WAVEFORM_SAW);
UnisonOscillator_set_num_voices(pc_a, 0);
UnisonOscillator_set_num_voices(pc_b, 0);
assert_eq(bf_fill_a_b(K_UNISON + WAVEFORM_SAW, pc_a, pc_b, 20), 0, "NaN, as sum / 0 gives");

# ================================================================
# Preconditions: states the per-sample path refuses. The forms read through raw
# pointers, so each of these has to end in vec.cyr's bounds check, not past the end
# of an allocation. Exit 1 is that check; a form that ran on exits 0. The reverb's
# rings are tried with a write position below the vec: past the far end, its own
# write would run over the next ring's header and die by accident.
# ================================================================
fn bf_ring_past_vec(dl) {
    DelayLine_set_max_delay_samples(dl, vec_len(DelayLine_buffer(dl)) + 1000);
    return 0;
}

# Set up and run case `which`, in a child: each has to end in a bounds check.
fn bf_abort_case(which) {
    var o = 0;
    var kind = K_COMB;
    if (which == 0) {
        o = bf_make(K_COMB);
        bf_ring_past_vec(CombFilter_delay_line(o));
    } elif (which == 1) {
        o = bf_make(K_COMB);
        var dl = CombFilter_delay_line(o);
        DelayLine_set_write_pos(dl, vec_len(DelayLine_buffer(dl)) + 1000);
    } elif (which == 2) {
        o = bf_make(K_COMB);
        DelayLine_set_write_pos(CombFilter_delay_line(o), 0 - 1);
    } elif (which == 3) {
        kind = K_ALLPASS;
        o = bf_make(K_ALLPASS);
        bf_ring_past_vec(AllpassDelay_delay_line(o));
    } elif (which == 4) {
        kind = K_KS;
        o = bf_make(K_KS);
        bf_ring_past_vec(KarplusStrong_delay_line(o));
    } elif (which == 5) {
        # Only one rail is bad, with the two agreeing on length and position.
        kind = K_WG;
        o = bf_make(K_WG);
        var fw = Waveguide_forward_delay(o);
        bf_ring_past_vec(fw);
        var good = delay_line_new(DelayLine_max_delay_samples(fw));
        DelayLine_set_write_pos(good, DelayLine_write_pos(fw));
        Waveguide_set_backward_delay(o, good);
    } elif (which == 11) {
        kind = K_WG;
        o = bf_make(K_WG);
        var bw = Waveguide_backward_delay(o);
        bf_ring_past_vec(bw);
        var good2 = delay_line_new(DelayLine_max_delay_samples(bw));
        DelayLine_set_write_pos(good2, DelayLine_write_pos(bw));
        Waveguide_set_forward_delay(o, good2);
    } elif (which == 6) {
        kind = K_NOISE + NOISE_PINK;
        o = bf_make(kind);
        NoiseGenerator_set_pink_octaves(o, naad_vec_zeros(2));
    } elif (which == 7) {
        kind = K_UNISON + WAVEFORM_SAW;
        o = bf_make(kind);
        UnisonOscillator_set_num_voices(o, 99);
    } elif (which == 8) {
        var r = bf_reverb_new();
        DelayLine_set_write_pos(Reverb_pre_delay(r), 0 - 1);
        return reverb_process_buffer(r, naad_vec_zeros(64), naad_vec_zeros(64), naad_vec_zeros(64));
    } elif (which == 9) {
        var r2 = bf_reverb_new();
        DelayLine_set_write_pos(DampedComb_delay(vec_get(Reverb_combs_r(r2), 3)), 0 - 1);
        return reverb_process_buffer(r2, naad_vec_zeros(64), naad_vec_zeros(64), naad_vec_zeros(64));
    } else {
        var r3 = bf_reverb_new();
        DelayLine_set_write_pos(ReverbAllpass_delay(vec_get(Reverb_allpasses_l(r3), 1)), 0 - 1);
        return reverb_process_buffer(r3, naad_vec_zeros(64), naad_vec_zeros(64), naad_vec_zeros(64));
    }
    return bf_block(kind, o, naad_vec_zeros(64));
}

# Exit code of a child running case `which`, or -1 if a signal ended it.
fn bf_child(which) {
    var pid = sys_fork();
    if (pid == 0) {
        sys_close(2);
        bf_abort_case(which);
        sys_exit(0);
    }
    var status[8];
    store64(&status, 0);
    sys_waitpid(pid, &status, 0);
    var s = load64(&status) & U32_MASK;
    if (WIFEXITED(s) == 0) { return 0 - 1; }
    return WEXITSTATUS(s);
}

test_group("a desynced ring reaches the bounds checks");
assert_eq(bf_child(0), 1, "comb: max past the vec");
assert_eq(bf_child(1), 1, "comb: write position past the vec");
assert_eq(bf_child(2), 1, "comb: negative write position");
assert_eq(bf_child(3), 1, "allpass: max past the vec");
assert_eq(bf_child(4), 1, "karplus-strong: max past the vec");
assert_eq(bf_child(5), 1, "waveguide: forward rail past its vec");
assert_eq(bf_child(11), 1, "waveguide: backward rail past its vec");
assert_eq(bf_child(6), 1, "pink: octave vec too short");
assert_eq(bf_child(7), 1, "unison: more voices than phases");
assert_eq(bf_child(8), 1, "reverb: pre-delay write position below the vec");
assert_eq(bf_child(9), 1, "reverb: comb write position below the vec");
assert_eq(bf_child(10), 1, "reverb: allpass write position below the vec");

var rc = assert_summary();
syscall(60, rc);
