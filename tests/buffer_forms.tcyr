pc_a = bf_make(K_WG);
pc_b = bf_make(K_WG);
DelayLine_set_write_pos(Waveguide_backward_delay(pc_a), 3);
DelayLine_set_write_pos(Waveguide_backward_delay(pc_b), 3);
