test_group("additive with fewer phases than partials");
pc_a = bf_make(K_ADDITIVE);
pc_b = bf_make(K_ADDITIVE);
AdditiveSynth_set_phases(pc_a, naad_vec_zeros(3));
AdditiveSynth_set_phases(pc_b, naad_vec_zeros(3));
assert_eq(bf_fill_a_b(K_ADDITIVE, pc_a, pc_b, 300), 0, "the shorter vec sets the count");

# ================================================================
# One object in two slots, through the accessors. The per-sample path steps it once
# for each slot in sample order, so a form that takes one stage at a time would both
# differ and depend on where the stream is cut. These go the per-sample way.
# ================================================================
test_group("eq: one filter in two bands");
pc_a = bf_make(K_EQ);
pc_b = bf_make(K_EQ);
EqBand_set_enabled(vec_get(ParametricEq_bands(pc_a), 1), 1);
EqBand_set_enabled(vec_get(ParametricEq_bands(pc_b), 1), 1);
EqBand_set_filter(vec_get(ParametricEq_bands(pc_a), 2), EqBand_filter(vec_get(ParametricEq_bands(pc_a), 0)));
EqBand_set_filter(vec_get(ParametricEq_bands(pc_b), 2), EqBand_filter(vec_get(ParametricEq_bands(pc_b), 0)));
assert_eq(bf_fill_a_b(K_EQ, pc_a, pc_b, 300), 0, "two bands, first and last");
pc_a = bf_make(K_EQ);
pc_b = bf_make(K_EQ);
vec_set(ParametricEq_bands(pc_a), 2, vec_get(ParametricEq_bands(pc_a), 0));
vec_set(ParametricEq_bands(pc_b), 2, vec_get(ParametricEq_bands(pc_b), 0));
assert_eq(bf_fill_a_b(K_EQ, pc_a, pc_b, 300), 0, "one band in two slots");
pc_a = bf_make(K_EQ);
pc_b = bf_make(K_EQ);
EqBand_set_enabled(vec_get(ParametricEq_bands(pc_a), 1), 1);
EqBand_set_enabled(vec_get(ParametricEq_bands(pc_b), 1), 1);
EqBand_set_filter(vec_get(ParametricEq_bands(pc_a), 1), EqBand_filter(vec_get(ParametricEq_bands(pc_a), 0)));
EqBand_set_filter(vec_get(ParametricEq_bands(pc_b), 1), EqBand_filter(vec_get(ParametricEq_bands(pc_b), 0)));
assert_eq(bf_fill_a_b(K_EQ, pc_a, pc_b, 300), 0, "two bands side by side");

