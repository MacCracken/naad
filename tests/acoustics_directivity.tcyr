# acoustics_directivity.tcyr -- parity tests for src/acoustics_directivity.cyr.
# Ported one-for-one from the #[test] blocks in
# rust-old/src/acoustics/directivity.rs. The serde round-trip test is dropped
# (no serde in Cyrius). f32 thresholds reused directly (loosened to f64):
# 1e-5 exactness checks and the 1e-4 polar-vs-3D agreement check.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "src/error.cyr"
include "src/acoustics_directivity.cyr"

var TOL_1E5 = 0x3ee4f8b588e368f1;   # 1e-5
var TOL_1E4 = 0x3f1a36e2eb1c432d;   # 1e-4

# |a - b| < tol  ->  1
fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

# degrees -> radians (deg · π / 180).
fn _dir_radians(deg) {
    return f64_div(f64_mul(f64_from(deg), F64_PI), f64_from(180));
}

# 1 if the 3D gain and the polar gain agree within 1e-4 for `kind` @ theta.
# dir = (cos θ, sin θ, 0), front = +x -- axisymmetric so 3D == polar.
fn _dir_polar_ok(kind, theta) {
    var front = hvec3_unit_x();
    var dir = hvec3_new(f64_cos(theta), f64_sin(theta), 0);
    var g3d = naad_directivity_gain(kind, dir, front);
    var gp = naad_directivity_gain_polar(kind, theta);
    return approx(g3d, gp, TOL_1E4);
}

# 1 iff all four non-omni patterns agree (3D vs polar) at `theta`.
fn _dir_all_polar_ok(theta) {
    if (_dir_polar_ok(NAAD_DIR_CARDIOID, theta) == 0) { return 0; }
    if (_dir_polar_ok(NAAD_DIR_SUBCARDIOID, theta) == 0) { return 0; }
    if (_dir_polar_ok(NAAD_DIR_SUPERCARDIOID, theta) == 0) { return 0; }
    if (_dir_polar_ok(NAAD_DIR_FIGURE8, theta) == 0) { return 0; }
    return 1;
}

alloc_init();

# ================================================================
# test_omnidirectional_is_unity_in_all_directions
# front = (1,0,0); gain ~ 1.0 for +x, -x, +y, +z.
test_group("omnidirectional_is_unity_in_all_directions");
var front_x = hvec3_unit_x();
assert(approx(naad_directivity_gain(NAAD_DIR_OMNIDIRECTIONAL, hvec3_unit_x(), front_x), F64_ONE, TOL_1E5),
  "omni +x -> 1.0");
assert(approx(naad_directivity_gain(NAAD_DIR_OMNIDIRECTIONAL, hvec3_neg(hvec3_unit_x()), front_x), F64_ONE, TOL_1E5),
  "omni -x -> 1.0");
assert(approx(naad_directivity_gain(NAAD_DIR_OMNIDIRECTIONAL, hvec3_unit_y(), front_x), F64_ONE, TOL_1E5),
  "omni +y -> 1.0");
assert(approx(naad_directivity_gain(NAAD_DIR_OMNIDIRECTIONAL, hvec3_unit_z(), front_x), F64_ONE, TOL_1E5),
  "omni +z -> 1.0");

# ================================================================
# test_cardioid_null_at_rear
# On-axis = 1.0, 180° = 0.0.
test_group("cardioid_null_at_rear");
assert(approx(naad_directivity_gain_polar(NAAD_DIR_CARDIOID, 0), F64_ONE, TOL_1E5),
  "cardioid on-axis -> 1.0");
assert(f64_lt(naad_directivity_gain_polar(NAAD_DIR_CARDIOID, F64_PI), TOL_1E5) == 1,
  "cardioid rear -> 0.0");

# ================================================================
# test_figure8_nulls_at_sides
# Peaks at 0 and π, nulls at ±π/2.
test_group("figure8_nulls_at_sides");
assert(approx(naad_directivity_gain_polar(NAAD_DIR_FIGURE8, 0), F64_ONE, TOL_1E5),
  "figure8 on-axis -> 1.0");
assert(approx(naad_directivity_gain_polar(NAAD_DIR_FIGURE8, F64_PI), F64_ONE, TOL_1E5),
  "figure8 rear -> 1.0");
assert(f64_lt(naad_directivity_gain_polar(NAAD_DIR_FIGURE8, F64_PI_2), TOL_1E5) == 1,
  "figure8 side -> 0.0");

# ================================================================
# test_supercardioid_has_small_rear_lobe
# Zero at π (clipped), positive at 2π/3.
test_group("supercardioid_has_small_rear_lobe");
assert(f64_lt(naad_directivity_gain_polar(NAAD_DIR_SUPERCARDIOID, F64_PI), TOL_1E5) == 1,
  "supercardioid rear -> 0.0 (clipped)");
var theta_oblique = f64_div(f64_mul(F64_TWO, F64_PI), f64_from(3));
assert(f64_gt(naad_directivity_gain_polar(NAAD_DIR_SUPERCARDIOID, theta_oblique), 0) == 1,
  "supercardioid oblique -> > 0.0");

# ================================================================
# test_polar_matches_3d_for_axisymmetric
# For theta in {0,45,90,135,180}°, 3D gain (dir in xy-plane, front +x)
# matches gain_polar within 1e-4 for cardioid / sub / super / figure-8.
test_group("polar_matches_3d_for_axisymmetric");
assert(_dir_all_polar_ok(_dir_radians(0)) == 1, "polar == 3D @ 0deg");
assert(_dir_all_polar_ok(_dir_radians(45)) == 1, "polar == 3D @ 45deg");
assert(_dir_all_polar_ok(_dir_radians(90)) == 1, "polar == 3D @ 90deg");
assert(_dir_all_polar_ok(_dir_radians(135)) == 1, "polar == 3D @ 135deg");
assert(_dir_all_polar_ok(_dir_radians(180)) == 1, "polar == 3D @ 180deg");

# ================================================================
# naad_directivity_to_goonj -- the naad kind tag -> goonj DirectivityPattern
# mapping every other entry point in this module funnels through. Two things
# have to hold and neither is visible from a null check: the goonj pattern
# must carry the tag for the SAME pattern (naad's NAAD_DIR_* and goonj's PAT_*
# happen to share numbering today, so the tag is compared against the goonj
# constant, not a literal), and it must behave like that pattern.
# ================================================================
test_group("to_goonj_maps_each_kind");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(NAAD_DIR_OMNIDIRECTIONAL)), PAT_OMNI,
  "omni -> PAT_OMNI");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(NAAD_DIR_CARDIOID)), PAT_CARDIOID,
  "cardioid -> PAT_CARDIOID");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(NAAD_DIR_SUBCARDIOID)), PAT_SUBCARDIOID,
  "subcardioid -> PAT_SUBCARDIOID");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(NAAD_DIR_SUPERCARDIOID)), PAT_SUPERCARDIOID,
  "supercardioid -> PAT_SUPERCARDIOID");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(NAAD_DIR_FIGURE8)), PAT_FIGURE8,
  "figure8 -> PAT_FIGURE8");
# Analytical patterns carry no measured balloon (tabulated data is deliberately
# out of naad's scope -- see the module header).
assert_eq(DirectivityPattern_balloon(naad_directivity_to_goonj(NAAD_DIR_CARDIOID)), 0,
  "cardioid pattern carries no balloon");
assert_eq(DirectivityPattern_balloon(naad_directivity_to_goonj(NAAD_DIR_FIGURE8)), 0,
  "figure8 pattern carries no balloon");
assert_neq(DirectivityPattern_kind(naad_directivity_to_goonj(NAAD_DIR_FIGURE8)), PAT_TABULATED,
  "naad never produces the tabulated pattern");

# The Rust enum is #[non_exhaustive] and the port's dispatch ends in a bare
# `return directivity_omnidirectional()`, so any unrecognised tag -- above the
# range or negative -- must fall back to omni rather than to whatever happens
# to be last in the if-chain.
test_group("to_goonj_unknown_kind_falls_back_to_omni");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(5)), PAT_OMNI, "kind 5 -> omni");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(99)), PAT_OMNI, "kind 99 -> omni");
assert_eq(DirectivityPattern_kind(naad_directivity_to_goonj(0 - 1)), PAT_OMNI, "kind -1 -> omni");
# ...and the fallback pattern really is omni: unity in every direction.
var fb = naad_directivity_to_goonj(99);
var fb_front = hvec3_unit_x();
assert(approx(directivity_gain(fb, hvec3_unit_x(), fb_front), F64_ONE, TOL_1E5),
  "fallback pattern is unity on-axis");
assert(approx(directivity_gain(fb, hvec3_neg(hvec3_unit_x()), fb_front), F64_ONE, TOL_1E5),
  "fallback pattern is unity behind (omni, not cardioid)");
assert(approx(directivity_gain(fb, hvec3_unit_y(), fb_front), F64_ONE, TOL_1E5),
  "fallback pattern is unity to the side (omni, not figure-8)");

# ================================================================
# The mapping is only right if the mapped pattern RADIATES like the requested
# one. Each kind is pinned at the angle that separates it from all the others:
# rear gain is 1.0 (omni), 0.0 (cardioid), 0.5 (subcardioid), 0.0-clipped
# (supercardioid) and 1.0 (figure-8), while side gain separates figure-8 (0.0)
# from subcardioid (0.75). Values come from the closed forms documented on the
# NAAD_DIR_* constants, evaluated through the goonj pattern to_goonj returned.
# ================================================================
test_group("to_goonj_patterns_radiate_correctly");
var tg_front = hvec3_unit_x();
var tg_rear = hvec3_neg(hvec3_unit_x());
var tg_side = hvec3_unit_y();

assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_OMNIDIRECTIONAL), tg_rear, tg_front),
    F64_ONE, TOL_1E5), "omni rear gain == 1.0");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_CARDIOID), tg_rear, tg_front),
    0, TOL_1E5), "cardioid rear gain == 0.0");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_CARDIOID), tg_side, tg_front),
    F64_HALF, TOL_1E5), "cardioid side gain == 0.5");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_SUBCARDIOID), tg_rear, tg_front),
    F64_HALF, TOL_1E5), "subcardioid rear gain == 0.5");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_SUBCARDIOID), tg_side, tg_front),
    NAAD_DIR_0_75, TOL_1E5), "subcardioid side gain == 0.75");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_SUPERCARDIOID), tg_side, tg_front),
    NAAD_DIR_0_37, TOL_1E5), "supercardioid side gain == 0.37");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_SUPERCARDIOID), tg_rear, tg_front),
    0, TOL_1E5), "supercardioid rear gain == 0.0 (clipped)");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_FIGURE8), tg_rear, tg_front),
    F64_ONE, TOL_1E5), "figure8 rear gain == 1.0");
assert(approx(directivity_gain(naad_directivity_to_goonj(NAAD_DIR_FIGURE8), tg_side, tg_front),
    0, TOL_1E5), "figure8 side gain == 0.0");

# Each call hands back its own pattern -- callers may mutate one without
# disturbing another (naad_directivity_gain builds a fresh one per call).
var tg_a = naad_directivity_to_goonj(NAAD_DIR_CARDIOID);
var tg_b = naad_directivity_to_goonj(NAAD_DIR_CARDIOID);
assert_neq(tg_a, tg_b, "to_goonj allocates a fresh pattern per call");
assert_eq(DirectivityPattern_kind(tg_a), DirectivityPattern_kind(tg_b), "...with the same kind");

var rc = assert_summary();
syscall(60, rc);
