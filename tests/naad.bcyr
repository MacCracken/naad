# naad benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# Batch anything near or below the clock floor -- batch_size >= 1000 for a
# sub-microsecond op, and higher still if the host's floor is high. Do NOT
# write the overhead down as a constant here: cyrius 6.5.19 retired the fixed
# figure this comment used to carry, because one clock read spans ~15 ns
# (macOS arm64) to ~3,550 ns (aarch64 Linux) across the hosts the gate runs
# on, and it moves between reboots on a single machine. Read it at runtime
# with bench_clock_overhead_ns(); see the lib/bench.cyr header.

# Benchmark: noop.
fn bench_noop(): i64 { return 0; }

# Bench entry point — runs every benchmark in this file.
fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);
    return 0;
}

var r = main();
syscall(60, r);
