# tuning.tcyr -- parity tests for src/tuning.cyr.
# Ported one-for-one from the #[test] blocks in rust-old/src/tuning.rs
# (the serde round-trip test is dropped: no serde in Cyrius). f32 -> f64;
# tolerances match the Rust oracle's own absolute thresholds.

include "src/error.cyr"
include "src/tuning.cyr"

alloc_init();

var TOL_0_01 = 0x3f847ae147ae147b;   # 0.01
var TOL_0_1  = 0x3fb999999999999a;   # 0.1
var C261_63  = 0x40705a147ae147ae;   # 261.63
var TOL_1E_12    = 0x3d719799812dea11;   # 1e-12
var C440         = 0x407b800000000000;   # 440.0
var C432         = 0x407b000000000000;   # 432.0
var C220         = 0x406b800000000000;   # 220.0
var C880         = 0x408b800000000000;   # 880.0
var C864         = 0x408b000000000000;   # 864.0
var C55          = 0x404b800000000000;   # 55.0
var C261_6255653 = 0x40705a0250c2b956;   # 261.6255653005986  = 440 * 2^(-9/12)
var C466_1637615 = 0x407d229ec465c8a2;   # 466.1637615180899  = 440 * 2^(1/12)
var C8_1757989   = 0x40205a0250c2b956;   # 8.175798915643707  = 440 * 2^(-69/12)

# ================================================================
test_group("midi <-> freq");
# A4 = midi note 69 = 440 Hz.
var a4 = tuning_midi_to_freq(69);
assert(f64_lt(f64_abs(f64_sub(a4, f64_from(440))), TOL_0_01), "A4 = 440 Hz");
# C4 = midi note 60 ~ 261.63 Hz.
var c4 = tuning_midi_to_freq(60);
assert(f64_lt(f64_abs(f64_sub(c4, C261_63)), TOL_0_1), "C4 ~ 261.63 Hz");
# Octave: midi(81) / midi(69) == 2.0.
var a4o = tuning_midi_to_freq(69);
var a5 = tuning_midi_to_freq(81);
assert(f64_lt(f64_abs(f64_sub(f64_div(a5, a4o), F64_TWO)), TOL_0_01), "octave = 2:1 ratio");

# ================================================================
test_group("freq_to_midi roundtrip");
# For every MIDI note 21..=108, freq_to_midi(midi_to_freq(note)) == note.
var rt_ok = 1;
var note = 21;
while (note <= 108) {
    var freq = tuning_midi_to_freq(note);
    var back = tuning_freq_to_midi(freq);
    if (back != note) { rt_ok = 0; }
    note = note + 1;
}
assert(rt_ok, "freq_to_midi roundtrip 21..=108");

# ================================================================
test_group("cents");
# Octave (440 -> 880) is 1200 cents.
var oc = tuning_cents(f64_from(440), f64_from(880));
assert(f64_lt(f64_abs(f64_sub(oc, f64_from(1200))), TOL_0_1), "octave = 1200 cents");
# One semitone (A4 -> Bb4) is 100 cents.
var sa4 = tuning_midi_to_freq(69);
var bb4 = tuning_midi_to_freq(70);
var sc = tuning_cents(sa4, bb4);
assert(f64_lt(f64_abs(f64_sub(sc, f64_from(100))), TOL_0_1), "semitone = 100 cents");

# ================================================================
test_group("note_name");
assert_streq(tuning_note_name(69), "A4", "note_name(69) = A4");
assert_streq(tuning_note_name(60), "C4", "note_name(60) = C4");
assert_streq(tuning_note_name(72), "C5", "note_name(72) = C5");

# ================================================================
test_group("tuning tables");
# Just intonation: A4 (note 69) resolves to 440 Hz.
var jt = tuning_table_from_system(TUNING_JUST_INTONATION, f64_from(440));
var jt_a4 = tuning_note_to_freq(jt, 69);
assert(f64_lt(f64_abs(f64_sub(jt_a4, f64_from(440))), TOL_0_1), "just intonation A4 = 440");
# Pythagorean: A4 resolves to 440 Hz.
var pt = tuning_table_from_system(TUNING_PYTHAGOREAN, f64_from(440));
var pt_a4 = tuning_note_to_freq(pt, 69);
assert(f64_lt(f64_abs(f64_sub(pt_a4, f64_from(440))), TOL_0_1), "pythagorean A4 = 440");
# Equal-temperament table C4 matches midi_to_freq C4 within 1 Hz.
var et = tuning_table_from_system(TUNING_EQUAL_TEMPERAMENT, f64_from(440));
var et_c4 = tuning_note_to_freq(et, 60);
var midi_c4 = tuning_midi_to_freq(60);
assert(f64_lt(f64_abs(f64_sub(et_c4, midi_c4)), F64_ONE), "ET table C4 matches midi_to_freq C4");

# ================================================================
test_group("custom tuning validation");
# A ratio <= 0 must be rejected.
var bad = vec_new();
var bi = 0;
while (bi < 12) { vec_push(bad, F64_ONE); bi = bi + 1; }
vec_set(bad, 3, f64_neg(F64_ONE));
var res = tuning_table_custom("bad", bad, f64_from(440));
assert(naad_is_err(res) == 1, "custom rejects negative ratio");

# ================================================================
# tuning_note_name's domain is the oracle's: `note: u8` at
# rust-old/src/tuning.rs:189, so 0..255, wider than MIDI's 0..127. Outside it the
# signed parameter would format a nonsense octave.
# ================================================================
test_group("note_name covers exactly the oracle's u8 domain");
assert_streq(tuning_note_name(0), "C-1", "note 0 = C-1");
assert_streq(tuning_note_name(127), "G9", "note 127 = G9");
assert_streq(tuning_note_name(128), "G#9", "note 128 = G#9, as Rust names it");
assert_streq(tuning_note_name(200), "G#15", "note 200 = G#15, as Rust names it");
assert_streq(tuning_note_name(255), "D#20", "note 255 = D#20, the top of u8");
assert_streq(tuning_note_name(256), "", "note 256 is outside u8");
assert_streq(tuning_note_name(0 - 1), "", "a negative note is outside u8");
assert_streq(tuning_note_name(1000000), "", "a far out-of-range note is rejected");
assert_streq(tuning_note_name(69), "A4", "control: A4 unchanged");

test_group("note_name_str range");
assert_streq(tuning_note_name_str(0 - 1), "", "negative pitch class -> empty, not a silent B");
assert_streq(tuning_note_name_str(12), "", "pitch class 12 -> empty");
assert_streq(tuning_note_name_str(11), "B", "control: pitch class 11 is B");
assert_streq(tuning_note_name_str(0), "C", "control: pitch class 0 is C");

# ================================================================
# 2.2.1 -- tuning_equal_temperament_freq had no direct coverage. Every existing
# assertion reached it through tuning_midi_to_freq, which hardcodes a4_hz = 440,
# so the `a4_hz` parameter itself was never exercised at all: an implementation
# that ignored it and always used 440 passed this whole file.
# Oracle: rust-old/src/tuning.rs:16-18 --
#   pub fn equal_temperament_freq(note: u8, a4_hz: f32) -> f32 {
#       a4_hz * 2.0f32.powf((note as f32 - 69.0) / 12.0)
#   }
# Expected values below are the correctly-rounded f64 evaluations of that
# formula; they are asserted on the raw bit pattern (never through f64_to,
# which truncates) wherever the port reproduces them exactly.
# ================================================================
test_group("equal_temperament_freq");
# Note 69 IS the reference note, so the result must be a4_hz bit for bit --
# for any reference, which is what pins the a4_hz parameter down.
assert_eq(tuning_equal_temperament_freq(69, C440), C440, "etf(69, 440) is exactly 440");
assert_eq(tuning_equal_temperament_freq(69, C432), C432, "etf(69, 432) is exactly 432 -- a4_hz is honoured");
assert_eq(tuning_equal_temperament_freq(69, C220), C220, "etf(69, 220) is exactly 220");
# An octave is an exact factor of two either side of the reference.
assert_eq(tuning_equal_temperament_freq(81, C440), C880, "etf(81, 440) is exactly 880 (octave up doubles)");
assert_eq(tuning_equal_temperament_freq(57, C440), C220, "etf(57, 440) is exactly 220 (octave down halves)");
assert_eq(tuning_equal_temperament_freq(81, C432), C864, "etf(81, 432) is exactly 864 -- octave scales with a4_hz");
# Non-octave notes: exact correctly-rounded values of 440 * 2^((n-69)/12).
assert_eq(tuning_equal_temperament_freq(60, C440), C261_6255653, "etf(60, 440) = 261.6255653005986 (C4)");
assert_eq(tuning_equal_temperament_freq(70, C440), C466_1637615, "etf(70, 440) = 466.1637615180899 (Bb4)");
assert_eq(tuning_equal_temperament_freq(0, C440), C8_1757989, "etf(0, 440) = 8.175798915643707 (C-1)");
# midi_to_freq is defined as etf(note, 440) -- identical bits, not merely close.
assert_eq(tuning_midi_to_freq(60), tuning_equal_temperament_freq(60, C440),
  "midi_to_freq(60) == etf(60, 440) bit for bit");
assert_eq(tuning_midi_to_freq(127), tuning_equal_temperament_freq(127, C440),
  "midi_to_freq(127) == etf(127, 440) bit for bit");
# Halving the reference halves every note, not just note 69.
assert_eq(tuning_equal_temperament_freq(60, C220), f64_div(C261_6255653, F64_TWO), "halving a4_hz halves C4");
# Note 33 = A1 = 55 Hz. The port lands 2 ULP high (55.000000000000014): the
# exponent is exactly -3.0 yet f64_pow(2, -3) is not exactly 0.125. Asserted to
# 1e-12 rather than on bits so the drift is bounded, not blessed.
assert(f64_lt(f64_abs(f64_sub(tuning_equal_temperament_freq(33, C440), C55)), TOL_1E_12),
  "etf(33, 440) = 55 Hz within 1e-12");
# Strictly increasing across the whole MIDI range -- catches a sign-flipped or
# truncated exponent that individual spot checks could still satisfy.
var mono_ok = 1;
var mprev = tuning_equal_temperament_freq(0, C440);
var mn = 1;
while (mn < 128) {
    var mcur = tuning_equal_temperament_freq(mn, C440);
    if (f64_gt(mcur, mprev) == 0) { mono_ok = 0; }
    mprev = mcur;
    mn = mn + 1;
}
assert(mono_ok, "etf is strictly increasing over MIDI 0..127");

# ================================================================
test_group("freq_to_midi rounds a tie away from zero");
# The rule itself, on exact inputs. Rust's `round` sends every .5 away from
# zero; the even results are the ones a ties-to-even rounder gets wrong.
fn half_up(n) { return f64_add(f64_from(n), F64_HALF); }
assert_eq(_tuning_round(half_up(60)), f64_from(61), "60.5 -> 61");
assert_eq(_tuning_round(half_up(61)), f64_from(62), "61.5 -> 62");
assert_eq(_tuning_round(half_up(0)), f64_from(1), "0.5 -> 1");
assert_eq(_tuning_round(half_up(2)), f64_from(3), "2.5 -> 3");
assert_eq(_tuning_round(f64_neg(half_up(0))), f64_neg(f64_from(1)), "-0.5 -> -1");
assert_eq(_tuning_round(f64_neg(half_up(2))), f64_neg(f64_from(3)), "-2.5 -> -3");
# One ulp under a tie stays down, which `floor(x + 0.5)` gets wrong at 0.5.
assert_eq(_tuning_round(F64_HALF - 1), 0, "largest double below 0.5 -> 0");
assert_eq(_tuning_round(half_up(60) - 1), f64_from(60), "one ulp below 60.5 -> 60");
assert_eq(_tuning_round(f64_from(60)), f64_from(60), "an integer is unchanged");
assert_eq(_tuning_round(0x8000000000000000), 0x8000000000000000, "-0.0 keeps its sign");
assert_eq(naad_is_finite(_tuning_round(0x7FF8000000000000)), 0, "NaN stays NaN");
assert_eq(_tuning_round(0x7FF0000000000000), 0x7FF0000000000000, "+inf stays +inf");

# End to end. Each even note k is searched for a frequency whose fractional MIDI
# value is exactly k + 0.5 under this target's own ln, so the test does not pin
# x87 bits. Both frequencies named below are ties on x86-64.
fn midi_of(freq) {
    var lg = f64_div(f64_ln(f64_div(freq, f64_from(440))), F64_LN2);
    return f64_add(f64_from(69), f64_mul(f64_from(12), lg));
}
# A frequency within 32 ulps of k + 0.5's that lands exactly on it, or 0 if none.
fn tie_freq_for(k) {
    var target = f64_add(f64_from(k), F64_HALF);
    var f0 = f64_mul(f64_from(440), f64_pow(F64_TWO, f64_div(f64_sub(target, f64_from(69)), f64_from(12))));
    var d = 0 - 32;
    while (d <= 32) {
        if (f64_eq(midi_of(f0 + d), target) == 1) { return f0 + d; }
        d = d + 1;
    }
    return 0;
}
var tie_ties = 0;
var tie_bad = 0;
var tie_k = 0;
while (tie_k < 127) {
    var tie_f = tie_freq_for(tie_k);
    if (tie_f != 0) {
        tie_ties = tie_ties + 1;
        if (tuning_freq_to_midi(tie_f) != tie_k + 1) { tie_bad = tie_bad + 1; }
    }
    tie_k = tie_k + 2;
}
assert(tie_ties >= 32, "enough even-note ties were found to mean something");
assert_eq(tie_bad, 0, "every even-note tie rounds up to the next note");
assert_eq(tuning_freq_to_midi(0x407AB795B9C289E4), 69, "427.4740541075864 Hz (68.5) -> 69");
assert_eq(tuning_freq_to_midi(0x4070D4AB21026360), 61, "269.2917795270241 Hz (60.5) -> 61");

# ================================================================
test_group("custom table owns its ratios");
# `[f32; 12]` is passed by value, so a Rust table cannot see later writes to the
# caller's array. Sharing the vec here would also bypass the validation.
var own_r = vec_new();
var own_i = 0;
while (own_i < 12) { vec_push(own_r, F64_ONE); own_i = own_i + 1; }
var own_t1 = tuning_table_custom("one", own_r, f64_from(440));
var own_before = tuning_note_to_freq(own_t1, 70);
assert_eq(own_before, f64_from(440), "ratio 1.0 at degree 10 gives 440 Hz");
vec_set(own_r, 10, F64_TWO);
var own_t2 = tuning_table_custom("two", own_r, f64_from(440));
assert_eq(tuning_note_to_freq(own_t1, 70), own_before, "a later table from the same vec leaves the first alone");
assert_eq(tuning_note_to_freq(own_t2, 70), f64_from(880), "the later table sees its own ratios");
vec_set(own_r, 10, f64_neg(F64_ONE));
assert_eq(tuning_note_to_freq(own_t2, 70), f64_from(880), "a value validation rejects cannot be written in later");
assert_eq(vec_len(TuningTable_ratios(own_t1)), 12, "the copy keeps all 12 ratios");

# ================================================================
test_group("custom table owns its name");
var dtn = alloc(8);
store8(dtn, 'A');
store8(dtn + 1, 0);
var dtr = vec_new();
var dti = 0;
while (dti < 12) { vec_push(dtr, F64_ONE); dti = dti + 1; }
var dtt = tuning_table_custom(dtn, dtr, f64_from(440));
store8(dtn, 'B');
assert_eq(load8(TuningTable_name(dtt)), 'A', "a later write to the caller's buffer does not reach the table");

var rc = assert_summary();
syscall(60, rc);
