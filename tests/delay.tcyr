# delay.tcyr -- parity tests for src/delay.cyr.
# Ported from the #[test] blocks in rust-old/src/delay.rs. The serde
# round-trip test (test_serde_roundtrip) is dropped (no serde in Cyrius).

include "src/error.cyr"
include "src/delay.cyr"

alloc_init();

var C0_5  = 0x3FE0000000000000;   # 0.5
var C0_25 = 0x3FD0000000000000;   # 0.25
var C0_75 = 0x3FE8000000000000;   # 0.75

# ================================================================
test_group("delay_line_basic");
# Reading with delay 0 returns the just-written sample.
var dl1 = delay_line_new(10);
delay_line_write(dl1, F64_ONE);
var v1 = delay_line_read(dl1, 0);
assert(f64_lt(f64_abs(f64_sub(v1, F64_ONE)), NAAD_EPSILON), "delay 0 returns last write");

# ================================================================
test_group("delay_line_delayed");
# A 5-sample delay recalls the sample written 5 writes ago.
var dl2 = delay_line_new(10);
delay_line_write(dl2, F64_ONE);
var z = 0;
while (z < 5) {
    delay_line_write(dl2, 0);
    z = z + 1;
}
var v2 = delay_line_read(dl2, f64_from(5));
assert(f64_lt(f64_abs(f64_sub(v2, F64_ONE)), NAAD_EPSILON), "expected 1.0 at 5 sample delay");

# ================================================================
test_group("delay_fractional");
# A fractional delay interpolates between neighbouring samples.
var dl3 = delay_line_new(10);
delay_line_write(dl3, 0);
delay_line_write(dl3, F64_ONE);
var v3 = delay_line_read(dl3, C0_5);
var frac_ok = 0;
if (f64_gt(v3, 0) == 1) {
    if (f64_lt(v3, F64_ONE) == 1) { frac_ok = 1; }
}
assert(frac_ok, "fractional delay should interpolate");

# ================================================================
test_group("comb_filter");
var comb = comb_filter_new(100, C0_5);
var co = comb_filter_process_sample(comb, F64_ONE);
assert(naad_is_finite(co), "comb output is finite");

# ================================================================
test_group("allpass_delay");
var ap = allpass_delay_new(100, C0_5);
var ao = allpass_delay_process_sample(ap, F64_ONE);
assert(naad_is_finite(ao), "allpass output is finite");

# ================================================================
# 2.2.1 coverage: delay_line_clear and the AllpassDelay accessors.
# The delay line holds small integers, so every read has an exactly
# representable expected value and is compared as a raw f64 bit pattern.
# ================================================================

test_group("delay_line_clear");
# 11 writes into an 8-slot line: the cursor wraps to 3 and the buffer holds
# 9, 10, 11, 4, 5, 6, 7, 8 in slots 0..7.
var dc = delay_line_new(8);
var dc_w = 0;
while (dc_w < 11) {
    delay_line_write(dc, f64_from(dc_w + 1));
    dc_w = dc_w + 1;
}
assert_eq(DelayLine_write_pos(dc), 3, "11 writes into an 8-slot line leave the cursor at 3");
var dc_last = delay_line_read(dc, 0);
assert_eq(dc_last, f64_from(11), "delay 0 reads the most recent write");
var dc_back3 = delay_line_read(dc, f64_from(3));
assert_eq(dc_back3, f64_from(8), "delay 3 reads the sample written 3 writes ago");
# clear() fills the buffer with silence.
assert_eq(delay_line_clear(dc), 0, "delay_line_clear returns 0");
var dc_nonzero = 0;
var dc_slot = 0;
while (dc_slot < 8) {
    if (vec_get(DelayLine_buffer(dc), dc_slot) != 0) { dc_nonzero = dc_nonzero + 1; }
    dc_slot = dc_slot + 1;
}
assert_eq(dc_nonzero, 0, "clear zeroes every slot, not just the ones near the cursor");
# ...so every read comes back as exactly +0.0, including a fractional one.
assert_eq(delay_line_read(dc, 0), 0, "read at delay 0 after clear -> 0.0");
assert_eq(delay_line_read(dc, f64_from(3)), 0, "read at delay 3 after clear -> 0.0");
assert_eq(delay_line_read(dc, C0_5), 0, "fractional read after clear -> 0.0");
# clear() only fills the buffer (rust-old/src/delay.rs `self.buffer.fill(0.0)`):
# it does NOT rewind the cursor or resize the line.
assert_eq(DelayLine_write_pos(dc), 3, "clear leaves write_pos untouched");
assert_eq(DelayLine_max_delay_samples(dc), 8, "clear leaves the line length untouched");
assert_eq(vec_len(DelayLine_buffer(dc)), 8, "clear leaves the backing vec length untouched");
# The line still works after clearing: the next write lands at the preserved
# cursor (slot 3) and is read back at delay 0.
delay_line_write(dc, f64_from(42));
assert_eq(vec_get(DelayLine_buffer(dc), 3), f64_from(42), "post-clear write lands at the preserved cursor");
assert_eq(delay_line_read(dc, 0), f64_from(42), "post-clear line reads back the new write");
assert_eq(delay_line_read(dc, f64_from(1)), 0, "one sample back is still silent after clear");
# clear() on a 1-slot line (the floor applied by delay_line_new) is a no-op
# beyond zeroing that slot.
var dc_min = delay_line_new(0);
assert_eq(DelayLine_max_delay_samples(dc_min), 1, "delay_line_new(0) floors at one slot");
delay_line_write(dc_min, F64_ONE);
assert_eq(delay_line_clear(dc_min), 0, "clear on a 1-slot line returns 0");
assert_eq(vec_get(DelayLine_buffer(dc_min), 0), 0, "1-slot line cleared to 0.0");

# ================================================================
test_group("allpass accessors round-trip");
var ap1 = allpass_delay_new(100, C0_5);
# Constructor values, read back exactly.
assert_eq(allpass_delay_coefficient(ap1), C0_5, "coefficient == constructor value 0.5");
assert_eq(allpass_delay_delay_samples(ap1), f64_from(100), "delay_samples == constructor value 100.0");
# `coefficient.clamp(-0.999, 0.999)` (rust-old/src/delay.rs) -- both ends.
var ap_hi = allpass_delay_new(64, f64_from(5));
assert_eq(allpass_delay_coefficient(ap_hi), DELAY_STABLE_HI, "coefficient clamps up to 0.999");
var ap_lo = allpass_delay_new(64, f64_neg(f64_from(5)));
assert_eq(allpass_delay_coefficient(ap_lo), DELAY_STABLE_LO, "coefficient clamps down to -0.999");
# A value inside the range is NOT clamped.
var ap_mid = allpass_delay_new(64, f64_neg(C0_5));
assert_eq(allpass_delay_coefficient(ap_mid), f64_neg(C0_5), "in-range coefficient passes through unclamped");
# delay_samples is `delay_samples as f32`, stored independently of the buffer
# length: a 0-sample request still allocates one slot but reports 0.0.
var ap_zero = allpass_delay_new(0, C0_5);
assert_eq(allpass_delay_delay_samples(ap_zero), 0, "delay_samples(0) == 0.0");
assert_eq(DelayLine_max_delay_samples(AllpassDelay_delay_line(ap_zero)), 1, "0-sample allpass still gets one slot");
# The accessors report the values the process path actually uses. On a fresh
# line the delayed term is 0.0, so the first output is exactly -g * x:
# -0.5 * 1.0 = -0.5, and the buffer receives x + g*y = 1.0 + 0.5*(-0.5) = 0.75.
var ap_p = allpass_delay_new(4, C0_5);
var ap_out = allpass_delay_process_sample(ap_p, F64_ONE);
assert_eq(ap_out, f64_neg(C0_5), "first allpass output == -coefficient * input");
assert_eq(vec_get(DelayLine_buffer(AllpassDelay_delay_line(ap_p)), 0), C0_75, "allpass stores x + g*y = 0.75");
assert_eq(allpass_delay_coefficient(ap_p), C0_5, "processing does not disturb the coefficient");
assert_eq(allpass_delay_delay_samples(ap_p), f64_from(4), "processing does not disturb delay_samples");
# Changing the coefficient through the accessor's setter changes the output:
# -0.25 * 1.0 = -0.25 on a fresh line.
var ap_s = allpass_delay_new(4, C0_5);
AllpassDelay_set_coefficient(ap_s, C0_25);
assert_eq(allpass_delay_coefficient(ap_s), C0_25, "coefficient setter round-trips");
var ap_s_out = allpass_delay_process_sample(ap_s, F64_ONE);
assert_eq(ap_s_out, f64_neg(C0_25), "the reported coefficient is the one the process path uses");

# ================================================================
test_group("lengths past VEC_CAP_MAX are refused");
# A length is an integer here, so no f64 guard stands in front of these. Each
# constructor answers with an error rather than ending the process in vec_push.
var over = VEC_CAP_MAX + 1;
assert_eq(delay_line_new(over), NAAD_ERR_BUFFER_OVERFLOW, "delay_line_new refuses one past the cap");
assert_eq(comb_filter_new(over, C0_5), NAAD_ERR_BUFFER_OVERFLOW, "comb_filter_new passes the refusal on");
assert_eq(allpass_delay_new(over, C0_5), NAAD_ERR_BUFFER_OVERFLOW, "allpass_delay_new passes the refusal on");
var huge = 0x7FFFFFFFFFFFFFFF;
assert_eq(delay_line_new(huge), NAAD_ERR_BUFFER_OVERFLOW, "delay_line_new refuses INT64_MAX");
# The floor is unchanged: a negative length is still a one-slot line.
assert_eq(DelayLine_max_delay_samples(delay_line_new(0 - 5)), 1, "a negative length floors to one slot");
var neg_cf = comb_filter_new(0 - 5, C0_5);
assert_eq(DelayLine_max_delay_samples(CombFilter_delay_line(neg_cf)), 1, "a negative comb floors to one slot");

# ================================================================
test_group("a delay line is sized once");
# Growing by push would leave every smaller buffer behind on a bump allocator,
# about twice the storage. 1000 slots is 8000 bytes; the header, the vec's
# initial 128-byte buffer and the DelayLine struct stay well under 1000 more.
var size_used = alloc_used();
var sized = delay_line_new(1000);
assert(alloc_used() - size_used < 9000, "a 1000-slot line takes one buffer's worth of heap");
assert_eq(vec_len(DelayLine_buffer(sized)), 1000, "the buffer has the requested length");
assert_eq(vec_get(DelayLine_buffer(sized), 999), 0, "the last slot starts at +0.0");
delay_line_write(sized, F64_ONE);
assert_eq(delay_line_read(sized, 0), F64_ONE, "a sized line reads back what it stored");

# ================================================================
test_group("read position covers the whole ring");
# Every cursor position against every delay, for each small length. The expected
# slot comes from the euclidean remainder the read's single add stands in for.
var ring_lens = vec_new();
vec_push(ring_lens, 1);
vec_push(ring_lens, 2);
vec_push(ring_lens, 3);
vec_push(ring_lens, 7);
vec_push(ring_lens, 16);
var ring_ok = 1;
var ring_l = 0;
while (ring_l < vec_len(ring_lens)) {
    var ring_len = vec_get(ring_lens, ring_l);
    var ring = delay_line_new(ring_len);
    var ring_slot = 0;
    while (ring_slot < ring_len) {
        vec_set(DelayLine_buffer(ring), ring_slot, f64_from(ring_slot + 1));
        ring_slot = ring_slot + 1;
    }
    var ring_wp = 0;
    while (ring_wp < ring_len) {
        DelayLine_set_write_pos(ring, ring_wp);
        var ring_d = 0;
        while (ring_d < ring_len + 3) {
            var ring_used = ring_d;
            if (ring_used > ring_len - 1) { ring_used = ring_len - 1; }
            var ring_want = ((ring_wp - ring_used - 1) % ring_len + ring_len) % ring_len;
            var ring_got = delay_line_read(ring, f64_from(ring_d));
            var ring_exp = vec_get(DelayLine_buffer(ring), ring_want);
            if (ring_got != ring_exp) { ring_ok = 0; }
            ring_d = ring_d + 1;
        }
        ring_wp = ring_wp + 1;
    }
    ring_l = ring_l + 1;
}
assert_eq(ring_ok, 1, "every cursor and delay lands on the euclidean slot");

# ================================================================
test_group("non-finite delays");
var nf_dl = delay_line_new(8);
var nf_i = 0;
while (nf_i < 8) {
    delay_line_write(nf_dl, f64_from(nf_i + 1));
    nf_i = nf_i + 1;
}
# +Inf clamps to the oldest slot, -Inf to the newest. NaN stays NaN, as Rust's
# clamp leaves it, and casts to a whole delay of 0 without leaving the ring.
assert_eq(delay_line_read(nf_dl, NAAD_POS_INF), F64_ONE, "+Inf reads the oldest sample");
assert_eq(delay_line_read(nf_dl, NAAD_NEG_INF), f64_from(8), "-Inf reads the newest sample");
assert_eq(naad_is_finite(delay_line_read(nf_dl, 0x7FF8000000000000)), 0, "NaN delay reads NaN");

# ================================================================
test_group("delay setters take effect on the next sample");
# CombFilter.delay_samples is a public field in the oracle. Moving it mid-stream
# must behave exactly as a read at the new delay.
var set_cf = comb_filter_new(8, 0);
var set_i = 0;
while (set_i < 8) {
    var set_out = comb_filter_process_sample(set_cf, f64_from(set_i + 1));
    set_i = set_i + 1;
}
CombFilter_set_delay_samples(set_cf, 0x4009000000000000);    # 3.125
var set_want = delay_line_read(CombFilter_delay_line(set_cf), 0x4009000000000000);
CombFilter_set_feedback(set_cf, F64_ONE);
assert_eq(comb_filter_process_sample(set_cf, 0), set_want, "comb reads at the delay its setter just stored");
var set_ap = allpass_delay_new(8, 0);
set_i = 0;
while (set_i < 8) {
    var set_ap_out = allpass_delay_process_sample(set_ap, f64_from(set_i + 1));
    set_i = set_i + 1;
}
AllpassDelay_set_delay_samples(set_ap, f64_from(2));
var set_ap_want = delay_line_read(AllpassDelay_delay_line(set_ap), f64_from(2));
assert_eq(allpass_delay_process_sample(set_ap, 0), set_ap_want, "allpass reads at the delay its setter just stored");

var rc = assert_summary();
syscall(60, rc);
