# drum.tcyr -- parity tests for src/drum.cyr.
# Ported from the non-serde #[test] blocks in rust-old/src/synth/drum.rs
# (the three serde round-trip tests dropped -- no serde). f32 thresholds
# reused directly (produce-output / decay-to-silence are magnitude checks).

include "src/error.cyr"
include "src/dsp_util.cyr"
include "src/filter.cyr"
include "src/drum.cyr"

alloc_init();

var C0_01   = 0x3F847AE147AE147B;   # 0.01
var C0_001  = 0x3F50624DD2F1A9FC;   # 0.001
var C0_0001 = 0x3F1A36E2EB1C432D;   # 0.0001
var C1E_12  = 0x3D719799812DEA11;   # 1e-12

var SR = 44100;

# ================================================================
# _make_buf(n) -- fresh vec of n zeroed slots.
fn _make_buf(n) {
    var b = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(b, 0);
        i = i + 1;
    }
    return b;
}

# _any_above(buf, thresh) -- 1 if any |slot| > thresh.
fn _any_above(buf, thresh) {
    var n = vec_len(buf);
    var i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(vec_get(buf, i)), thresh) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# _all_finite(buf) -- 1 if every slot is finite.
fn _all_finite(buf) {
    var n = vec_len(buf);
    var i = 0;
    while (i < n) {
        if (naad_is_finite(vec_get(buf, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# Helpers for the 2.2.1 per-sample coverage blocks at the bottom of the
# file. Every voice seeds a fixed xorshift32 state in its constructor, so
# two identically-built voices generate bit-identical streams.
# ================================================================

# is_active after clocking `n` samples through a freshly triggered kick.
fn _dt_kick_active_after(n) {
    var k = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), F64_HALF, f64_from(SR));
    drum_kick_trigger(k);
    var i = 0;
    while (i < n) {
        var s = drum_kick_next_sample(k);
        i = i + 1;
    }
    return drum_kick_is_active(k);
}

# is_active after clocking `n` samples through a freshly triggered snare.
fn _dt_snare_active_after(n) {
    var d = drum_snare_new(f64_from(SR));
    drum_snare_trigger(d);
    var i = 0;
    while (i < n) {
        var s = drum_snare_next_sample(d);
        i = i + 1;
    }
    return drum_snare_is_active(d);
}

# is_active after clocking `n` samples through a freshly triggered hi-hat.
fn _dt_hat_active_after(open, n) {
    var h = drum_hihat_new(open, f64_from(SR));
    drum_hihat_trigger(h);
    var i = 0;
    while (i < n) {
        var s = drum_hihat_next_sample(h);
        i = i + 1;
    }
    return drum_hihat_is_active(h);
}

# 1 iff `n` kick samples are bit-identical through next_sample and
# fill_buffer AND the stream is not all zeros -- so an unwritten buffer
# cannot pass by matching a silent generator.
fn _dt_kick_streams_match(n) {
    var a = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), F64_HALF, f64_from(SR));
    var b = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), F64_HALF, f64_from(SR));
    drum_kick_trigger(a);
    drum_kick_trigger(b);
    var buf = _make_buf(n);
    drum_kick_fill_buffer(b, buf);
    var nonzero = 0;
    var i = 0;
    while (i < n) {
        var s = drum_kick_next_sample(a);
        if (s != vec_get(buf, i)) { return 0; }
        if (s != 0) { nonzero = 1; }
        i = i + 1;
    }
    return nonzero;
}

# Same, for the snare.
fn _dt_snare_streams_match(n) {
    var a = drum_snare_new(f64_from(SR));
    var b = drum_snare_new(f64_from(SR));
    drum_snare_trigger(a);
    drum_snare_trigger(b);
    var buf = _make_buf(n);
    drum_snare_fill_buffer(b, buf);
    var nonzero = 0;
    var i = 0;
    while (i < n) {
        var s = drum_snare_next_sample(a);
        if (s != vec_get(buf, i)) { return 0; }
        if (s != 0) { nonzero = 1; }
        i = i + 1;
    }
    return nonzero;
}

# Same, for the closed hi-hat.
fn _dt_hat_streams_match(n) {
    var a = drum_hihat_new(0, f64_from(SR));
    var b = drum_hihat_new(0, f64_from(SR));
    drum_hihat_trigger(a);
    drum_hihat_trigger(b);
    var buf = _make_buf(n);
    drum_hihat_fill_buffer(b, buf);
    var nonzero = 0;
    var i = 0;
    while (i < n) {
        var s = drum_hihat_next_sample(a);
        if (s != vec_get(buf, i)) { return 0; }
        if (s != 0) { nonzero = 1; }
        i = i + 1;
    }
    return nonzero;
}

# ================================================================
test_group("kick produces output and decays");
var kick = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), F64_HALF, f64_from(SR));
drum_kick_trigger(kick);
assert(drum_kick_is_active(kick), "kick should be active after trigger");

var kbuf = _make_buf(512);
drum_kick_fill_buffer(kick, kbuf);
assert(_any_above(kbuf, C0_01), "kick should produce output");
assert(_all_finite(kbuf), "kick output all finite");

var kd = 0;
while (kd < 200) {
    var kdecay = _make_buf(512);
    drum_kick_fill_buffer(kick, kdecay);
    kd = kd + 1;
}
assert(drum_kick_is_active(kick) == 0, "kick should decay to silence");

# ================================================================
test_group("snare produces output and decays");
var snare = drum_snare_new(f64_from(SR));
drum_snare_trigger(snare);
assert(drum_snare_is_active(snare), "snare should be active after trigger");

var sbuf = _make_buf(512);
drum_snare_fill_buffer(snare, sbuf);
assert(_any_above(sbuf, C0_001), "snare should produce output");
assert(_all_finite(sbuf), "snare output all finite");

var sd = 0;
while (sd < 200) {
    var sdecay = _make_buf(512);
    drum_snare_fill_buffer(snare, sdecay);
    sd = sd + 1;
}
assert(drum_snare_is_active(snare) == 0, "snare should decay to silence");

# ================================================================
test_group("hihat produces output and decays");
var hat = drum_hihat_new(0, f64_from(SR));
drum_hihat_trigger(hat);
assert(drum_hihat_is_active(hat), "hihat should be active after trigger");

var hbuf = _make_buf(512);
drum_hihat_fill_buffer(hat, hbuf);
assert(_any_above(hbuf, C0_0001), "hihat should produce output");
assert(_all_finite(hbuf), "hihat output all finite");

var hd = 0;
while (hd < 200) {
    var hdecay = _make_buf(512);
    drum_hihat_fill_buffer(hat, hdecay);
    hd = hd + 1;
}
assert(drum_hihat_is_active(hat) == 0, "hihat should decay to silence");

# ================================================================
# 2.2.1 accessor/coverage pass -- the per-sample entry points. The three
# fill_buffer groups above already cover "produces output and decays"; these
# blocks pin down what a SINGLE drum_*_next_sample call returns, where the
# active flag moves, and that the envelope constants are what the module
# documents. Values are exact (raw f64 bit patterns via assert_eq, never
# f64_to) wherever the arithmetic is reproducible.
# ================================================================

# ================================================================
test_group("next_sample on an untriggered voice returns exact zero");
var dt_k = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), F64_HALF, f64_from(SR));
assert_eq(drum_kick_is_active(dt_k), 0, "a fresh kick is inactive");
assert_eq(drum_kick_next_sample(dt_k), 0, "an untriggered kick emits +0.0");
assert_eq(drum_kick_is_active(dt_k), 0, "polling an untriggered kick does not wake it");
var dt_s = drum_snare_new(f64_from(SR));
assert_eq(drum_snare_is_active(dt_s), 0, "a fresh snare is inactive");
assert_eq(drum_snare_next_sample(dt_s), 0, "an untriggered snare emits +0.0");
var dt_h = drum_hihat_new(0, f64_from(SR));
assert_eq(drum_hihat_is_active(dt_h), 0, "a fresh hi-hat is inactive");
assert_eq(drum_hihat_next_sample(dt_h), 0, "an untriggered hi-hat emits +0.0");

# ================================================================
test_group("kick next_sample: first sample and sweep start");
var dt_k1 = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), F64_HALF, f64_from(SR));
drum_kick_trigger(dt_k1);
# The body phase starts at 0, so sin(0)*body_amp contributes exactly +0.0 and
# the whole first sample is click = noise[0] * click_amp(1.0) * click_level.
# drum_kick_new seeds the exciter PRNG with 12345, so noise[0] is reproducible
# from an independent xorshift32 slot.
var dt_rng = alloc(8);
store64(dt_rng, 12345);
var dt_n0 = xorshift32_signed_f32(dt_rng);
assert_eq(drum_kick_next_sample(dt_k1), f64_mul(dt_n0, F64_HALF),
  "kick sample 0 == noise[0] * click_level (the sine body is exactly 0 at phase 0)");
# The sweep must START at start_freq: one sample advances the phase by
# exactly start_freq / sample_rate, not end_freq / sample_rate.
assert_eq(KickDrum_phase(dt_k1), f64_div(f64_from(150), f64_from(SR)),
  "the first phase step is start_freq / sample_rate");
assert_eq(drum_kick_is_active(dt_k1), 1, "the kick is active after trigger + one sample");

# ================================================================
test_group("kick click_level = 0 removes the transient");
var dt_k2 = drum_kick_new(f64_from(150), f64_from(50), f64_from(200), 0, f64_from(SR));
drum_kick_trigger(dt_k2);
assert_eq(drum_kick_next_sample(dt_k2), 0, "click_level 0 makes sample 0 exactly +0.0");
assert(drum_kick_next_sample(dt_k2) != 0, "sample 1 is the sine body, not silence");

# ================================================================
test_group("kick pitch sweep settles on end_freq");
var dt_k3 = drum_kick_new(f64_from(150), f64_from(50), f64_from(400), 0, f64_from(SR));
drum_kick_trigger(dt_k3);
var dt_w = 0;
while (dt_w < 8000) {
    var dt_x = drum_kick_next_sample(dt_k3);
    dt_w = dt_w + 1;
}
assert_eq(drum_kick_is_active(dt_k3), 1, "a 400 ms body is still ringing at 8000 samples");
var dt_p0 = KickDrum_phase(dt_k3);
var dt_x2 = drum_kick_next_sample(dt_k3);
var dt_p1 = KickDrum_phase(dt_k3);
var dt_dp = f64_sub(dt_p1, dt_p0);
if (f64_lt(dt_dp, 0) == 1) { dt_dp = f64_add(dt_dp, F64_ONE); }
# The pitch envelope has a 30 ms time constant, so by 8000 samples it is
# ~1e-18 and the instantaneous frequency is end_freq to well inside 1e-12.
assert(f64_lt(f64_abs(f64_sub(dt_dp, f64_div(f64_from(50), f64_from(SR)))), C1E_12),
  "the phase step converges on end_freq / sample_rate");

# ================================================================
# Deactivation timing. amp after n samples is exp(-6.9/decay_samples)^n and
# the voice deactivates at the first n with amp < 1e-6, i.e.
# n = decay_samples * ln(1e6) / 6.9 = 2.0022 * decay_samples. The existing
# groups above only prove "silent after 102400 samples"; these bound the
# decay to a few percent, so a wrong DRUM_NEG_6_9 or a wrong decay window
# would fail here.
# ================================================================
test_group("voice deactivation matches the envelope constants");
# Kick body 200 ms -> 8820 samples -> n ~ 17660.
assert_eq(_dt_kick_active_after(17000), 1, "kick still active at 17000 samples");
assert_eq(_dt_kick_active_after(18000), 0, "kick has deactivated by 18000 samples");
# Snare: the 150 ms noise envelope outlives the 100 ms tone, so the AND of
# both thresholds lands at n ~ 13245 (6615 samples * 2.0022).
assert_eq(_dt_snare_active_after(13000), 1, "snare still active at 13000 samples");
assert_eq(_dt_snare_active_after(13500), 0, "snare has deactivated by 13500 samples");
# Closed hi-hat 30 ms -> 1323 samples -> n ~ 2649.
assert_eq(_dt_hat_active_after(0, 2600), 1, "closed hi-hat still active at 2600 samples");
assert_eq(_dt_hat_active_after(0, 2700), 0, "closed hi-hat has deactivated by 2700 samples");
# Open hi-hat 200 ms -> 8820 samples -> n ~ 17660. `open` is otherwise
# untested: it must ring far past where the closed hat has stopped.
assert_eq(_dt_hat_active_after(1, 2700), 1, "open hi-hat is still ringing where the closed one has stopped");
assert_eq(_dt_hat_active_after(1, 17000), 1, "open hi-hat still active at 17000 samples");
assert_eq(_dt_hat_active_after(1, 18000), 0, "open hi-hat has deactivated by 18000 samples");

# ================================================================
test_group("a dead voice stays silent and frozen");
var dt_h9 = drum_hihat_new(0, f64_from(SR));
drum_hihat_trigger(dt_h9);
var dt_i = 0;
while (dt_i < 4000) {
    var dt_y = drum_hihat_next_sample(dt_h9);
    dt_i = dt_i + 1;
}
assert_eq(drum_hihat_is_active(dt_h9), 0, "the closed hi-hat is dead by 4000 samples");
var dt_amp = HiHat_amp(dt_h9);
assert_eq(drum_hihat_next_sample(dt_h9), 0, "a dead hi-hat emits +0.0");
assert_eq(HiHat_amp(dt_h9), dt_amp, "a dead hi-hat does not keep advancing its envelope");

# ================================================================
test_group("next_sample and fill_buffer are the same generator");
# Two identically-constructed voices share a PRNG seed, so the two paths must
# agree bit for bit across 512 samples -- and the helpers reject an all-zero
# stream, so an unwritten buffer cannot pass by matching silence.
assert_eq(_dt_kick_streams_match(512), 1, "kick: 512 samples bit-identical via both paths");
assert_eq(_dt_snare_streams_match(512), 1, "snare: 512 samples bit-identical via both paths");
assert_eq(_dt_hat_streams_match(512), 1, "hi-hat: 512 samples bit-identical via both paths");

var rc = assert_summary();
syscall(60, rc);
