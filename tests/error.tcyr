# error.tcyr -- parity tests for src/error.cyr
# Ported from the #[test] blocks in rust-old/src/error.rs. The Display-string
# and serde round-trip tests are dropped (integer error codes, no serde);
# the validate_* behavioural tests are the parity-meaningful ones. Adds direct
# coverage of the lib.rs helpers folded in here (flush_denormal, naad_is_finite).

include "src/error.cyr"

alloc_init();

var NAN_BITS      = 0x7FF8000000000000;   # canonical quiet NaN
var DENORMAL_BITS = 0x37a16c262777579c;   # 1e-40 (< f32::MIN_POSITIVE)
var NORMAL_SMALL  = 0x39b4484bfeebc2a0;   # 1e-30 (> f32::MIN_POSITIVE)

# ================================================================
test_group("validate_frequency");
assert_eq(validate_frequency(f64_from(440), f64_from(44100)), NAAD_ERR_NONE, "440 Hz @ 44100 is valid");
assert_eq(validate_frequency(0, f64_from(44100)), NAAD_ERR_INVALID_FREQUENCY, "0 Hz too low");
assert_eq(validate_frequency(f64_neg(F64_ONE), f64_from(44100)), NAAD_ERR_INVALID_FREQUENCY, "-1 Hz too low");
assert_eq(validate_frequency(f64_from(23000), f64_from(44100)), NAAD_ERR_INVALID_FREQUENCY, "23 kHz above Nyquist");
assert_eq(validate_frequency(NAN_BITS, f64_from(44100)), NAAD_ERR_INVALID_FREQUENCY, "NaN frequency invalid");
assert_eq(validate_frequency(NAAD_POS_INF, f64_from(44100)), NAAD_ERR_INVALID_FREQUENCY, "+inf frequency invalid");

# ================================================================
test_group("validate_sample_rate");
assert_eq(validate_sample_rate(f64_from(44100)), NAAD_ERR_NONE, "44100 valid");
assert_eq(validate_sample_rate(0), NAAD_ERR_INVALID_SAMPLE_RATE, "0 invalid");
assert_eq(validate_sample_rate(f64_neg(F64_ONE)), NAAD_ERR_INVALID_SAMPLE_RATE, "-1 invalid");
assert_eq(validate_sample_rate(NAN_BITS), NAAD_ERR_INVALID_SAMPLE_RATE, "NaN invalid");
assert_eq(validate_sample_rate(NAAD_POS_INF), NAAD_ERR_INVALID_SAMPLE_RATE, "+inf invalid");

# ================================================================
test_group("naad_is_finite");
assert_eq(naad_is_finite(f64_from(440)), 1, "440 is finite");
assert_eq(naad_is_finite(0), 1, "0 is finite");
assert_eq(naad_is_finite(NAN_BITS), 0, "NaN not finite");
assert_eq(naad_is_finite(NAAD_POS_INF), 0, "+inf not finite");
assert_eq(naad_is_finite(NAAD_NEG_INF), 0, "-inf not finite");

# ================================================================
test_group("flush_denormal");
assert_eq(flush_denormal(DENORMAL_BITS), 0, "denormal flushes to +0.0");
assert_eq(flush_denormal(NORMAL_SMALL), NORMAL_SMALL, "1e-30 preserved (above threshold)");
assert_eq(flush_denormal(F64_ONE), F64_ONE, "1.0 preserved");
assert_eq(flush_denormal(0), 0, "0.0 preserved");

# ================================================================
test_group("error codes");
assert_eq(naad_is_err(NAAD_ERR_NONE), 0, "NAAD_ERR_NONE is not an error");
assert_eq(naad_is_err(NAAD_ERR_INVALID_FREQUENCY), 1, "negative code is an error");
assert_streq(naad_err_name(NAAD_ERR_COMPUTATION), "computation error", "err name maps");

# ================================================================
test_group("naad_vec_zeros and naad_vec_copy");
# The helpers write the vec header directly, so these fail if lib/vec.cyr moves it.
fn vec_is_zeros(v, n) {
    if (vec_len(v) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (vec_get(v, i) != 0) { return 0; }
        i = i + 1;
    }
    return 1;
}
assert_eq(vec_is_zeros(naad_vec_zeros(0), 0), 1, "an empty vec");
assert_eq(vec_is_zeros(naad_vec_zeros(16), 16), 1, "exactly vec_new's capacity");
assert_eq(vec_is_zeros(naad_vec_zeros(17), 17), 1, "one past it");
assert_eq(vec_is_zeros(naad_vec_zeros(100000), 100000), 1, "sized once");
var vz = naad_vec_zeros(17);
assert_eq(vec_cap(vz), 17, "exactly the size asked for");
vec_push(vz, 5);
assert_eq(vec_len(vz), 18, "a sized vec still grows");
assert_eq(vec_get(vz, 17), 5, "and keeps the pushed value");
assert_eq(vec_get(vz, 16), 0, "and what it held");

var vc_src = vec_new();
vec_push(vc_src, 7);
vec_push(vc_src, 9);
var vc = naad_vec_copy(vc_src);
assert_eq(vec_len(vc), 2, "a copy has the same length");
assert_eq(vec_get(vc, 1), 9, "and the same elements");
vec_set(vc_src, 0, 1);
assert_eq(vec_get(vc, 0), 7, "a write to the source does not reach the copy");
vec_truncate(vc_src, 0);
assert_eq(vec_len(vc), 2, "nor does truncating it");
assert_eq(vec_len(naad_vec_copy(vec_new())), 0, "an empty source copies to an empty vec");

var rc = assert_summary();
syscall(60, rc);
