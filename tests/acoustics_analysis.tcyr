# acoustics_analysis.tcyr -- parity test for src/acoustics_analysis.cyr.
# Ports the #[test] blocks from rust-old/src/acoustics/analysis.rs one-for-one.
# The two serde-roundtrip tests (test_serde_roundtrip, test_advice_serde_roundtrip)
# are dropped (Cyrius has no serde). Rust's `.unwrap()` / Result becomes: success
# is a positive struct/vec pointer (naad_is_err == 0), failure is a negative
# NAAD_ERR_* code (naad_is_err == 1). f32::is_finite -> naad_is_finite.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "src/error.cyr"
include "src/acoustics.cyr"
include "src/acoustics_room.cyr"
include "src/acoustics_analysis.cyr"

# Synthetic exponentially decaying impulse response: exp(-decay_rate * t) for
# i in 0..(sample_rate * duration_secs), t = i / sample_rate. A vec of f64.
# Ports the test-local synthetic_ir helper.
fn synthetic_ir(sample_rate, duration_secs, decay_rate) {
    var len = f64_to(f64_mul(f64_from(sample_rate), duration_secs));
    var v = vec_new();
    var i = 0;
    while (i < len) {
        var t = f64_div(f64_from(i), f64_from(sample_rate));
        vec_push(v, f64_exp(f64_mul(f64_neg(decay_rate), t)));
        i = i + 1;
    }
    return v;
}

# The oracle's live_room(): an 8 x 6 x 4 m concrete shoebox at 48 kHz, source
# and listener co-located at [4, 2, 3]. Parameterized on `length` and `material`
# so the invalid-dimension / unknown-material variants reuse it.
fn make_room(length, material) {
    var src = hvec3_new(f64_from(4), F64_TWO, f64_from(3));
    var lis = hvec3_new(f64_from(4), F64_TWO, f64_from(3));
    return naad_room_reverb_config_new(length, f64_from(6), f64_from(4),
      material, src, lis, 48000);
}

fn live_room() { return make_room(f64_from(8), "concrete"); }

# --- distinct field values for the struct-literal round-trips (IEEE-754) ---
var AN_C50  = 0x4029000000000000;   # 12.5   (dB)
var AN_C80  = 0xc01d000000000000;   # -7.25  (dB)
var AN_D50  = 0x3fec000000000000;   # 0.875
var AN_STI  = 0x3fdae147ae147ae1;   # 0.42
var AN_RT60 = 0x400e000000000000;   # 3.75   (seconds)
var AN_SENS = 0xc00c000000000000;   # -3.5   (s per unit absorption)
var AN_ABS  = 0x3fe3333333333333;   # 0.6

alloc_init();

# ================================================================
test_group("analyze_synthetic_ir");
var t1_ir = synthetic_ir(48000, F64_ONE, f64_from(5));
var t1_m = naad_analysis_analyze_impulse_response(t1_ir, 48000);
assert_eq(naad_is_err(t1_m), 0, "analyze should succeed");
assert_eq(naad_is_finite(RoomMetrics_c50(t1_m)), 1, "C50 should be finite");
assert_eq(naad_is_finite(RoomMetrics_c80(t1_m)), 1, "C80 should be finite");
assert_eq(naad_is_finite(RoomMetrics_d50(t1_m)), 1, "D50 should be finite");
assert_eq(naad_is_finite(RoomMetrics_sti(t1_m)), 1, "STI should be finite");
assert_eq(naad_is_finite(RoomMetrics_rt60(t1_m)), 1, "RT60 should be finite");
assert(f64_gt(RoomMetrics_rt60(t1_m), 0), "RT60 should be positive");

# ================================================================
test_group("empty_ir_errors");
var t2_m = naad_analysis_analyze_impulse_response(vec_new(), 48000);
assert_eq(naad_is_err(t2_m), 1, "empty IR -> error");

# ================================================================
test_group("zero_sample_rate_errors");
var t3_ir = vec_new();
vec_push(t3_ir, F64_ONE);
vec_push(t3_ir, F64_HALF);
var t3_m = naad_analysis_analyze_impulse_response(t3_ir, 0);
assert_eq(naad_is_err(t3_m), 1, "zero sample rate -> error");

# ================================================================
test_group("estimate_rt60_basic");
var t4_rt60 = naad_analysis_estimate_rt60(synthetic_ir(48000, F64_TWO, f64_from(3)), 48000);
assert(f64_gt(t4_rt60, 0), "RT60 should be positive");
assert_eq(naad_is_finite(t4_rt60), 1, "RT60 should be finite");

# ================================================================
test_group("estimate_rt60_empty");
# Raw f64 bits (+0.0 == 0), not f64_to: truncation made this hold for every
# RT60 in (-1.0, 1.0) -- i.e. most of the realistic output range. The oracle
# asserts exact equality (rust-old/src/acoustics/analysis.rs:212).
assert_eq(naad_analysis_estimate_rt60(vec_new(), 48000), 0, "empty RT60 = 0.0");

# ================================================================
test_group("suggest_absorption_returns_advice");
var t7_advice = naad_analysis_suggest_absorption(live_room(), F64_HALF);
assert_eq(naad_is_err(t7_advice), 0, "suggest should succeed");
assert(f64_gt(f64_from(vec_len(t7_advice)), 0), "should return suggestions for shoebox");
var t7_ok = 1;
var t7_i = 0;
var t7_n = vec_len(t7_advice);
while (t7_i < t7_n) {
    var t7_a = vec_get(t7_advice, t7_i);
    if (naad_is_finite(WallAbsorptionAdvice_rt60_sensitivity(t7_a)) == 0) { t7_ok = 0; }
    if (naad_is_finite(WallAbsorptionAdvice_current_absorption(t7_a)) == 0) { t7_ok = 0; }
    t7_i = t7_i + 1;
}
assert_eq(t7_ok, 1, "all advice fields finite");

# ================================================================
test_group("suggest_absorption_invalid_material");
var t8_advice = naad_analysis_suggest_absorption(make_room(f64_from(8), "kryptonite"), F64_HALF);
assert_eq(naad_is_err(t8_advice), 1, "unknown material -> error");

# ================================================================
test_group("suggest_absorption_invalid_dimensions");
var t9_advice = naad_analysis_suggest_absorption(make_room(f64_neg(F64_ONE), "concrete"), F64_HALF);
assert_eq(naad_is_err(t9_advice), 1, "negative dimension -> error");

# ================================================================
# Negative sample_rate. Bump-attributable for analyze_impulse_response: goonj
# 2.0.2 widened _analysis_clarity's `rate == 0` guard to `rate <= 0`, which
# turned what had been a loud `vec: index < 0` process abort into a fully
# populated RoomMetrics reporting a NEGATIVE RT60 with naad_is_err == 0 --
# every downstream is_err/finiteness check passing on wrong data.
# estimate_rt60 is a separate entry point and needs its own assertion.
# ================================================================
test_group("negative sample rate is rejected");
var tn_ir = vec_new();
vec_push(tn_ir, F64_ONE);
vec_push(tn_ir, F64_HALF);
assert_eq(naad_is_err(naad_analysis_analyze_impulse_response(tn_ir, 0 - 48000)), 1, "negative sample rate -> error");
# Raw f64 bits, not f64_to: +0.0 is the bit pattern 0. Comparing through
# f64_to would truncate and hold for the whole open interval (-1.0, 1.0).
assert_eq(naad_analysis_estimate_rt60(synthetic_ir(48000, F64_TWO, f64_from(3)), 0 - 48000), 0, "negative rate RT60 = +0.0");

# ================================================================
# naad_analysis_room_metrics_new is the RoomMetrics struct literal. The only
# meaningful assertion is the exact field round-trip, so give all five fields
# DISTINCT, non-zero, differently-signed values: any field crossed with
# another, or a dropped store, changes at least one readback. Bits are
# compared raw (a Cyrius f64 is an i64 pattern) -- f64_to would truncate every
# one of these toward zero and pass on almost any wrong answer.
# ================================================================
test_group("room_metrics_new_field_roundtrip");
var rm = naad_analysis_room_metrics_new(AN_C50, AN_C80, AN_D50, AN_STI, AN_RT60);
assert_eq(RoomMetrics_c50(rm), AN_C50, "c50 stored exactly (12.5 dB)");
assert_eq(RoomMetrics_c80(rm), AN_C80, "c80 stored exactly (-7.25 dB)");
assert_eq(RoomMetrics_d50(rm), AN_D50, "d50 stored exactly (0.875)");
assert_eq(RoomMetrics_sti(rm), AN_STI, "sti stored exactly (0.42)");
assert_eq(RoomMetrics_rt60(rm), AN_RT60, "rt60 stored exactly (3.75 s)");
# No two fields alias each other.
assert_neq(RoomMetrics_c50(rm), RoomMetrics_c80(rm), "c50 and c80 are distinct slots");
assert_neq(RoomMetrics_d50(rm), RoomMetrics_sti(rm), "d50 and sti are distinct slots");
assert_neq(RoomMetrics_sti(rm), RoomMetrics_rt60(rm), "sti and rt60 are distinct slots");
# +0.0 must survive as +0.0, not be confused with an unwritten slot: build a
# second record whose fields are all zero except one and read every slot back.
var rm0 = naad_analysis_room_metrics_new(0, 0, 0, 0, AN_RT60);
assert_eq(RoomMetrics_c50(rm0), 0, "zero c50 stored as +0.0");
assert_eq(RoomMetrics_c80(rm0), 0, "zero c80 stored as +0.0");
assert_eq(RoomMetrics_d50(rm0), 0, "zero d50 stored as +0.0");
assert_eq(RoomMetrics_sti(rm0), 0, "zero sti stored as +0.0");
assert_eq(RoomMetrics_rt60(rm0), AN_RT60, "rt60 unaffected by zeroed neighbours");
# Two records are independent allocations.
assert_neq(rm, rm0, "each call allocates a distinct RoomMetrics");
assert_eq(RoomMetrics_c50(rm), AN_C50, "first record survives a second construction");

# ================================================================
# naad_analysis_wall_absorption_advice_new is the WallAbsorptionAdvice struct
# literal. wall_index is a plain integer, rt60_sensitivity is SIGNED (negative
# = treating this wall shortens reverb, the useful direction), and
# current_absorption is a 0..1 fraction. Exact round-trip on all three.
# ================================================================
test_group("wall_absorption_advice_new_field_roundtrip");
var wa = naad_analysis_wall_absorption_advice_new(3, AN_SENS, AN_ABS);
assert_eq(WallAbsorptionAdvice_wall_index(wa), 3, "wall_index stored exactly");
assert_eq(WallAbsorptionAdvice_rt60_sensitivity(wa), AN_SENS, "negative sensitivity stored exactly (-3.5)");
assert_eq(WallAbsorptionAdvice_current_absorption(wa), AN_ABS, "current_absorption stored exactly (0.6)");
assert_neq(WallAbsorptionAdvice_rt60_sensitivity(wa), WallAbsorptionAdvice_current_absorption(wa),
  "sensitivity and absorption are distinct slots");
# Index 0 (the floor) is a real wall, not a missing value.
var wa0 = naad_analysis_wall_absorption_advice_new(0, 0, AN_D50);
assert_eq(WallAbsorptionAdvice_wall_index(wa0), 0, "wall_index 0 (floor) stored exactly");
assert_eq(WallAbsorptionAdvice_rt60_sensitivity(wa0), 0, "zero sensitivity stored as +0.0");
assert_eq(WallAbsorptionAdvice_current_absorption(wa0), AN_D50, "absorption unaffected by a zeroed neighbour");
assert_neq(wa, wa0, "each call allocates a distinct WallAbsorptionAdvice");
assert_eq(WallAbsorptionAdvice_wall_index(wa), 3, "first record survives a second construction");

# The two constructors are what naad_analysis_suggest_absorption /
# analyze_impulse_response build their results with, so the advice vec's
# records must carry goonj's values through unchanged, field for field.
test_group("constructors_carry_goonj_values_through");
var cg_room = live_room();
var cg_material = naad_acoustics_material_by_name("concrete");
var cg_goonj = suggest_absorption_placement(
  acoustic_room_shoebox(f64_from(8), f64_from(6), f64_from(4), cg_material), F64_HALF);
var cg_advice = naad_analysis_suggest_absorption(cg_room, F64_HALF);
assert_eq(naad_is_err(cg_advice), 0, "suggest_absorption should succeed");
assert_eq(vec_len(cg_advice), vec_len(cg_goonj), "one advice record per goonj suggestion");
# Non-vacuity guard: with both vecs empty the field-by-field loop below never
# runs and cg_ok stays 1, so the comparison would assert nothing.
assert_gt(vec_len(cg_goonj), 0, "goonj returned at least one suggestion to compare against");
var cg_ok = 1;
var cg_i = 0;
while (cg_i < vec_len(cg_goonj)) {
    var cg_s = vec_get(cg_goonj, cg_i);
    var cg_a = vec_get(cg_advice, cg_i);
    if (WallAbsorptionAdvice_wall_index(cg_a) != AbsorptionSuggestion_wall_index(cg_s)) { cg_ok = 0; }
    if (WallAbsorptionAdvice_rt60_sensitivity(cg_a) != AbsorptionSuggestion_rt60_sensitivity(cg_s)) { cg_ok = 0; }
    if (WallAbsorptionAdvice_current_absorption(cg_a) != AbsorptionSuggestion_current_absorption(cg_s)) { cg_ok = 0; }
    cg_i = cg_i + 1;
}
assert_eq(cg_ok, 1, "advice fields are goonj's values, bit for bit and in order");

var rc = assert_summary();
syscall(60, rc);
