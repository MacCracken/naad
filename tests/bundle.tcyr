# bundle.tcyr -- cross-layer smoke test for the dist/naad.cyr distlib bundle.
# Includes the single concatenated bundle (+ its consumer deps hisab/goonj)
# and exercises one symbol from each major layer, proving the 39 modules
# coexist and link in one flat namespace.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "dist/naad.cyr"

alloc_init();

test_group("bundle: base + dsp_util");
assert_eq(validate_frequency(f64_from(440), f64_from(44100)), NAAD_ERR_NONE, "error base");
assert_eq(flush_denormal(0), 0, "flush_denormal");
assert(f64_lt(f64_abs(f64_sub(lerp(0, F64_ONE, F64_HALF), F64_HALF)), NAAD_EPSILON), "dsp_util lerp");

test_group("bundle: noise + oscillator");
var ng = noise_new(NOISE_WHITE, 42);
assert(naad_is_finite(noise_next_sample(ng)), "noise layer");
var osc = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
assert(naad_is_finite(osc_next_sample(osc)), "oscillator layer");
var posc = osc_new(WAVEFORM_PINK_NOISE, f64_from(440), f64_from(44100));
assert(naad_is_finite(osc_next_sample(posc)), "oscillator pink (noise-backed) layer");

test_group("bundle: dsp_spectral (hisab FFT)");
var sig = vec_new();
var i = 0;
while (i < 8) {
    vec_push(sig, f64_sin(f64_div(f64_mul(F64_TAU, f64_from(i)), f64_from(8))));
    i = i + 1;
}
var mags = fft_magnitudes(sig);
assert_eq(vec_len(mags), 5, "fft_magnitudes bins = n/2+1");

test_group("bundle: acoustics (goonj-backed)");
assert(naad_acoustics_material_by_name("concrete") != 0, "acoustics material base");
assert_eq(naad_acoustics_material_by_name("nope"), 0, "unknown material -> None");

test_group("bundle: naad/goonj error-code namespace");
# Until 2.1.3 naad and goonj both defined bare `ERR_NONE`,
# `ERR_INVALID_FREQUENCY` and `ERR_COMPUTATION` at top level, in one flat
# namespace. Two agreed by value; `ERR_INVALID_FREQUENCY` did NOT (naad -1,
# goonj -3), so which one you got depended on include order -- and duplicate
# top-level `var`s draw no diagnostic from cycc or cyrlint, unlike duplicate
# `fn`s, so nothing would have reported it. naad's six codes now carry the
# `NAAD_ERR_` prefix and the intersection is empty by construction.
#
# This is the assertion that was IMPOSSIBLE before the rename: both libraries'
# frequency codes are visible at once, each with its own distinct value. Under
# the old names there was only ever one symbol here.
assert_eq(NAAD_ERR_INVALID_FREQUENCY, 0 - 1, "naad's own frequency code is -1");
assert_eq(ERR_INVALID_FREQUENCY, 0 - 3, "goonj's frequency code is -3 and no longer shadowed");
assert(NAAD_ERR_INVALID_FREQUENCY != ERR_INVALID_FREQUENCY, "naad and goonj frequency codes are now distinct symbols");
# The two that always agreed by value are now also distinct symbols, so a
# future divergence on either side cannot silently rewrite the other.
assert_eq(NAAD_ERR_NONE, 0, "naad success code");
assert_eq(NAAD_ERR_COMPUTATION, 0 - 5, "naad computation code");
assert_eq(ERR_COMPUTATION, 0 - 5, "goonj computation code, independently addressable");

var rc = assert_summary();
syscall(60, rc);
