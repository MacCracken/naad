# hardening.tcyr -- the 2.1.3 P-1 hardening suite.
#
# Every assertion here is a NEGATIVE case: an out-of-range enum id, a negative
# count, a NaN, or an oversized input. The 505-assertion parity suite contains
# none of these, which is exactly why every defect this file pins survived to
# 2.1.3 with the suite green.
#
# Kept in its own file deliberately. Most of these cases ABORT THE PROCESS
# before the fix (SIGSEGV 139, SIGFPE 136, or exit 1 from `_vec_die`), not
# merely fail an assertion. In a shared suite a pre-fix run dies partway through
# and prints a confusing partial result; here the signal exit is unmistakable.
#
# Two classes of defect are pinned, both consequences of Cyrius semantics rather
# than of the algorithms:
#   1. Rust `usize`/enum guarantees erased by Cyrius's signed i64 -- a single
#      upper-bound test is only HALF a bound.
#   2. `f64_to` disagreeing with Rust's `as` casts. A negative value stays
#      negative where Rust gives 0. Below cyrius 6.6.8 every overflow and NaN
#      was INT64_MIN; since then +overflow is INT64_MAX and NaN is 0, which is
#      why the length guards in group B1 exist.
#
# Runs against the shipped bundle (dist/naad.cyr), i.e. exactly the surface a
# consumer links. Regenerate with `cyrius distlib` after changing src/.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "dist/naad.cyr"

alloc_init();

var H_C0_5 = 0x3FE0000000000000;   # 0.5
var H_ONE  = 0x3FF0000000000000;   # 1.0
var H_TWO  = 0x4000000000000000;   # 2.0

# ================================================================
# A1 -- osc_new accepts any integer waveform.
# Pre-fix: osc_new(8, ...) returns a VALID pointer with noise_gen null, and the
# first osc_next_sample dereferences it -> SIGSEGV. The oracle matches an
# 8-variant enum exhaustively AND carries an `else { 0.0 }` arm
# (rust-old/src/oscillator/core.rs:189-197), so both halves are parity.
# ================================================================
test_group("A1: osc_new rejects an out-of-range waveform");
assert_eq(naad_is_err(osc_new(8, f64_from(440), f64_from(44100))), 1, "waveform 8 rejected");
assert_eq(naad_is_err(osc_new(0 - 1, f64_from(440), f64_from(44100))), 1, "waveform -1 rejected");
# Controls: every valid id still constructs.
var a1i = 0;
var a1_ok = 1;
while (a1i < 8) {
    if (naad_is_err(osc_new(a1i, f64_from(440), f64_from(44100))) == 1) { a1_ok = 0; }
    a1i = a1i + 1;
}
assert(a1_ok, "all 8 valid waveforms still construct");

# The public derive accessor can still reach the noise arm with a null generator;
# this is what proves the `else` guard rather than the constructor guard.
test_group("A1: noise dispatch survives a null generator");
var a1o = osc_new(WAVEFORM_SINE, f64_from(440), f64_from(44100));
Oscillator_set_waveform(a1o, 8);
assert_eq(naad_is_finite(osc_next_sample(a1o)), 1, "null noise_gen yields silence, not a fault");

# ================================================================
# A2 -- bspline_eval_1d had no `degree < 0` guard. degree <= -2 drives n_knots
# to 0 while interior_count grows, so the knot loop stores out of bounds (or
# through a null for degree <= -(n+1)). Oracle types degree `usize`.
# ================================================================
test_group("A2: bspline_eval_1d rejects a non-positive degree");
var a2cps = vec_new();
vec_push(a2cps, H_ONE);
vec_push(a2cps, H_TWO);
vec_push(a2cps, H_ONE);
assert_eq(naad_is_finite(bspline_eval_1d(0 - 4, a2cps, H_C0_5)), 0, "degree -4 -> NaN, not an OOB store");
assert_eq(naad_is_finite(bspline_eval_1d(0 - 2, a2cps, H_C0_5)), 0, "degree -2 -> NaN");
# Control: the pre-existing `== 0` rejection must survive widening to `<= 0`.
assert_eq(naad_is_finite(bspline_eval_1d(0, a2cps, H_C0_5)), 0, "control: degree 0 still rejected");

# ================================================================
# A3 -- wavetable_from_harmonics guarded `size == 0` but not `size < 0`, so a
# negative size produced an EMPTY samples vec behind a valid pointer; the first
# read then did `floor_i % 0` -> SIGFPE. Oracle takes `size: usize`.
# ================================================================
test_group("A3: wavetable_from_harmonics rejects negative counts");
var a3amps = vec_new();
vec_push(a3amps, H_ONE);
assert_eq(naad_is_err(wavetable_from_harmonics(1, a3amps, 0 - 64)), 1, "negative size rejected");
assert_eq(naad_is_err(wavetable_from_harmonics(0 - 1, a3amps, 128)), 1, "negative harmonics rejected");
assert_eq(naad_is_err(wavetable_from_harmonics(1, a3amps, 0)), 1, "control: zero size still rejected");
assert_eq(naad_is_err(wavetable_from_harmonics(1, a3amps, 128)), 0, "control: valid table still builds");

# ================================================================
# A4 -- fm_engine_new guarded `== 0` only; a negative count left `operators`
# empty and the default SERIAL2 algorithm did vec_get(operators, 0) -> abort.
# ================================================================
test_group("A4: fm_engine_new rejects a negative operator count");
assert_eq(naad_is_err(fm_engine_new(0 - 1, f64_from(44100))), 1, "negative operator count rejected");
assert_eq(naad_is_err(fm_engine_new(0, f64_from(44100))), 1, "control: zero still rejected");
assert_eq(naad_is_err(fm_engine_new(4, f64_from(44100))), 0, "control: 4 operators still valid");

# ================================================================
# A6 -- filter_biquad's coefficient chain had no `else`, so an out-of-range
# type left a0 at +0.0, made every coefficient NaN, and latched NaN into z1/z2
# permanently (reset clears state but not coefficients). Oracle matches an
# 8-variant enum with no `_ =>` arm.
# ================================================================
test_group("A6: filter_biquad rejects an out-of-range filter type");
assert_eq(naad_is_err(filter_biquad_new(8, f64_from(44100), f64_from(1000), H_ONE)), 1, "type 8 rejected");
assert_eq(naad_is_err(filter_biquad_new(0 - 1, f64_from(44100), f64_from(1000), H_ONE)), 1, "type -1 rejected");
var a6eq = eq_parametric_new(f64_from(44100));
assert_eq(naad_is_err(eq_add_band(a6eq, 8, f64_from(1000), H_ONE, 0)), 1, "eq_add_band forwards the rejection");

# The half that matters: the public setter can still reach the chain.
test_group("A6: coefficient chain never publishes NaN");
var a6f = filter_biquad_new(NAAD_FILTER_LOWPASS, f64_from(44100), f64_from(1000), H_ONE);
BiquadFilter_set_filter_type(a6f, 8);
filter_biquad_compute_coefficients(a6f);
assert_eq(naad_is_finite(filter_biquad_process_sample(a6f, H_C0_5)),
  1, "unknown type -> unity pass-through, not NaN");

# ================================================================
# A7 -- tuning_table_custom validated ratio VALUES but not the COUNT. The
# oracle's parameter is `[f32; 12]`, so the length was a type invariant;
# erasing it to a vec dropped it, and tuning_note_to_freq reads index 9
# unconditionally -> abort on the first lookup.
# ================================================================
test_group("A7: tuning_table_custom enforces exactly 12 ratios");
var a7short = vec_new();
vec_push(a7short, H_ONE);
vec_push(a7short, H_TWO);
vec_push(a7short, H_ONE);
assert_eq(naad_is_err(tuning_table_custom("three", a7short, f64_from(440))), 1, "3 ratios rejected");
var a7r = vec_new();
var a7i = 0;
while (a7i < 12) { vec_push(a7r, H_ONE); a7i = a7i + 1; }
assert_eq(naad_is_err(tuning_table_custom("twelve", a7r, f64_from(440))), 0, "control: 12 ratios accepted");
vec_push(a7r, H_ONE);
assert_eq(naad_is_err(tuning_table_custom("thirteen", a7r, f64_from(440))), 1,
  "13 ratios rejected (!= 12, not just non-empty)");

# ================================================================
# A8 -- the f64_to truncation cluster. Rust's `as usize` SATURATES; f64_to does
# not. These were written against the pre-6.6.8 cast, where every overflow and
# NaN came back INT64_MIN.
#
# NOTE the buffer lengths below are deliberately NON-POWER-OF-TWO. INT64_MIN %
# 1024 == 0, so with a power-of-two length the pre-fix code lands on index 0 and
# the test passes WITHOUT the fix. Audio buffers are habitually power-of-two,
# which is precisely why the parity suite never caught this.
# ================================================================
test_group("A8: db_to_amplitude_lut saturates its index");
assert_eq(naad_is_finite(db_to_amplitude_lut(SPEC_NAN)), 0, "NaN dB -> NaN out (matches Rust), not an abort");

test_group("A8: wavetable_read_interpolated saturates its index");
var a8amps = vec_new();
vec_push(a8amps, H_ONE);
var a8wt = wavetable_from_harmonics(1, a8amps, 100);   # 100, NOT 128
assert_eq(naad_is_finite(wavetable_read_interpolated(a8wt, SPEC_NAN)), 0, "NaN phase -> NaN, not an abort");

test_group("A8: morph wavetables saturate their table index");
var a8tables = vec_new();
vec_push(a8tables, wavetable_from_harmonics(1, a8amps, 100));
vec_push(a8tables, wavetable_from_harmonics(2, a8amps, 100));
var a8m = wavetable_morph_new(a8tables, f64_from(440), f64_from(44100));
wavetable_morph_set_morph(a8m, SPEC_NAN);
assert_eq(naad_is_finite(wavetable_morph_next_sample(a8m)), 0, "NaN morph position -> NaN, not an abort");

var a8t4 = vec_new();
vec_push(a8t4, wavetable_from_harmonics(1, a8amps, 100));
vec_push(a8t4, wavetable_from_harmonics(2, a8amps, 100));
vec_push(a8t4, wavetable_from_harmonics(3, a8amps, 100));
vec_push(a8t4, wavetable_from_harmonics(4, a8amps, 100));
var a8m4 = wavetable_morph_new(a8t4, f64_from(440), f64_from(44100));
wavetable_morph_set_morph(a8m4, SPEC_NAN);
assert_eq(naad_is_finite(wavetable_morph_next_sample_smooth(a8m4)), 0,
  "NaN morph (B-spline path) -> NaN, not an abort");

test_group("A8: granular read index saturates");
var a8src = vec_new();
var a8i = 0;
while (a8i < 1000) { vec_push(a8src, H_C0_5); a8i = a8i + 1; }   # 1000, NOT 1024
var a8g = granular_new(f64_from(44100));
granular_set_source(a8g, a8src);
granular_set_position(a8g, SPEC_NAN);
var a8ok = 1;
a8i = 0;
while (a8i < 4096) {
    if (naad_is_finite(granular_next_sample(a8g)) == 2) { a8ok = 0; }
    a8i = a8i + 1;
}
assert(a8ok, "NaN grain position never aborts the process");

# ================================================================
# A9 -- the LFO shape was never validated. The dispatch chain has no default
# and fell through to the sample-and-hold slot, whose re-roll is itself gated
# on shape == SAMPLE_AND_HOLD -- so the LFO emitted a FROZEN DC value forever.
# Plausible-looking, completely wrong audio, with no error anywhere.
# ================================================================
test_group("A9: LFO shape is validated");
assert_eq(naad_is_err(modulation_lfo_new(6, f64_from(2), f64_from(44100))), 1, "shape 6 rejected");
assert_eq(naad_is_err(modulation_lfo_new(0 - 1, f64_from(2), f64_from(44100))), 1, "shape -1 rejected");
var a9l = modulation_lfo_new(MODULATION_LFO_SINE, f64_from(2), f64_from(44100));
assert_eq(naad_is_err(modulation_lfo_set_shape(a9l, 42)), 1, "setter rejects shape 42");
assert_eq(modulation_lfo_set_shape(a9l, MODULATION_LFO_TRIANGLE), 0, "control: valid shape still accepted");

# The wrong-audio symptom itself: a valid LFO must actually move.
var a9moved = 0;
var a9first = modulation_lfo_next_value(a9l);
var a9i = 0;
while (a9i < 512) {
    if (f64_eq(modulation_lfo_next_value(a9l), a9first) == 0) { a9moved = 1; }
    a9i = a9i + 1;
}
assert(a9moved, "a valid LFO modulates rather than emitting frozen DC");

# ================================================================
# A10 -- mod_matrix source/destination ids were unvalidated where the oracle
# used the ModSource / ModDestination enums. The scratch vecs hold exactly 8
# slots, so an out-of-range id aborted out of a public setter.
# ================================================================
test_group("A10: mod_matrix validates source and destination ids");
var a10m = mod_matrix_new();
assert_eq(naad_is_err(mod_matrix_set_source(a10m, 8, H_ONE)), 1, "source 8 rejected");
assert_eq(naad_is_err(mod_matrix_set_source(a10m, 0 - 1, H_ONE)), 1, "source -1 rejected");
assert_eq(mod_matrix_set_source(a10m, 0, H_ONE), 0, "control: source 0 accepted");
# f64 return -> no error channel; out-of-range reads as "nothing targets it".
assert_eq(mod_matrix_get_destination(a10m, 8), 0, "destination 8 reads +0.0");
assert_eq(mod_matrix_get_destination(a10m, 0 - 1), 0, "destination -1 reads +0.0");
assert_eq(naad_is_err(mod_matrix_routing_new(8, 0, H_C0_5)), 1, "routing source 8 rejected");
assert_eq(naad_is_err(mod_matrix_routing_new(0, 8, H_C0_5)), 1, "routing destination 8 rejected");
assert_eq(naad_is_err(mod_matrix_routing_new(0, 0, H_C0_5)), 0, "control: valid routing still builds");

# ================================================================
# A5 -- fit_polynomial at large sample counts. Through 2.1.3 this faulted at
# nx = 5793: ganita_mat_least_squares materialised a full nx x nx orthogonal Q
# and never checked its own allocation, so 2.1.3 capped the input and recorded
# the cap as a knowing divergence (ADR-0001). 2.2.0 ports hisab 1.4.0's THIN QR
# directly (Q is nx x (degree+1)), so the square Q is never formed, the cap is
# gone, and these inputs SUCCEED exactly as they do in Rust.
#
# 5793 is kept as the boundary value precisely because it was the first failing
# length; 20000 is well past anything the old code could reach.
# ================================================================
test_group("A5: fit_polynomial handles large inputs (ADR-0001 retired)");
var a5xs = vec_new();
var a5ys = vec_new();
var a5i = 0;
while (a5i < 5793) {
    vec_push(a5xs, f64_from(a5i));
    vec_push(a5ys, f64_from(2 * a5i + 1));
    a5i = a5i + 1;
}
var a5c = fit_polynomial(a5xs, a5ys, 1);
assert_eq(vec_len(a5c), 2, "nx = 5793 now fits (was the exact SIGSEGV boundary)");
# y = 2x + 1 recovered from 5793 points: c0 ~ 1, c1 ~ 2.
assert(f64_lt(f64_abs(f64_sub(vec_get(a5c, 0), H_ONE)), H_C0_5), "large fit recovers the intercept");
assert(f64_lt(f64_abs(f64_sub(vec_get(a5c, 1), H_TWO)), H_C0_5), "large fit recovers the slope");

var a5bx = vec_new();
var a5by = vec_new();
a5i = 0;
while (a5i < 20000) {
    vec_push(a5bx, f64_from(a5i));
    vec_push(a5by, f64_from(2 * a5i + 1));
    a5i = a5i + 1;
}
assert_eq(vec_len(fit_polynomial(a5bx, a5by, 1)), 2, "nx = 20000 fits -- no square Q is ever formed");

# Controls: the small-input path and the rejections are unchanged.
var a5sx = vec_new();
var a5sy = vec_new();
a5i = 0;
while (a5i < 64) {
    vec_push(a5sx, f64_from(a5i));
    vec_push(a5sy, f64_from(a5i));
    a5i = a5i + 1;
}
assert_eq(vec_len(fit_polynomial(a5sx, a5sy, 2)), 3, "control: small inputs still fit");
assert_eq(vec_len(fit_polynomial(a5sx, a5sy, 0 - 1)), 0, "control: negative degree still rejected");
assert_eq(vec_len(fit_polynomial(a5sx, a5sy, 64)), 0, "control: fewer samples than coefficients still rejected");

# ================================================================
# B0 -- the toolchain contracts the port leans on. A move here is a bump's
# semantic change, so it should fail by name rather than as a mystery below.
# ================================================================
test_group("B0: cyrius >= 6.6.8 float contracts");
var B_PINF = 0x7FF0000000000000;
var B_NINF = 0xFFF0000000000000;
var B_NAN  = 0x7FF8000000000000;
var B_HUGE = 0x7FEFFFFFFFFFFFFF;   # f64::MAX
var B_TINY = 0x0000000000000001;   # smallest subnormal
var B_I64_MAX = 9223372036854775807;
assert_eq(f64_to(B_PINF), B_I64_MAX, "f64_to(+Inf) saturates to INT64_MAX");
assert_eq(f64_to(B_HUGE), B_I64_MAX, "f64_to(f64::MAX) saturates to INT64_MAX");
assert_eq(f64_to(B_NINF), 0 - B_I64_MAX - 1, "f64_to(-Inf) saturates to INT64_MIN");
assert_eq(f64_to(B_NAN), 0, "f64_to(NaN) is 0, as Rust's `as` gives");
assert_eq(f64_neg(0), 0x8000000000000000, "f64_neg(+0) is -0, as Rust's unary minus gives");

# ================================================================
# B1 -- length casts that a saturating f64_to opened. 2.2.4 on cyrius 6.6.3
# returned from every call below, because +Inf cast to INT64_MIN and landed on
# a floor. From 6.6.8 the same input casts to INT64_MAX and walks past that
# floor: an abort at VEC_CAP_MAX, a 2^63-iteration pluck, an out-of-bounds lag.
# The whole suite stayed green through that move. ADR-0004.
# ================================================================
test_group("B1: delay_len_overflows bounds the length, not the value");
var B_CAP = f64_from(VEC_CAP_MAX);
assert_eq(delay_len_overflows(f64_sub(B_CAP, H_ONE)), 0, "one under the vec cap still builds");
assert_eq(delay_len_overflows(B_CAP), 1, "the vec cap itself is refused");
assert_eq(delay_len_overflows(B_PINF), 1, "+Inf is refused");
assert_eq(delay_len_overflows(B_HUGE), 1, "f64::MAX is refused");
assert_eq(delay_len_overflows(B_NAN), 0, "NaN casts to 0 and floors to 1, as Rust does");
assert_eq(delay_len_overflows(B_NINF), 0, "-Inf casts low and floors to 1, as Rust does");

test_group("B1: reverb refuses an unbuildable delay");
var B_SR = f64_from(44100);
assert_eq(reverb_new(F64_HALF, F64_HALF, B_PINF, F64_HALF, B_SR), NAAD_ERR_BUFFER_OVERFLOW, "+Inf pre-delay");
assert_eq(reverb_new(F64_HALF, F64_HALF, B_HUGE, F64_HALF, B_SR), NAAD_ERR_BUFFER_OVERFLOW, "f64::MAX pre-delay");
# Pre-delay 0 here: a non-zero one overflows first and hides the comb bound.
assert_eq(reverb_new(F64_HALF, F64_HALF, 0, F64_HALF, B_HUGE), NAAD_ERR_BUFFER_OVERFLOW, "f64::MAX sample rate");
assert_gt(reverb_new(F64_HALF, F64_HALF, f64_from(100), F64_HALF, B_SR), 0, "control: an ordinary reverb builds");
assert_gt(reverb_new(F64_HALF, F64_HALF, B_NAN, F64_HALF, B_SR), 0, "control: NaN pre-delay still builds");

test_group("B1: chorus and flanger refuse an unbuildable delay");
assert_eq(effects_chorus_new(2, B_PINF, H_ONE, H_ONE, F64_HALF, B_SR),
  NAAD_ERR_BUFFER_OVERFLOW, "chorus +Inf base delay");
assert_eq(effects_chorus_new(2, H_ONE, B_PINF, H_ONE, F64_HALF, B_SR), NAAD_ERR_BUFFER_OVERFLOW, "chorus +Inf depth");
assert_eq(effects_chorus_new(2, H_ONE, H_ONE, H_ONE, F64_HALF, B_HUGE),
  NAAD_ERR_BUFFER_OVERFLOW, "chorus f64::MAX sample rate");
assert_eq(effects_flanger_new(B_PINF, H_ONE, H_ONE, F64_HALF, F64_HALF, B_SR),
  NAAD_ERR_BUFFER_OVERFLOW, "flanger +Inf base delay");
assert_eq(effects_flanger_new(H_ONE, B_PINF, H_ONE, F64_HALF, F64_HALF, B_SR),
  NAAD_ERR_BUFFER_OVERFLOW, "flanger +Inf depth");
assert_eq(effects_flanger_new(H_ONE, H_ONE, H_ONE, F64_HALF, F64_HALF, B_HUGE),
  NAAD_ERR_BUFFER_OVERFLOW, "flanger f64::MAX sample rate");
assert_gt(effects_chorus_new(2, f64_from(20), f64_from(5), H_ONE, F64_HALF, B_SR),
  0, "control: an ordinary chorus builds");
assert_gt(effects_flanger_new(f64_from(5), f64_from(2), H_ONE, F64_HALF, F64_HALF, B_SR),
  0, "control: an ordinary flanger builds");

test_group("B1: physical models refuse an unbuildable period");
assert_eq(physical_ks_new(B_TINY, F64_HALF, F64_HALF, B_SR),
  NAAD_ERR_BUFFER_OVERFLOW, "Karplus-Strong subnormal frequency");
assert_eq(physical_ks_new(H_ONE, F64_HALF, F64_HALF, B_HUGE),
  NAAD_ERR_BUFFER_OVERFLOW, "Karplus-Strong f64::MAX sample rate");
assert_eq(physical_wg_new(B_TINY, F64_HALF, B_SR), NAAD_ERR_BUFFER_OVERFLOW, "waveguide subnormal frequency");
assert_eq(physical_wg_new(H_ONE, F64_HALF, B_HUGE), NAAD_ERR_BUFFER_OVERFLOW, "waveguide f64::MAX sample rate");

test_group("B1: a pluck past any buffer stops instead of writing 2^63 samples");
var b_ks = physical_ks_new(f64_from(440), F64_HALF, F64_HALF, B_SR);
assert_eq(physical_ks_pluck(b_ks), NAAD_ERR_NONE, "control: an ordinary pluck succeeds");
assert_eq(physical_ks_set_frequency(b_ks, B_TINY),
  NAAD_ERR_NONE, "set_frequency still takes what validate_frequency takes");
assert_eq(physical_ks_pluck(b_ks), NAAD_ERR_BUFFER_OVERFLOW, "the pluck reports it");
assert_eq(physical_ks_next_sample(b_ks), 0, "and the string is left silent");
# A lower pitch than the line was built for is legal and still walks the oracle's
# whole burst, so the guard must not cap at the line's own length.
var b_ks2 = physical_ks_new(f64_from(440), F64_HALF, F64_HALF, B_SR);
assert_eq(physical_ks_set_frequency(b_ks2, f64_from(110)), NAAD_ERR_NONE, "control: a lower pitch is accepted");
assert_eq(physical_ks_pluck(b_ks2), NAAD_ERR_NONE, "control: and it plucks");

test_group("B1: the FDN refuses a room goonj would clamp");
var B_D = f64_from(5);
var B_FAR = f64_from(500000);      # 500 km: past FDN_MAX_DELAY_SAMPLES at 48 kHz
assert_eq(naad_fdn_reverb_new(B_PINF, B_D, B_D, H_ONE, 48000, F64_HALF), NAAD_ERR_COMPUTATION, "+Inf length");
assert_eq(naad_fdn_reverb_new(B_D, B_PINF, B_D, H_ONE, 48000, F64_HALF), NAAD_ERR_COMPUTATION, "+Inf width");
assert_eq(naad_fdn_reverb_new(B_D, B_D, B_PINF, H_ONE, 48000, F64_HALF), NAAD_ERR_COMPUTATION, "+Inf height");
assert_eq(naad_fdn_reverb_new(B_HUGE, B_D, B_D, H_ONE, 48000, F64_HALF), NAAD_ERR_COMPUTATION, "f64::MAX length");
assert_eq(naad_fdn_reverb_new(B_FAR, B_D, B_D, H_ONE, 48000, F64_HALF),
  NAAD_ERR_COMPUTATION, "finite, and still past the clamp");
assert_gt(naad_fdn_reverb_new(f64_from(10), B_D, f64_from(3), H_ONE, 48000, F64_HALF),
  0, "control: an ordinary room builds");

test_group("B1: detect_pitch_autocorr survives a saturated lag");
var b_sig = vec_new();
var b_i = 0;
while (b_i < 2048) {
    vec_push(b_sig, f64_sin(f64_div(f64_mul(F64_TAU, f64_from(440 * b_i)), B_SR)));
    b_i = b_i + 1;
}
assert_eq(detect_pitch_autocorr(b_sig, B_HUGE, f64_from(50), f64_from(2000)),
  f64_neg(H_ONE), "a saturated min_lag is an empty range");
# A saturated max_lag clamps to the buffer, which is what Rust's `as usize` then
# `.min(n - 1)` does. Below 6.6.8 this read as an empty range and gave no pitch.
var b_low = detect_pitch_autocorr(b_sig, B_SR, H_ONE, f64_from(2000));
assert_gt(b_low, 0, "control: the search finds a pitch");
assert_eq(detect_pitch_autocorr(b_sig, B_SR, B_TINY, f64_from(2000)),
  b_low, "a saturated max_lag matches the widest ordinary range");

# ================================================================
# B2 -- an impulse response goonj would clamp. goonj caps an IR at
# MAX_IR_SAMPLES and hands back fewer samples than were asked for, having spent
# tens of gigabytes getting there. These refuse before any of that is allocated,
# so the boundary rows can sit at the clamp without paying for it. ADR-0004.
# ================================================================
test_group("B2: the room IR boundary is goonj's clamp");
# A valid concrete room config at `rate`, so only the rate can be refused.
fn b_room_cfg(rate) {
    return naad_room_reverb_config_new(f64_from(10), f64_from(5), f64_from(3), "concrete",
      hvec3_new(f64_from(2), H_ONE, H_ONE), hvec3_new(f64_from(5), f64_from(2), H_ONE), rate);
}
var B_I31 = 2147483648;
var B_ERR = NAAD_ERR_COMPUTATION;
assert_eq(MAX_IR_SAMPLES, 192000 * 600, "the clamp is still 600 s at 192 kHz");
assert_eq(naad_room_ir_overflows(b_room_cfg(MAX_IR_SAMPLES - 1)), 0, "one under the clamp is an IR");
assert_eq(naad_room_ir_overflows(b_room_cfg(MAX_IR_SAMPLES)), 1, "the clamp itself is refused");
assert_eq(naad_room_ir_overflows(b_room_cfg(8000)), 0, "control: an ordinary rate is an IR");

test_group("B2: room and convolution refuse a rate goonj would clamp");
assert_eq(naad_room_reverb_new(b_room_cfg(MAX_IR_SAMPLES)), B_ERR, "room at the clamp");
assert_eq(naad_room_reverb_new(b_room_cfg(B_I31)), B_ERR, "room at 2^31 Hz");
assert_eq(naad_room_reverb_new(b_room_cfg(B_I64_MAX)), B_ERR, "room at INT64_MAX Hz");
assert_eq(naad_convolution_from_room(b_room_cfg(MAX_IR_SAMPLES)), B_ERR, "convolution at the clamp");
assert_eq(naad_convolution_from_room(b_room_cfg(B_I31)), B_ERR, "convolution at 2^31 Hz");
assert_eq(naad_convolution_from_room(b_room_cfg(B_I64_MAX)), B_ERR, "convolution at INT64_MAX Hz");
assert_gt(naad_room_reverb_new(b_room_cfg(8000)), 0, "control: an ordinary room builds");
assert_gt(naad_convolution_from_room(b_room_cfg(8000)), 0, "control: an ordinary convolution builds");

test_group("B2: binaural refuses a rate goonj would clamp");
assert_eq(naad_binaural_ir_overflows(384000000), 1, "0.3 s of 384 MHz lands on the clamp in f64");
assert_eq(naad_binaural_ir_overflows(383999999), 0, "one under it is an IR");
assert_eq(naad_binaural_ir_overflows(8000), 0, "control: an ordinary rate is an IR");
assert_eq(naad_binaural_new(H_ONE, F64_HALF, 384000000), B_ERR, "binaural at the clamp");
assert_eq(naad_binaural_new(H_ONE, F64_HALF, B_I31), B_ERR, "binaural at 2^31 Hz");
assert_eq(naad_binaural_new(H_ONE, F64_HALF, B_I64_MAX), B_ERR, "binaural at INT64_MAX Hz");
assert_gt(naad_binaural_new(H_ONE, F64_HALF, 8000), 0, "control: an ordinary binaural processor builds");

var rc = assert_summary();
syscall(60, rc);
